{"format":"edusim-world","version":1,"exportedAt":"2026-09-17T21:33:13.366Z","edition":"edusim-hifi","renderer":"babylonjs","records":[{"id":"09b01b70-b547-4c0d-af69-06070ee1932c","kind":"world-theme","theme":"sunflower","createdAt":1789680793364,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"9c6d5a9e-688a-49cf-9bc4-1aa32cd82e1b","kind":"world-spawn","createdAt":1789680793364,"transform":{"position":[0,0,150],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"c5686da1-afdc-4153-b66f-58eda38b1cf2","createdAt":1789680793364,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mouse-runway","options":{"points":[[0,168],[1,150],[3,132],[7,114],[12,96],[16,78],[16,60],[12,42],[6,24],[-1,6],[-7,-12],[-11,-32],[-13,-52],[-10,-72],[-5,-90]],"width":14,"seed":23,"litter":120}},{"id":"bda2c3f9-d389-4506-8273-aa5e90d4f5d4","createdAt":1789680793364,"transform":{"position":[-20,-0.003862146778303386,122],"rotation":[0,0.6202494859828215,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"\ud83c\udf3b  SUNFLOWER","lines":["YOU ARE A MOUSE."],"lead":"The field is forty times life size and so is everything in it. Follow the worn path north to the nest in the bank \u2014 four other mice are working it, carrying seed and grass home.","footnote":"Five boards down the path: three to program, two to build","accent":"#ffc42e","face":"#2d2a14","width":13}},{"id":"e9f8e5ca-ce80-4a99-acb4-efeb81f8d263","createdAt":1789680793364,"transform":{"position":[22,0.5233918982979087,156],"rotation":[0,-1.837048375945822,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE SUNFLOWER FIELD"],"subtitle":"Kansas, September \u2014 a deer mouse, four inches long, in eight feet of Helianthus annuus","width":17,"height":4.4,"face":"#3a4a18","accent":"#ffc42e"}},{"id":"2d128a32-95a8-4447-8dd8-fad3e468547e","createdAt":1789680793364,"transform":{"position":[10,0.276915215679