,-72],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"seed-scatter","options":{"seed":65,"count":20,"spread":9,"husks":0.5}},{"id":"37f519f4-ec2d-4b58-83f4-ae9746d85c1f","createdAt":1789680793365,"transform":{"position":[20,0,48],"rotation":[0,0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"nest-material","options":{"kind":"grass","size":7,"seed":71}},{"id":"dd008935-6703-4bbf-a0d5-15534d607021","createdAt":1789680793365,"transform":{"position":[-4,0,14],"rotation":[0,2.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"nest-material","options":{"kind":"leaf","size":7,"seed":73}},{"id":"099426d6-963e-44c9-8670-dffc027d0f2d","createdAt":1789680793365,"transform":{"position":[-16,0,-24],"rotation":[0,1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"nest-material","options":{"kind":"feather","size":6,"seed":75}},{"id":"85cd6f19-4dd3-45e1-8ed3-9531f23bda45","createdAt":1789680793365,"transform":{"position":[-6,0,-62],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"nest-material","options":{"kind":"down","size":6,"seed":77}},{"id":"8a45795e-79aa-4572-91f6-b2dae6307871","createdAt":1789680793365,"transform":{"position":[9,0,88],"rotation":[0,2.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"nest-material","options":{"kind":"leaf","size":6,"seed":79}},{"id":"38c5087a-3678-4c5d-9447-ef6a3fc10318","createdAt":1789680793365,"transform":{"position":[-4,0.03204144948083814,-126],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"nest-bank","options":{"seed":3,"width":118,"height":46,"depth":66,"mouth":9.5,"tufts":30}},{"id":"85bc7db8-1ade-4d38-8fcf-3d727c713210","createdAt":1789680793365,"transform":{"position":[40,0,-66],"rotation":[0,-0.9685089806599324,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mouse-nest-cutaway","options":{"seed":17,"width":48,"height":27,"depth":8}},{"id":"b21f0bd6-17db-4342-bb44-5337464154d8","createdAt":1789680793365,"transform":{"position":[47.41637731779431,11,-71.09875940598359],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"381ff81d-8cba-40bd-96bb-54e45c338c75","createdAt":1789680793365,"transform":{"position":[26,0,-73],"rotation":[0,-0.5880026035475675,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Cut through the bank","title":"Inside the nest","accent":"#8a6f4a","body":"A deer mouse digs a burrow into a bank with the entrance low down and the nest chamber above it, so water runs out instead of in. The nest is a ball of shredded grass lined with the softest thing the mouse can find \u2014 thistle down, feathers, fur. Off the main run there is a store of seed and a bolt tunnel that stops just under the surface, for going out the other way in a hurry."}},{"id":"dbec187f-d68d-431b-a978-5be724504296","createdAt":1789680793365,"transform":{"position":[-24,0,-70],"rotation":[0,0.6435011087932844,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Four inches of animal","title":"The deer mouse","accent":"#9c6535","body":"Peromyscus maniculatus: three and a half inches of body, a tail as long again, and big black eyes for working at night. Brown above and sharply white below, with white feet. It can carry a sunflower seed in its cheek pouches and a beakful of grass in its teeth, and it caches far more seed than it can eat \u2014 which is one of the ways a prairie plants itself."}},{"id":"ff88adaf-75ee-420b-9e22-39b375206b0c","createdAt":1789680793365,"transform":{"position":[25,0,104],"rotation":[0,-0.5790742693677309,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"137.5 degrees","title":"Why the seeds spiral","accent":"#d9822b","body":"Every seed in that head sits one turn of 137.5 degrees round from the last one \u2014 the golden angle. It is the one angle that never lines the seeds up in rows, so each one lands in the biggest gap left, and a thousand of them pack the disc with no wasted space. Count the spirals running each way: 34 and 55, or 55 and 89. They are always Fibonacci numbers."}},{"id":"18407965-5b13-4adb-bd34-4acd8efa07df","createdAt":1789680793365,"transform":{"position":[-24,0,62],"rotation":[0,0.5191461142465229,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Heliotropism","title":"Following the sun","accent":"#ffc42e","body":"A young sunflower turns its face from east to west through the day and swings back overnight, driven by one side of the stem growing faster than the other. When the flower opens for good it stops, facing EAST \u2014 and a head that faces east warms up first in the morning, which brings five times as many bees to it. Every open head in this field looks the same way for that reason."}},{"id":"909d4f32-b09c-4410-8b5e-3dfdf9c8cdd5","createdAt":1789680793365,"transform":{"position":[30,0,22],"rotation":[0,-0.6947382761967033,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Helianthus annuus","title":"Eight feet in one summer","accent":"#7cc23c","body":"A sunflower grows from a seed like the one in your hands to eight feet tall between May and September, and this is the Sunflower State: Kansas grows them by the section for oil, for birdseed and for the packet in your pocket. Everything here is forty times life size. That stalk is really about as thick as your thumb."}},{"id":"1601f6b9-81c4-4455-a9e4-e5f004405fd2","createdAt":1789680793365,"transform":{"position":[-13,0,106],"rotation":[0,0.35291314985687794,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Send a mouse for a seed","target":"Click the mouse on the path ahead \u2192 Program. Clear its blocks and build this:","steps":[{"cat":"motion","text":"move forward 18 feet","depth":0},{"cat":"control","text":"wait 1 seconds","depth":0},{"cat":"look","text":"say got one!","depth":0},{"cat":"control","text":"wait 1 seconds","depth":0},{"cat":"motion","text":"go back to start","depth":0}],"tip":"Move forward follows the mouse's own nose, so turn it first and it goes somewhere else entirely. Go back to start puts it exactly where it began \u2014 position, turn and size at once.","accent":"#4c97ff"}},{"id":"2491507e-d454-4916-a6f6-f6e4bd5d4663","createdAt":1789680793365,"transform":{"position":[-16,0,46],"rotation":[0,0.42562246833963147,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Make a sunflower follow the sun","target":"Click the young sunflower beside this board \u2192 Program.","steps":[{"cat":"control","text":"repeat 24 times","depth":0},{"cat":"motion","text":"rotate -5 degrees","depth":1},{"cat":"control","text":"wait 0.5 seconds","depth":1},{"cat":"motion","text":"rotate 120 degrees","depth":0}],"tip":"Twenty-four small turns west through the day, then one big turn back to face east overnight \u2014 which is exactly what a real young sunflower does. Minus turns it one way, plus turns it back.","accent":"#ffab19"}},{"id":"1704a863-2bde-49d0-9336-476c7efeeff7","createdAt":1789680793365,"transform":{"position":[-36,0,-40],"rotation":[0,0.7952988299854369,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":3,"title":"Leave a scent trail home","target":"Click any mouse \u2192 Program. Mice really do follow their own trails.","steps":[{"cat":"look","text":"marker color","depth":0},{"cat":"look","text":"marker down","depth":0},{"cat":"control","text":"repeat 4 times","depth":0},{"cat":"motion","text":"move forward 12 feet","depth":1},{"cat":"motion","text":"rotate 90 degrees","depth":1},{"cat":"look","text":"marker up","depth":0}],"tip":"Four moves and four right-angle turns close a square \u2014 360 divided by the number of sides. Erase all marks clears every trail in the field, not just this one.","accent":"#9966ff"}},{"id":"6470f6e2-437f-4980-aa8b-c1fe0a5e9720","createdAt":1789680793365,"transform":{"position":[36,0,88],"rotation":[0,-0.7952988299854369,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"tutorial-board","options":{"kicker":"\ud83d\udd28  BUILD IT","number":1,"title":"Build a sunflower","accent":"#c2521f","width":11,"height":8.6,"postHeight":11.5,"intro":"Menu \u25b8 Create Model. Every piece lands in build yellow in front of you \u2014 click the hammer floating above it. Stand under a real one first and look up.","steps":[{"lead":"The stalk","text":"A Cylinder. Grab a corner handle and stretch it tall and thin \u2014 taller than you by a long way."},{"lead":"The head","text":"A Cylinder squashed flat into a disc. Drag the GREEN ball above it straight UP to the top of the stalk."},{"lead":"Petals","text":"A Cube stretched long and thin, laid flat against the disc. Use Rotate/Move Shape to turn each one \u2014 the rings click round in 15 degree steps, so 24 of them go all the way round."},{"lead":"Leaves","text":"Two more flattened Cubes on the stalk, angled down and out. Apply a green colour to these and to the stalk, and yellow to the petals."},{"lead":"Connect, then Render","text":"Connect every piece to the stalk or the head, then press Render Model. Now it is one object you can size, move and program."}],"tip":"The green ball decides lift-or-slide from the first inch you drag it: straight UP to raise, sideways to slide. A raised piece keeps its height when you slide it, which is the whole reason that handle exists."}},{"id":"4d894de1-5bd1-40f8-bd0b-4be6022ae349","createdAt":1789680793365,"transform":{"position":[28,0,4],"rotation":[0,-0.670662661408426,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"tutorial-board","options":{"kicker":"\ud83d\udd28  BUILD IT","number":2,"title":"Build a seed store","accent":"#8a6f2a","width":11,"height":8.6,"postHeight":11.5,"intro":"A mouse caches far more seed than it can eat. Build it somewhere dry \u2014 with a door a mouse can actually get through.","steps":[{"lead":"Floor","text":"A Cube squashed flat and stretched wide. Everything else stands on this."},{"lead":"Three walls","text":"A Cube stretched tall and thin: one at the back, one each side. Leave the front open for now."},{"lead":"The door","text":"The front wall is TWO short piers with a beam across the top \u2014 not one wall with a dark patch on it. That is how a real opening is built, and it is the only way it reads as a hole you could run through."},{"lead":"Roof","text":"A Pyramid stretched to overhang the walls. Lift it with the green ball until it sits on top."},{"lead":"Fill it","text":"Connect everything to the floor, press Render Model, then go and find a seed \u2014 click one, press Size, and make yourself a copy to put inside."}],"tip":"A ring seen exactly edge-on cannot be grabbed: it is a hairline down the middle of the piece. Take two steps sideways and it opens into a circle you can hold."}},{"id":"6b71aa59-a090-4f7b-ae38-76fc04632e3e","createdAt":1789680793365,"transform":{"position":[-2,0,57],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"sunflower","options":{"seed":101,"height":34,"headSize":10,"stage":"young","leaves":6,"detail":"hero"}},{"id":"c5895d19-82c5-4047-a0c0-b0be6d6754d9","createdAt":1789680793365,"transform":{"position":[-19,0.5411934571558366,148],"rotation":[0,-0.048186419531702995,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"sunflower","options":{"seed":200,"height":54,"headSize":14.944503827951849,"stage":"bloom","leaves":7,"lean":-0.018483897554688156,"detail":"hero"}},{"id":"de18b456-fb2a-42b7-94e3-383aa7fe3d11","createdAt":1789680793365,"transform":{"position":[21,0.05736433146262987,128],"rotation":[0,-0.1573949985904619,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"sunflower","options":{"seed":207,"height":58,"headSize":15.664041582494974,"stage":"bloom","leaves":7,"lean":-0.005414077390450984,"detail":"hero"}},{"id":"35cf8a21-7e8a-4749-82d0-213e31551e06","createdAt":1789680793365,"transform":{"position":[-34,0,105],"rotation":[0,0.18932098406367004,0],"scale":[1,1,1]},"kind":"preset