],"scale":[1,1,1]},"kind":"preset-prop","prop":"granite-outcrop","options":{"size":11,"seed":528}},{"id":"df8614d9-0e15-4802-a617-66b52734d87e","createdAt":1786942192008,"transform":{"position":[46,0.06850735797094032,-80],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"granite-outcrop","options":{"size":8,"seed":535}},{"id":"bcf12e17-70a4-4ca3-978f-e5ac5a0977f5","createdAt":1786942192009,"transform":{"position":[-64,-0.03862063944998928,70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":600}},{"id":"b179c256-ef8b-4bbb-a6e7-cb76fc986c6d","createdAt":1786942192010,"transform":{"position":[72,1.1374159185096286,78],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":605}},{"id":"f971e3da-37ee-4b12-91d0-24733b3dc83b","createdAt":1786942192011,"transform":{"position":[-90,-0.09504675037593247,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":610}},{"id":"e0e9d252-40cd-433a-949c-64b780eca007","createdAt":1786942192013,"transform":{"position":[88,0.010932877041182287,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":615}},{"id":"a9a115d6-1395-402c-adf3-f69f80015717","createdAt":1786942192014,"transform":{"position":[-34,0.02457459320670541,-84],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":620}},{"id":"16cd7cc3-1c17-49be-8ff7-e3966cbc67b2","createdAt":1786942192015,"transform":{"position":[34,-0.4148485187524784,-96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":625}},{"id":"076ce963-87ba-4927-a047-ecdd3d1e4316","createdAt":1786942192016,"transform":{"position":[-100,-0.8487247406675027,46],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":630}},{"id":"c476fa25-0ed8-45d2-8e97-92d543b8c8e1","createdAt":1786942192018,"transform":{"position":[104,0.5448534101966569,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ichu-grass","options":{"radius":6,"count":20,"seed":635}},{"id":"8f4114ae-2f8e-4072-9088-980aa1eaf406","createdAt":1786942192019,"transform":{"position":[-26,-0.11813881947906646,74],"rotation":[0,1.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"llama","options":{"height":5.6,"seed":37}},{"id":"cbe39540-b343-46fb-a1d5-8a47a3a9bfce","createdAt":1786942192020,"transform":{"position":[-16,-0.03470357039447736,66],"rotation":[0,2.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"llama","options":{"height":5.2,"fleece":9073496,"seed":41}},{"id":"f1f748a8-615b-4950-a849-5707755a2a8a","createdAt":1786942192021,"transform":{"position":[34,0.14146595388885297,70],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"llama","options":{"height":5.4,"fleece":14998732,"seed":43}},{"id":"f4a879c4-b7c7-499a-88ff-4c8847d43bc8","createdAt":1786942192023,"transform":{"position":[-44,-0.11382081025769653,82],"rotation":[0,0.7631795980707292,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Why there are no carts here","title":"Llamas","accent":"#a08a62","body":"The Inca built 25,000 miles of road across the Andes and never used a wheel on any of it. A wheel is no use on a staircase cut into a cliff; a llama walks up it carrying a hundred pounds. They also refuse to move if you overload them, which makes them very hard to abuse."}},{"id":"e017be3d-ca4c-40bc-947c-202b87d464b3","createdAt":1786942192024,"transform":{"position":[30,0.5119209821148707,138],"rotation":[0,-1.892546881191539,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["MACHU PICCHU"],"subtitle":"7,970 feet · built about 1450 · abandoned within a century","width":17,"height":4.4}},{"id":"befd5294-e51f-488f-ba20-702f911c8661","createdAt":1786942192025,"transform":{"position":[-10,-0.5308420022258225,118],"rotation":[0,0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"2ec06386-4ca3-44a4-89fd-010849d1ea4b","createdAt":1786942192027,"transform":{"position":[-10,3.4691579977741775,118],"rotation":[0,0.7853981633974483,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"c0efb43d-7fab-42ef-95ae-24579d74edc6","createdAt":1786942192028,"transform":{"position":[-32,0.1265320207078422,126],"rotation":[0,1.5083775167989393,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Take a llama up the terraces","target":"Click a llama on the terraces → Program.","steps":[{"cat":"control","text":"repeat 6 times","depth":0},{"cat":"motion","text":"glide 8 feet over 2 seconds","depth":1},{"cat":"motion","text":"move up by 4.5 feet","depth":1},{"cat":"control","text":"wait 0.4 seconds","depth":1}],"tip":"Each terrace is about eight feet deep and four and a half feet high, so this walks it up one step at a time. Glide travels the way the llama is facing; move up is always straight up, whichever way it points. Turn the llama round first and the same program climbs in a different direction.","accent":"#8a8578"}},{"id":"9c7d7d29-9602-4d81-b571-01e6230383a0","createdAt":1786942192029,"transform":{"position":[34,0.8410806897002217,122],"rotation":[0,-1.396124127786657,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Make the sun tie itself","target":"Click the Intihuatana stone → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 4 degrees","depth":1},{"cat":"look","text":"set size to 104 %","depth":1},{"cat":"control","text":"wait 0.2 seconds","depth":1},{"cat":"look","text":"set size to 100 %","depth":1},{"cat":"control","text":"wait 0.2 seconds","depth":1}],"tip":"Set size to is ABSOLUTE — it always measures from the size the stone started at, so 104 then 100 makes it pulse instead of growing forever. Change size by would double it every pass and the stone would swallow the mountain in about ten seconds. Try it and see.","accent":"#7a8a4e"}},{"id":"f3ce774a-0bb8-4b2f-9f30-e74d579d8f18","createdAt":1786942192030,"transform":{"position":[-22,8.000000000000004,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"2edc3f7e-e795-485d-8f88-e69d70a45e0f","createdAt":1786942192031,"transform":{"position":[-52,8.901307920083447,34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"6a385950-08e5-4a1e-9653-449757c6a7a0","createdAt":1786942192033,"transform":{"position":[4,6.718536344514192,-66],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}