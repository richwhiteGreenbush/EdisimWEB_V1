{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T04:49:52.033Z","records":[{"id":"5604adc8-5d8c-4632-a6a5-1aa1b327bd1a","kind":"world-theme","theme":"machupicchu","createdAt":1786942191962,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"db64e053-d566-4e18-8d31-5ca93f7f674b","kind":"world-spawn","createdAt":1786942191962,"transform":{"position":[0,0,128],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"40634ca5-2270-4fb6-98f2-49e6b35b91da","createdAt":1786942191964,"transform":{"position":[-76,0.2059573128532839,74],"rotation":[0,1.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-terraces","options":{"width":62,"steps":7,"rise":4.5,"tread":8.5,"curve":4,"seed":7}},{"id":"7a6282c8-9f0c-44f2-afe8-6706ce65a359","createdAt":1786942191967,"transform":{"position":[78,0.8583962604635418,70],"rotation":[0,-1.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-terraces","options":{"width":56,"steps":6,"rise":4.5,"tread":8.5,"curve":3,"seed":13}},{"id":"66de885b-122f-4a04-b382-df9ee414659b","createdAt":1786942191968,"transform":{"position":[-84,-0.5440561189055244,6],"rotation":[0,1.45,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-terraces","options":{"width":46,"steps":5,"rise":4.2,"tread":8,"curve":3,"seed":19}},{"id":"acde15ee-ee56-46d3-ae51-b1877f8c3a1f","createdAt":1786942191970,"transform":{"position":[-50,-0.05088720728494156,84],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-stairs","options":{"width":7,"steps":14,"rise":1.1,"run":1.35,"seed":19}},{"id":"fab1965c-5e5a-4967-af3d-49e144474d80","createdAt":1786942191971,"transform":{"position":[-52,0.41609326985471196,100],"rotation":[0,1.0768549578753155,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Not just flat ground","title":"The terraces","accent":"#7a8a4e","body":"Each one is built in layers: broken rock at the bottom, then gravel, then sand, then topsoil carried up from the valley. Six feet of rain falls here every year, and the terraces drain it THROUGH the mountain instead of letting it wash the mountain away. That is why the site is still standing and most of what the Spanish built later is not."}},{"id":"eae78cff-b761-4f47-8a11-caf0f797d2a6","createdAt":1786942191972,"transform":{"position":[-52,-0.0986920799165536,34],"rotation":[0,0.15,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":18,"depth":12,"wallHeight":8,"roofed":true,"seed":100}},{"id":"c98b0b39-ed6e-4fcd-aae5-c3bdfe41a7cd","createdAt":1786942191974,"transform":{"position":[-54,-0.06535263187611218,12],"rotation":[0,0.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":16,"depth":11,"wallHeight":8,"roofed":true,"seed":109}},{"id":"3d1d57f8-3107-4c8d-9788-07d2f3c4d5bf","createdAt":1786942191975,"transform":{"position":[-50,-0.020529264584181472,-10],"rotation":[0,0.08,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":15,"depth":11,"wallHeight":8,"roofed":false,"seed":118}},{"id":"cdde45d8-9ab7-45d6-a0fc-8558609879e2","createdAt":1786942191976,"transform":{"position":[-56,-0.007763155585209347,-32],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":17,"depth":12,"wallHeight":8,"roofed":true,"seed":127}},{"id":"e96bf147-d218-4c2a-94cb-31f676bd0701","createdAt":1786942191977,"transform":{"position":[-44,0.024691316077292136,-52],"rotation":[0,-0.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":14,"depth":10,"wallHeight":8,"roofed":false,"seed":136}},{"id":"5d2e9615-053d-40b2-98a8-a1ba994b5a73","createdAt":1786942191978,"transform":{"position":[-60,-0.12109130449320382,-8],"rotation":[0,1.55,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":12,"depth":9,"wallHeight":8,"roofed":false,"seed":145}},{"id":"fd93006c-d44a-4602-b556-0d5fa2a1e504","createdAt":1786942191980,"transform":{"position":[56,-0.07979360388806267,28],"rotation":[0,-0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":15,"depth":11,"wallHeight":8,"roofed":true,"seed":160}},{"id":"c45cb8db-0b5c-4cd8-bd53-db13564f3650","createdAt":1786942191981,"transform":{"position":[58,-0.0457200668609099,4],"rotation":[0,-0.12,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":14,"depth":10,"wallHeight":8,"roofed":false,"seed":169}},{"id":"9b363513-9b54-419d-acb1-31eb62a54cf0","createdAt":1786942191982,"transform":{"position":[52,-0.001757622514122037,-22],"rotation":[0,-0.05,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-house","options":{"width":16,"depth":11,"wallHeight":8,"roofed":true,"seed":178}},{"id":"6bf5a354-ccfa-4cfe-9168-b3c3fe13ab0e","createdAt":1786942191983,"transform":{"position":[-30,-0.023781386274638106,46],"rotation":[0,0.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-wall","options":{"width":20,"height":9,"doorway":true,"niches":2,"seed":5}},{"id":"9ea29810-c0ef-4466-a53a-bd4b9a20c90f","createdAt":1786942191985,"transform":{"position":[30,0.004488286562262189,40],"rotation":[0,-0.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-wall","options":{"width":18,"height":8.5,"doorway":true,"niches":2,"seed":11}},{"id":"ffa9279b-3406-42f6-b629-963a4f737977","createdAt":1786942191986,"transform":{"position":[-20,-0.019990014319536176,-46],"rotation":[0,1.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-wall","options":{"width":22,"height":10,"doorway":false,"niches":3,"seed":17}},{"id":"ac393b75-efb7-4039-bd43-f1c1a326d28a","createdAt":1786942191987,"transform":{"position":[-18,-0.021324058177532468,58],"rotation":[0,0.25168997175818675,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"No mortar anywhere","title":"How the stones fit","accent":"#8a8578","body":"Every block was shaped to fit the ones already laid — not cut to a standard size, which is why no two are alike and why the joints wander. A knife blade will not go into them. The walls lean inward and every door and window is a trapezoid, wider at the bottom: all of it is earthquake engineering, and it works."}},{"id":"51658650-0178-4c0c-b191-b24735b85cd5","createdAt":1786942191988,"transform":{"position":[-22,3.1086244689504383e-15,-14],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"temple-of-the-sun","options":{"radius":11,"height":12,"seed":11}},{"id":"aa8bd49d-11a4-4bc2-be53-4fb453f39b6a","createdAt":1786942191990,"transform":{"position":[-8,-8.881784197001252e-16,4],"rotation":[0,0.1418970546041639,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"The only curved wall on the site","title":"The Temple of the Sun","accent":"#a39683","body":"A window here is cut so that at sunrise on the June solstice — midwinter in Peru — the light falls exactly along a line carved into the rock inside. The building is a calendar. It is built onto the living granite rather than onto foundations, and the masons cut the mountain to receive it."}},{"id":"63c8d04c-5546-48c5-ba83-447380e0a293","createdAt":1786942191991,"transform":{"position":[4,-0.2814636554858079,-66],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"intihuatana","options":{"height":6,"seed":13}},{"id":"00a7c249-8091-46b7-b8d4-213904a89ae5","createdAt":1786942191992,"transform":{"position":[24,-0.059750598364447516,-54],"rotation":[0,-0.3136206522166983,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"\"The place that ties the sun\"","title":"The Intihuatana","accent":"#9a958c","body":"One piece of granite, carved where it stood out of the bedrock. Its edges point to the four directions and at the equinoxes the pillar casts almost no shadow at midday. The Spanish smashed every one of these they found, as idols. This one survived because they never found the site."}},{"id":"de2f949b-9059-4b69-871a-c34644bd6a61","createdAt":1786942191993,"transform":{"position":[4,-0.0029406579265125465,-46],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-stairs","options":{"width":6,"steps":12,"rise":1.1,"run":1.3,"seed":23}},{"id":"0e966380-a8a3-4b62-8056-5531b4059c57","createdAt":1786942191994,"transform":{"position":[-40,-0.18072496522043435,62],"rotation":[0,0.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-fountain","options":{"height":4.2,"seed":23}},{"id":"bee16ecc-0396-4747-90d7-15acc424431e","createdAt":1786942191996,"transform":{"position":[-42,-0.09078070566929952,48],"rotation":[0,0.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"inca-fountain","options":{"height":4.2,"seed":29}},{"id":"05a7b7e7-ee57-4ca9-ba42-eb25d006369b","createdAt":1786942191997,"transform":{"position":[-30,-0.1403964459896243,70],"rotation":[0,0.4773453823736719,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Sixteen of them, running downhill","title":"The fountains","accent":"#5c7a86","body":"A spring on the mountainside feeds a stone channel nearly half a mile long, which drops through the city from one fountain to the next. The first one is at the top by the temple; the last is at the bottom. It still runs. Getting water to arrive where you want it, at the right speed, down a mountain, is the hardest thing on this site."}},{"id":"40c42189-bd38-4ac8-aa6e-92bf959555a9","createdAt":1786942191998,"transform":{"position":[-18,1.444143572711079,-168],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"andean-peak","options":{"height":132,"baseRadius":62,"sugarloaf":true,"seed":29}},{"id":"0734e149-e614-4448-9e51-6c7fbd1c9760","createdAt":1786942191999,"transform":{"position":[152,-0.45141418096710106,-86],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"andean-peak","options":{"height":96,"baseRadius":58,"sugarloaf":false,"snow":true,"seed":37}},{"id":"fb663c04-cbf4-4644-828a-55bb57606d16","createdAt":1786942192000,"transform"