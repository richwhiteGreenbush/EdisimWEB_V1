reset-prop","prop":"activity-board","options":{"number":1,"title":"Take the buggy out for rock samples","target":"Click the Moon buggy → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 12 times","depth":1},{"cat":"motion","text":"move X by 0.5 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"control","text":"repeat 12 times","depth":1},{"cat":"motion","text":"move X by -0.5 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Six feet out, turn, six feet home. The real crews were never allowed to drive further than they could WALK back if it broke down — so keep your loops short.","accent":"#2f6bd6"}},{"id":"98891322-c266-4b07-a60e-fcbe7a04159d","createdAt":1786894182487,"transform":{"position":[10,-4.440892098500626e-16,2],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Set the Earth turning","target":"Look up, click the Earth → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 0.5 degrees","depth":1}],"tip":"From here the Earth never rises and never sets — the Moon keeps one face toward us, so it just hangs there. It does still turn, though. One full spin every 24 hours.","accent":"#b8471f"}},{"id":"1ab2b453-491e-43dc-8f45-6681b7218144","createdAt":1786894182489,"transform":{"position":[6,3.1086244689504383e-15,-14],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bootprint-trail","options":{"count":10,"seed":5}},{"id":"25dddd9b-aa93-4b66-8776-bc74e1b8d8da","createdAt":1786894182490,"transform":{"position":[-7,2.6645352591003757e-15,-12],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bootprint-trail","options":{"count":8,"seed":8}},{"id":"afbb4649-118c-404f-be0f-357199d979d7","createdAt":1786894182491,"transform":{"position":[12,5.773159728050814e-15,-26],"rotation":[0,1.3,0],"scale":[1,1,1]},"kind":"preset-pro