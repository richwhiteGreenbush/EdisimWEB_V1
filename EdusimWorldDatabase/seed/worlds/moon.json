n":[46,-0.05908369944314673,18],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-crater","options":{"radius":13,"rimHeight":2.15,"seed":23}},{"id":"ea2ac919-cbc8-4fa0-b817-8650da3f9776","createdAt":1786942185965,"transform":{"position":[26,-0.07986929784618546,-40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-rocks","options":{"count":10,"spread":8,"scale":1,"seed":31}},{"id":"082e8581-2ecd-47d7-a265-46225668c7eb","createdAt":1786942185966,"transform":{"position":[-32,3.9968028886505635e-15,-18],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-rocks","options":{"count":8,"spread":7,"scale":0.8,"seed":37}},{"id":"90daf3e1-0b32-43a5-bb26-62de2fe13012","createdAt":1786942185968,"transform":{"position":[-32,-0.4977474575223826,-50],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-rocks","options":{"count":12,"spread":11,"scale":1.3,"seed":41}},{"id":"1b242a45-75ce-4107-b673-3ebc622a8767","createdAt":1786942185969,"transform":{"position":[34,-4.440892098500626e-16,2],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-rocks","options":{"count":9,"spread":9,"scale":1.1,"seed":43}},{"id":"a32e0a91-b6bf-4730-a48a-c7c6d09269ba","createdAt":1786942185970,"transform":{"position":[8,-0.13710804818776623,-48],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-rocks","options":{"count":7,"spread":6,"scale":0.7,"seed":47}},{"id":"e929d1e3-b409-4ebb-af5d-c324041ce190","createdAt":1786942185971,"transform":{"position":[-25,1.5543122344752192e-15,-7],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["TRANQUILITY BASE"],"subtitle":"APOLLO LANDING SITE · 1 / 6 EARTH GRAVITY · NO ATMOSPHERE","width":13,"height":3.2,"postHeight":7.5,"face":"#161a24","accent":"#7fb6ff"}},{"id":"ec0a6dca-0b3b-4284-b3e9-dc7dbbe3d7cb","createdAt":1786942185972,"transform":{"position":[-11,1.1102230246251565e-15,-5],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-11,"z":-5,"rotY":0.3,"eyebrow":"Look up","title":"Why the sky is black","body":"The Moon has almost no atmosphere. With no air to scatter sunlight, the sky stays black even at noon — and the stars never twinkle."}},{"id":"5671d9df-b7f8-4c25-9ac9-03df6036e228","createdAt":1786942185974,"transform":{"position":[-16,3.774758283725532e-15,-17],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-16,"z":-17,"rotY":0.9,"eyebrow":"The flag","title":"It is not waving","body":"No air means no wind. A horizontal rod along the top hem holds the flag out flat. The ripples are just creases from being rolled up."}},{"id":"333d66ae-81d2-4500-a20f-d67e301606ab","createdAt":1786942185975,"transform":{"position":[26,5.773159728050814e-15,-26],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":26,"z":-26,"rotY":-0.9,"eyebrow":"Lunar Roving Vehicle","title":"The Moon buggy","body":"About 10 feet long — twice your height. Wheels of woven piano wire, because rubber tyres would crack in vacuum. Top speed: 8 mph."}},{"id":"89825d70-a956-4d8f-8c03-68ee1d7b5ec7","createdAt":1786942185976,"transform":{"position":[-17,4.884981308350689e-15,-22],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-17,"z":-22,"rotY":0.6,"eyebrow":"Lunar Module","title":"Two ships in one","body":"Only the top half flew home. The gold foil is Kapton, wrapped on to keep the temperature steady between +250°F in sun and -280°F in shade."}},{"id":"6950c467-6160-4b53-8260-46da1ab3161e","createdAt":1786942185977,"transform":{"position":[13,1.7763568394002505e-15,-8],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":13,"z":-8,"rotY":-0.4,"eyebrow":"Footprints","title":"They are still there","body":"No wind, no rain, no running water. The prints left in 1969 could stay sharp for millions of years — only micrometeorites slowly erase them."}},{"id":"c2737828-0341-45bd-8ba2-ddc5b9074df8","createdAt":1786942185978,"transform":{"position":[-33,-0.0008953021058402122,-26],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-33,"z":-26,"rotY":0.9,"eyebrow":"ALSEP","title":"Experiments still running","body":"The mirror panel here reflects laser beams straight back to Earth. Scientists still fire at it, and have measured the Moon drifting 1.5 inches farther away each year."}},{"id":"e7f2f9a5-1c73-4c94-a2f5-581622187757","createdAt":1786942185980,"transform":{"position":[-38,-0.03727917392145397,28],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-38,"z":28,"rotY":-0.4,"eyebrow":"What comes next","title":"Living here","body":"A lunar day lasts about 29.5 Earth days — two weeks of sun, then two weeks of night. Any real base has to store power for all of it."}},{"id":"bf9fef5a-6d36-46e7-a9ce-9e6e269af69e","createdAt":1786942185981,"transform":{"position":[7,5.500000000000005,-24],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"d8348730-22e1-4f34-b03b-b5e4cddfe290","createdAt":1786942185982,"transform":{"position":[-9,5.500000000000006,-27],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"5e185b94-ab86-49b8-874a-918f64d115f7","createdAt":1786942185983,"transform":{"position":[-30,5.999999999999998,6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"}]}