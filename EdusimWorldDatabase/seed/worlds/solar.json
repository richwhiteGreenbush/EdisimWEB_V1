"createdAt":1786942188285,"transform":{"position":[2.6,-9.769962616701378e-15,76],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"0.39 AU","sub":"36 million miles"}},{"id":"ba8d51b1-42f2-46bd-a8d0-3e2059d68b4e","createdAt":1786942188287,"transform":{"position":[7,-3.9968028886505635e-15,50],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"venus","radius":1.5184,"tilt":177.4,"rings":false,"plinth":true,"seed":18,"moons":[]}},{"id":"6c538f14-7d66-4c3f-b40d-2249c0601e9e","createdAt":1786942188288,"transform":{"position":[3.5,-5.10702591327572e-15,55],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"67 million miles","title":"Venus","accent":"#7fb4ff","body":"7,521 miles across — almost exactly Earth’s size. You cannot see its surface: it is wrapped in cloud that traps heat so well the ground is 870°F, hotter than Mercury. It also spins backwards, and slower than it orbits."}},{"id":"6fa771ee-bc31-4ba4-b10a-fcc6dd7ed9b5","createdAt":1786942188289,"transform":{"position":[-2.6,-3.9968028886505635e-15,50],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"0.72 AU","sub":"67 million miles"}},{"id":"9e0c4c62-d203-49e3-a458-c285b417325e","createdAt":1786942188291,"transform":{"position":[-7,-4.884981308350689e-15,22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"earth","radius":1.6,"tilt":23.4,"rings":false,"plinth":true,"seed":25,"moons":[{"kind":"moon","radius":0.4368000000000001}]}},{"id":"660b1ef2-e527-4017-bdde-ad5c9836fdee","createdAt":1786942188292,"transform":{"position":[-3.5,-5.995204332975845e-15,27],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"93 million miles","title":"Earth","accent":"#7fb4ff","body":"7,926 miles across. The only place known to have liquid water on its surface — and the only planet here whose colour comes from being alive. Its 23° tilt is what gives it seasons."}},{"id":"aae684a1-bd60-4d17-bff9-6fce6afe0ce0","createdAt":1786942188293,"transform":{"position":[2.6,-4.884981308350689e-15,22],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"1 AU","sub":"93 million miles"}},{"id":"887510f8-3c24-43cb-ad8d-f464ff1a9cde","createdAt":1786942188294,"transform":{"position":[7,8.881784197001251e-16,-4],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"mars","radius":0.8512000000000001,"tilt":25.2,"rings":false,"plinth":true,"seed":32,"moons":[{"kind":"rock","radius":0.12},{"kind":"rock","radius":0.09}]}},{"id":"fc295e43-e73d-40dd-885e-b12e9da17a47","createdAt":1786942188295,"transform":{"position":[3.5,-2.220446049250313e-16,1],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"142 million miles","title":"Mars","accent":"#7fb4ff","body":"4,212 miles across. Red because its soil is rusted iron. It has the tallest volcano in the solar system, Olympus Mons, and a canyon four times deeper than the Grand Canyon."}},{"id":"32a09b24-ea88-43e7-9893-0b7b0a314331","createdAt":1786942188297,"transform":{"position":[-2.6,8.881784197001251e-16,-4],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"1.52 AU","sub":"142 million miles"}},{"id":"87cf5ed5-29d0-4ccc-afe9-49bf0ca5a7ee","createdAt":1786942188298,"transform":{"position":[-20,5.329070518200751e-15,-56],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"jupiter","radius":17.936000000000003,"tilt":3.1,"rings":false,"plinth":false,"seed":39,"moons":[{"kind":"rock","radius":0.46399999999999997},{"kind":"moon","radius":0.4},{"kind":"rock","radius":0.656},{"kind":"moon","radius":0.6080000000000001}]}},{"id":"a149f90f-48f8-49c6-b6b0-6f79ff800cdd","createdAt":1786942188299,"transform":{"position":[-16.5,4.218847493575595e-15,-51],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"484 million miles","title":"Jupiter","accent":"#7fb4ff","body":"86,881 miles across — every other planet in the solar system would fit inside it with room to spare. It is a ball of gas with no surface to stand on. The red spot is a storm wider than Earth that has been blowing for at least 350 years."}},{"id":"6379b2e8-35aa-4c79-bf10-f42e509b7ff0","createdAt":1786942188300,"transform":{"position":[2.6,5.329070518200751e-15,-56],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"5.2 AU","sub":"484 million miles"}},{"id":"3f2b1c52-8eaa-410f-970e-2bca8723141a","createdAt":1786942188301,"transform":{"position":[20,2.531308496145357e-14,-114],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"saturn","radius":15.12,"tilt":26.7,"rings":true,"plinth":false,"seed":46,"moons":[{"kind":"moon","radius":0.6464000000000001}]}},{"id":"f53b007f-4357-4e8c-89b7-23ba151f072b","createdAt":1786942188303,"transform":{"position":[16.5,2.4202861936828413e-14,-109],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"889 million miles","title":"Saturn","accent":"#7fb4ff","body":"72,367 miles across, and light enough to float in water if you had a bath big enough. The rings are 170,000 miles wide and only about 30ft thick — a sheet of ice and rock as thin as a house is tall."}},{"id":"59d533bb-026f-4a19-9064-71bfd7e8c887","createdAt":1786942188304,"transform":{"position":[-2.6,2.531308496145357e-14,-114],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"9.5 AU","sub":"889 million miles"}},{"id":"04354157-0db2-4a91-b4ae-ec1086a46c41","createdAt":1786942188305,"transform":{"position":[-7,2.6645352591003757e-14,-152],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"uranus","radius":6.416,"tilt":97.8,"rings":false,"plinth":false,"seed":53,"moons":[{"kind":"rock","radius":0.19840000000000002}]}},{"id":"9baf694e-1a68-46b2-8a58-d5c67d86982e","createdAt":1786942188306,"transform":{"position":[-3.5,2.55351295663786e-14,-147],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"1.8 billion miles","title":"Uranus","accent":"#7fb4ff","body":"31,518 miles across. Look at how it is tipped: Uranus orbits lying on its side, so each pole spends 42 years in sunlight and 42 in darkness. Voyager 2 flew past in 1986 and photographed a nearly featureless blue-green ball."}},{"id":"89a2972b-490f-4dbf-a2ba-87e3655e6e8f","createdAt":1786942188307,"transform":{"position":[2.6,2.6645352591003757e-14,-152],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"19.2 AU","sub":"1.8 billion miles"}},{"id":"ee060627-3070-4f70-a3a8-22da843e4566","createdAt":1786942188308,"transform":{"position":[7,3.952393967665557e-14,-178],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"neptune","radius":6.208,"tilt":28.3,"rings":false,"plinth":false,"seed":60,"moons":[{"kind":"moon","radius":0.3392}]}},{"id":"f5e6ae2a-7b38-4702-a238-47f242b1ce28","createdAt":1786942188309,"transform":{"position":[3.5,3.1308289294429414e-14,-173],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"2.8 billion miles","title":"Neptune","accent":"#7fb4ff","body":"30,599 miles across. The windiest place known — storms here run at 1,200 mph. It is so far out that one of its years is 165 of ours: it has completed a single orbit since it was discovered in 1846."}},{"id":"c93e231f-1b13-4a34-bc46-113c2ade3939","createdAt":1786942188311,"transform":{"position":[-2.6,3.952393967665557e-14,-178],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distance-marker","options":{"label":"30.1 AU","sub":"2.8 billion miles"}},{"id":"ce76c1e6-46a7-4932-9b0b-d187b565a726","createdAt":1786942188312,"transform":{"position":[-16,6.217248937900877e-15,-28],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"asteroid-belt","options":{"count":20,"spread":20,"seed":31}},{"id":"624dac55-1ef5-48c7-beb5-548b7ab90bb2","createdAt":1786942188313,"transform":{"position":[18,7.105427357601002e-15,-32],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"asteroid-belt","options":{"count":16,"spread":16,"seed":37}},{"id":"11f4c4a9-a451-44b5-bbdb-96e075f879f3","createdAt":1786942188314,"transform":{"position":[8,5.329070518200751e-15,-24],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Between Mars and Jupiter","title":"The asteroid belt","accent":"#9c9186","body":"Look how much empty space there is. Films show the belt as a boulder field you have to dodge; in reality the rocks average about a million miles apart, and every spacecraft that has flown through has done so without aiming for a gap."}},{"id":"b2bcd4ac-ae51-4533-817f-cf546a24fa9e","createdAt":1786942188315,"transform":{"position":[26,4.440892098500626e-15,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"rock","radius":0.4736,"tilt":4,"seed":61}},{"id":"572e0880-4d89-4b59-957e-9ff03e231a3b","createdAt":1786942188317,"transform":{"position":[22,3.3306690738754696e-15,-15],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Dwarf planet · 1.8 AU","title":"Ceres","accent":"#9c9186","body":"590 miles across and the largest object in the asteroid belt — it holds about a third of the belt’s entire mass by itself. Shown here at four times its true size, or you could not see it."}},{"id":"e5cf6f68-723b-45c7-a52a-233aa7d32116","createdAt":1786942188318,"transform":{"position":[12,4.085620730620576e-14,-184],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planet-model","options":{"kind":"rock","radius":0.5952000000000001,"tilt":122,"seed":67}},{"id":"8397fb8b-95ae-4a3d-88b4-e61b88efd6a2","createdAt":1786942188319,"transform":{"position":[7,3.952393967665557e-14,-178],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Dwarf planet · 39 AU","title":"Pluto","accent":"#c8b8a0","body":"Reclassified in 2006 — not because it shrank, but because we found others like it out here and needed a word for the group. It is smaller than our Moon. Shown at twice true size."}},{"id":"8ee38ae7-f166-4cf0-866b-5b2f8160f3e4","createdAt":1786942188320,"transform":{"position":[-34,-8.881784197001252e-15,40],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"comet","options":{"length":16,"seed":41}},{"id":"2de48895-a151-484c-8e31-01529e2a05e4","createdAt":1786942188321,"transform":{"position":[40,8.43769498715119e-15,-70],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"comet","options":{"length":22,"seed":47}},{"id":"5b9cda88-5347-42bf-89ae-af00b40124ab","createdAt":1786942188322,"transform":{"position":[-28,-1.021405182655144e-14,46],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Which way does a tail point?","title":"Comets","accent":"#9fd8ff","body":"Away from the Sun — always. The tail is not exhaust; it is dust and gas being pushed off the comet by sunlight and the solar wind. On the way back out, a comet travels tail-first."}},{"id":"665564ab-3e79-4ca6-bb6b-b7a1c5db5a49","createdAt":1786942188324,"transform":{"position":[18,-2.886579864025407e-14,130],"rotation":[0,-1.04,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE SOLAR SYSTEM"],"subtitle":"Sizes are true against each other. Distances are not — every marker gives the real one","width":14,"height":4}},{"id":"d386ffdf-0c98-48dd-b155-a3675cb99de4","createdAt":1786942188325,"transform":{"position":[-9,-2.7533531010703882e-14,124],"rotation":[0,0.6435011087932844,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"a56faa95-f9b1-40d7-a399-1f36bb4d176d","createdAt":1786942188326,"transform":{"position":[-9,3.9999999999999725,124],"rotation":[0,0.6435011087932844,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"96894cc3-bed4-4b4b-9d49-b298de42c52a","createdAt":1786942188327,"transform":{"position":[-22,-2.6201263381153694e-14,118],"rotation":[0,0.55,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Spin Jupiter","target":"Walk down to Jupiter, click it → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 12 degrees","depth":1},{"cat":"control","text":"wait 0.05 seconds","depth":1}],"tip":"Jupiter turns once every 10 hours — the shortest day of any planet, even though it is the biggest. Try the same script on Venus: a real Venus day is 243 Earth days, so slow it right down to 1 degree and a 2 second wait.","accent":"#c2861f"}},{"id":"e0d109cc-22e3-4cd8-8400-46f252140c5a","createdAt":1786942188329,"transform":{"position":[22,-2.6201263381153694e-14,118],"rotation":[0,-0.55,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Send a comet in and back out","target":"Click the comet near the Sun → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"move forward 30 feet","depth":1},{"cat":"control","text":"wait 1 seconds","depth":1},{"cat":"motion","text":"move forward 30 feet","depth":1},{"cat":"control","text":"wait 3 seconds","depth":1}],"tip":"A real comet moves fastest when it is closest to the Sun and crawls when it is far away, which is why it spends most of its life out in the cold. Make the outbound wait much longer than the inbound one and you have modelled that.","accent":"#3d8bf2"}},{"id":"4af894d4-b81e-4323-ba78-dd328e100f53","createdAt":1786942188330,"transform":{"position":[0,12.000000000000007,-60],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"c270395a-c8be-4735-99a5-18fedc6887b3","createdAt":1786942188331,"transform":{"position":[0,12.000000000000027,-120],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"6a3cb38c-29c1-4556-b9a7-a431bcc9c94f","createdAt":1786942188332,"transform":{"position":[0,10.00000000000003,-170],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"076b144d-0e2e-42c9-aa1f-7bc36908529a","createdAt":1786942188333,"transform":{"position":[0,7.999999999999994,60],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}