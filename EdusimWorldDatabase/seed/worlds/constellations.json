ions":{"radius":4.2,"height":3.3,"seed":51}},{"id":"7ba5c21c-9d8b-467c-a909-f299d3e7d727","createdAt":1786982737246,"transform":{"position":[-16,3.4500000000000077,-34],"rotation":[0,0.14444157837464397,0],"scale":[1,1,1]},"program":[{"id":"e42b76fd-8e01-4021-b5fc-369219352e7b","type":"forever","params":{},"children":[{"id":"14480823-9f73-4b85-b1eb-6a7f5587bdd1","type":"rotate","params":{"degrees":0.5}}]}],"kind":"preset-prop","prop":"sky-wheel-disc","options":{"radius":4.2,"seed":52}},{"id":"82f5b939-c548-4bda-bf35-417ef3e17710","createdAt":1786982737256,"transform":{"position":[17,7.549516567451064e-15,-34],"rotation":[0,-0.15333238839832278,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"spectral-row","options":{"length":14,"seed":61}},{"id":"e55d9b80-deec-4ba1-a850-4fc68d66567b","createdAt":1786982737267,"transform":{"position":[0,-0.08394527370025795,92],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"polaris-sight","options":{"altitude":39,"height":4.4,"seed":71}},{"id":"16ebe4f8-a495-4bcb-8591-c3cac4ae2c05","createdAt":1786982737273,"transform":{"position":[-10,-7.549516567451064e-15,66],"rotation":[0,0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"chart-table","options":{"width":4.6,"seed":111}},{"id":"57def68c-1574-470b-9614-21343009c586","createdAt":1786982737281,"transform":{"position":[-15,-9.769962616701378e-15,44],"rotation":[0,0.43833655985795783,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"width":10,"eyebrow":"✦  THE CONSTELLATIONS","lead":"Eight boards down the field. The same stars are overhead.","lines":["Orion is straight ahead.","Now turn round and find Polaris."],"footnote":"The brass sphere at the head of the avenue is already running a program"}},{"id":"db3005fa-27ed-4f77-98fe-aae4ef65f065","createdAt":1786982737293,"transform":{"position":[24,-5.773159728050814e-15,58],"rotation":[0,-0.9272952180016122,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"9204657d-ff41-4496-8b34-9f69d4fc9a5f","createdAt":1786982737302,"transform":{"position":[24,3.9999999999999942,58],"rotation":[0,-0.9272952180016122,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"ed9f5630-c399-447d-b314-3d55c9ee4500","createdAt":1786982737311,"transform":{"position":[-11,-6.661338147750939e-15,30],"rotation":[0,0.2347226124851971,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Why the whole sky turns","body":"Nothing up there is moving the way it looks like it is. The Earth spins once a day, and because you are standing on it, everything else appears to swing the opposite way — 15 degrees every hour. Point at a star, wait an hour, and you are pointing 15 degrees off. The only exception is Polaris: it sits almost exactly above the North Pole, on the axis the Earth spins about, so it stays put while the entire rest of the sky wheels around it. Every trail in a long night-time photograph is a circle centred on that one star."}},{"id":"7e0f868c-d019-40e1-bfdc-d61d2f3be080","createdAt":1786982737322,"transform":{"position":[11,-6.661338147750939e-15,30],"rotation":[0,-0.2347226124851971,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"You are looking into the past","body":"Light is fast but the sky is enormous, so everything you can see up there is out of date. The Moon is a second and a half old. The Sun is eight minutes. Sirius is nine years — light that left it when you were small. Betelgeuse in Orion is about 550 years, so you are seeing it as it was before anybody had sailed to America, and Deneb in Cygnus is around 1,500. The stars in one constellation are nowhere near each other: they are at wildly different distances and only look like a group because we are all looking from one spot."}},{"id":"9da8e620-f747-47e1-931c-a722d36a4a54","createdAt":1786982737329,"transform":{"position":[-22,1.7763568394002505e-15,-8],"rotation":[0,0.2561513825656035,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Tonight is a WINTER sky","body":"Four of the eight boards show constellations you cannot see this evening, and that is not a mistake. As the Earth goes round the Sun, the night side of the planet faces a different part of space each season — so Scorpius and Cygnus are up there right now in the daytime, lost in sunlight, and they will be back on summer nights when Orion is the one that has gone. Crux never appears at all from this latitude. The star wheel down the field is the tool that answers \"what is up tonight\": line the date against the hour and read off the sky."}},{"id":"4763200d-c9f5-4d9d-98af-934734b7e87e","createdAt":1786982737336,"transform":{"position":[22,1.7763568394002505e-15,-8],"rotation":[0,-0.2561513825656035,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Why every lamp here is red","body":"Your eyes take twenty to thirty minutes in the dark to reach full sensitivity, as a chemical called rhodopsin builds up in them — and one glance at a white light destroys it in a second. Red light barely touches rhodopsin, so observers use red torches and red lamps for everything, and the lamps on this field are hooded to throw their light down rather than sideways. It is worth trying for yourself on a clear night: wait half an hour without looking at a phone and the number of stars you can see roughly triples."}},{"id":"ec7d4d04-f2f4-4c37-89af-b26fca6a70ad","createdAt":1786982737348,"transform":{"position":[16,-6.661338147750939e-15,30],"rotation":[0,-0.3347368373168147,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Speed up the whole sky","target":"the brass armillary sphere","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 0.14 degrees","depth":1}],"tip":"This one is ALREADY running — click the sphere and choose Program to read it. The real sky takes 24 hours to come back round. Change 0.14 to 6 and watch a day go by in seconds, or make it negative and run time backwards.","accent":"#d9b45f"}},{"id":"b4b9219c-1c3d-4152-b288-fa6d79530c49","createdAt":1786982737362,"transform":{"position":[-22,-1.3322676295501878e-15,6],"rotation":[0,0.3045108832021125,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Throw a shooting star","target":"the meteor high on your left","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"glide 170 feet over 1.3 seconds","depth":1},{"cat":"motion","text":"go back to start","depth":1},{"cat":"control","text":"wait 4 seconds","depth":1}],"tip":"`go back to start` is what makes it repeat instead of leaving the world — the meteor is put back where it began. Shorten the wait and you have a meteor shower. Real ones are grains of dust the size of this full stop, burning up sixty miles above you.","accent":"#79c2b0"}},{"id":"11b3cda3-e42b-4ae6-aff7-7ffe80ec999b","createdAt":1786982737368,"transform":{"position":[-26,-6.661338147750939e-15,30],"rotation":[0,0.5144513130590277,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{"length":5,"woodColor":6244915}},{"id":"621cae37-223d-46af-ad63-289b1626ac00","createdAt":1786982737376,"transform":{"position":[26,-6.217248937900877e-15,28],"rotation":[0,-0.49642275340488184,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{"length":5,"woodColor":6244915}},{"id":"c7540b7d-a7b5-4d77-8b29-ab6417836465","createdAt":1786982737383,"transform":{"position":[-30,8.881784197001251e-16,-4],"rotation":[0,0.3587706702705722,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{"length":5,"woodColor":6244915}},{"id":"3d98fcba-7895-4310-9cae-2c449505077e","createdAt":1786982737395,"transform":{"position":[-22,-3.1086244689504383e-15,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"red-lamp","options":{"height":9,"seed