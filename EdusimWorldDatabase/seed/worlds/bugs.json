{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T04:49:53.664Z","records":[{"id":"9ee9440a-7015-4b9b-ae48-d20f81025fff","kind":"world-theme","theme":"bugs","createdAt":1786942193537,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"ab17e0d9-9b1d-4be3-ab98-332c45245e8a","kind":"world-spawn","createdAt":1786942193537,"transform":{"position":[0,0,132],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"e2b9c2da-2474-4966-923a-cde300d50498","createdAt":1786942193540,"transform":{"position":[0,-0.06962749361993392,100],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"🐜  A BUG’S LIFE","lead":"You are the size of an ant.","lines":["BUILD on the left,","CODE on the right."],"footnote":"That blade of grass is really only as tall as your hand"}},{"id":"09ea36c2-469c-441d-b055-ed17601e37e6","createdAt":1786942193542,"transform":{"position":[30,0.18692083209868837,116],"rotation":[0,-1.0808390005411683,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["A BUG’S LIFE"],"subtitle":"An ant colony, sixty times life size — ten challenges down the avenue","width":17,"height":4.4}},{"id":"ab5f355b-80b8-45db-bf36-76e71d1a9f83","createdAt":1786942193543,"transform":{"position":[-22,-0.06997847993897865,114],"rotation":[0,0.8850668158886104,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"18952b5b-c45d-416e-aed0-3ff25b05c455","createdAt":1786942193545,"transform":{"position":[-22,3.9300215200610213,114],"rotation":[0,0.8850668158886104,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"d212c8fc-9342-4fcb-a687-960e39ca321d","createdAt":1786942193546,"transform":{"position":[0,6.661338147750939e-15,-62],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ant-hill","options":{"radius":44,"height":26,"seed":11}},{"id":"c0402b03-8cdb-4f28-b3c5-ad60e710b7a0","createdAt":1786942193547,"transform":{"position":[-66,8.881784197001252e-15,-40],"rotation":[0,0.6898000447336079,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"nest-cutaway","options":{"width":46,"height":30,"depth":4,"seed":13}},{"id":"ca837bde-e365-47ea-b71d-ab14a0538c98","createdAt":1786942193549,"transform":{"position":[-44,4.440892098500626e-15,-20],"rotation":[0,0.7216548508647612,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Cut through the nest","title":"Who lives where","accent":"#8a6f4a","body":"The brood is kept near the top where the sun warms the soil, and workers carry the eggs up and down through the day to keep them at the right temperature. The seed store is in the middle. The queen is deep down, and she is the only one laying — every worker you can see is her daughter. The rubbish heap is kept as far from the food as the nest allows."}},{"id":"bbec8d82-0b52-4764-a6bf-3c9c6817cc02","createdAt":1786942193550,"transform":{"position":[40,6.661338147750939e-15,-30],"rotation":[0,-0.5880026035475675,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Nobody is in charge","title":"How a colony decides","accent":"#5f9a6a","body":"There is no leader. An ant that finds food walks home laying a scent trail, and other ants that cross it follow it and lay more. A short route gets walked more often, so it gets stronger faster — and the colony ends up using the shortest path without a single ant ever comparing two routes. The queen gives no orders at all; she lays eggs."}},{"id":"a9501a49-b460-443b-82cb-305235e8d403","createdAt":1786942193551,"transform":{"position":[34,1.7763568394002505e-15,-8],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"pheromone-trail","options":{"length":92,"curve":16,"dots":30,"seed":17}},{"id":"4fb26feb-a29e-4e48-85dd-5bfb18cbc2b1","createdAt":1786942193552,"transform":{"position":[72,-3.3818173594823975e-8,26],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":