reset-prop","prop":"dandelion-clock","options":{"height":40,"seed":321}},{"id":"4fb90d3d-ef59-4ca7-baa1-7a46917bc934","createdAt":1786942193627,"transform":{"position":[-40,0.01159264425385409,-104],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dandelion-clock","options":{"height":38,"seed":328}},{"id":"f2869a5c-16c0-46b1-bc9c-b62de7524949","createdAt":1786942193628,"transform":{"position":[-84,0.12354874572211827,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"clover","options":{"height":18,"seed":400}},{"id":"f6e9590f-708d-490c-bc6a-51f71f60542d","createdAt":1786942193630,"transform":{"position":[86,0.2579623998823175,92],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"clover","options":{"height":16,"seed":405}},{"id":"283285f4-f7c2-412e-add1-e66853adcca2","createdAt":1786942193631,"transform":{"position":[-100,-0.09652850782769251,34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"clover","options":{"height":19,"seed":410}},{"id":"eb133b23-855a-4923-9f61-9961f08d345d","createdAt":1786942193632,"transform":{"position":[98,0.06798968365444624,30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"clover","options":{"height":17,"seed":415}},{"id":"ca6c079e-abb8-40ff-bcb8-0d263b266312","createdAt":1786942193634,"transform":{"position":[-90,0.21728509664537787,-70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"clover","options":{"height":18,"seed":420}},{"id":"91ddd822-7032-49c3-bde6-61dc0c7b1424","createdAt":1786942193635,"transform":{"position":[94,0.10381840246309304,-74],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"clover","options":{"height":16,"seed":425}},{"id":"b3c72944-6cdd-4094-a839-a42ea6c9024f","createdAt":1786942193636,"transform":{"position":[-108,-0.24535641756876903,84],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"toadstool","options":{"height":24,"capColor":12861486,"seed":500}},{"id":"f0910d4a-d842-4abf-b2cc-74066b101c00","createdAt":1786942193637,"transform":{"position":[-96,0.05932134535882483,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"toadstool","options":{"height":18,"capColor":14190394,"seed":509}},{"id":"f8506f14-0594-435b-a473-27c55609252e","createdAt":1786942193639,"transform":{"position":[108,0.044279500630221236,80],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"toadstool","options":{"height":22,"capColor":12080188,"seed":518}},{"id":"24b60a7e-f409-455a-ad92-19371f8dfa41","createdAt":1786942193640,"transform":{"position":[-118,0.13214097273075476,-74],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"toadstool","options":{"height":20,"capColor":12861486,"seed":527}},{"id":"ed1fd719-6a00-4285-a174-b338e34b2d93","createdAt":1786942193641,"transform":{"position":[-74,-0.01811019887785381,52],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"pebble-field","options":{"spread":18,"count":6,"size":7,"seed":600}},{"id":"abeb6790-60f3-4385-a74d-e49e9b16e864","createdAt":1786942193642,"transform":{"position":[76,0.000010556390276583727,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"pebble-field","options":{"spread":20,"count":6,"size":8,"seed":607}},{"id":"dc690291-eef8-469c-b59f-f864773c171d","createdAt":1786942193643,"transform":{"position":[-58,0.0520570301860519,-78],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"pebble-field","options":{"spread":16,"count":6,"size":6,"seed":614}},{"id":"3fef4250-9244-4b56-8e6a-d8176752a2b9","createdAt":1786942193645,"transform":{"position":[64,0.01804081095983623,-84],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"pebble-field","options":{"spread":19,"count":6,"size":7.5,"seed":621}},{"id":"97ed67cc-9020-4eba-bb47-463ddb6d09f5","createdAt":1786942193646,"transform":{"position":[-124,-0.7240985427482443,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"pebble-field","options":{"spread":17,"count":6,"size":6.5,"seed":628}},{"id":"11492147-abda-40a2-b201-2ff9b13b3eaf","createdAt":1786942193647,"transform":{"position":[126,-0.41840160273443283,90],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"pebble-field","options":{"spread":18,"count":6,"size":7,"seed":635}},{"id":"ee823f85-aea7-4d4b-88a4-01d037f21246","createdAt":1786942193648,"transform":{"position":[-34,-0.002005995686576334,76],"rotation":[0,0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"tutorial-board","options":{"kicker":"🔨  BUILD IT","number":1,"title":"A bridge over the drop","accent":"#c2521f","intro":"Menu ▸ Create Model. Every piece lands in front of you in build yellow — click the hammer floating above it.","steps":[{"lead":"Deck","text":"A Cube. Grab a corner and stretch it long and thin — wider than the water, and about a step across."},{"lead":"Two piers","text":"A Cylinder stretched tall, one at each end of where the deck will go. Stand them in the soil, not in the water."},{"lead":"Lift the deck","text":"Drag the GREEN ball above the deck straight UP until it clears the piers, then slide it over them."},{"lead":"Kerbs","text":"Two more Cubes, squashed thin, laid along each edge so nothing rolls off."},{"lead":"Connect, then Render","text":"Connect every piece to the deck, then press Render Model. Now it is one object."}],"tip":"The green ball decides lift-or-slide from the first inch you drag it: pull UP to raise, sideways to slide. If it slides when you meant to lift, let go and start the drag straight upward.","width":10.5,"height":8.4,"postHeight":11.5}},{"id":"19279866-ea58-4d1c-a2eb-846fc158fb4e","createdAt":1786942193650,"transform":{"position":[-44,-3.9968028886505635e-15,50],"rotation":[0,0.9129077216126866,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"tutorial-board","options":{"kicker":"🔨  BUILD IT","number":2,"title":"Build a worker ant","accent":"#a8541f","intro":"Walk up to a real one on the trail first and look at it side-on. Three parts, and a waist you could snap.","steps":[{"lead":"Gaster","text":"A Sphere stretched into an egg, lying on its side. This is the big rear end."},{"lead":"The waist","text":"A Cylinder squashed very thin and very short, in front of it. Make it thinner than you think — this is the bit that makes it an ant."},{"lead":"Middle and head","text":"A Sphere for the middle, a smaller Sphere in front for the head, and two tiny Spheres on the sides of the head for eyes."},{"lead":"Six legs","text":"A Cylinder squashed to a rod. Three a side, and ALL SIX on the middle part only — never on the gaster."},{"lead":"Antennae","text":"Two more rods, bent at the elbow: one going up and out, a shorter one angled off the end of it."}],"tip":"Three parts and six legs is an insect. Two parts and eight legs is a spider. Get the waist and the elbowed antennae and everyone will know what you built.","width":10.5,"height":8.4,"postHeight":11.5}},{"id":"dbf70f0d-6b65-47b4-97f3-d122eb832c69","createdAt":1786942193651,"transform":{"position":[-48,-4.884981308350689e-15,22],"rotation":[0,0.9544993893988254,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"tutorial-board","options":{"kicker":"🔨  BUILD IT","number":3,"title":"A grain store","accent":"#8a6f2a","intro":"The colony keeps its seeds in a dry chamber. Build one, then park a food item inside it.","steps":[{"lead":"Floor","text":"A Cube squashed flat and stretched wide. Everything else stands on this."},{"lead":"Three walls","text":"A Cube stretched tall and thin. One at the back, one each side. Leave the fourth side open as a doorway."},{"lead":"Roof","text":"A Pyramid, stretched to overhang the walls. Lift it with the green ball until it sits on top of them."},{"lead":"A step at the door","text":"A short Cylinder laid on its side, so an ant can get in with a seed."},{"lead":"Connect, then Render","text":"Connect the walls to the floor and the roof to the walls, then Render Model."}],"tip":"A piece you have lifted keeps its height when you slide it sideways, so raise the roof once and then line it up. That is the whole reason the green handle exists.","width":10.5,"height":8.4,"postHeight":11.5}},{"id":"22941a83-7f24-4bfc-8b78-6782742443a8","createdAt":1786942193652,"transform":{"position":[-46,1.3322676295501878e-15,-6],"rotation":[0,0.9342881110069455,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"tutorial-board","options":{"kicker":"🔨  BUILD IT","number":4,"title":"A ladder to the leaf","accent":"#5f7a2a","intro":"A fallen leaf is a floor from down here. Build something to get up onto one.","steps":[{"lead":"Two rails","text":"A Cylinder stretched long and thin. Make a second one beside it, about a body-width apart."},{"lead":"Rungs","text":"Short Cylinders laid across, evenly spaced. Six or seven is plenty."},{"lead":"Connect first","text":"Connect every rung to both rails BEFORE you tilt anything. It is far easier while it is lying flat."},{"lead":"Lean it","text":"Open Rotate/Move Shape and drag an upright ring. It clicks round in 15 degree steps — 45 degrees is three clicks."},{"lead":"Render","text":"Press Render Model and walk up it."}],"tip":"A ring seen exactly edge-on cannot be grabbed — it is a hairline down the middle of the piece. Take two steps sideways and it opens into a circle you can hold.","width":10.5,"height":8.4,"postHeight":11.5}},{"id":"9155b42d-0f88-4272-b6c7-06942d0639a2","createdAt":1786942193653,"transform":{"position":[-38,7.549516567451064e-15,-34],"rotation":[0,0.8408966686431651,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"tutorial-board","options":{"kicker":"🔨  BUILD IT","number":5,"title":"Invent your own bug","accent":"#6b3fa0","intro":"No instructions this time. Four shapes, and one rule to break on purpose or keep on purpose.","steps":[{"lead":"Decide what it is","text":"Insect: three body parts, six legs, two antennae. Spider: two parts, eight legs, no antennae. Pick one and stick to it."},{"lead":"Give it a job","text":"A digger needs shovels on the front. A jumper needs huge back legs. A hunter needs eyes that face forward. The job decides the shape."},{"lead":"Make it one colour family","text":"Apply a colour to every piece from the same corner of the picker. A bug in six unrelated colours reads as a pile of shapes."},{"lead":"Render, then program it","text":"Render Model, then click it and give it a walk from the boards across the avenue."}],"tip":"Real insects are almost all symmetrical left-to-right. Build one side, then build the other to match — and if you get bored of matching, that asymmetry is exactly what makes a fiddler crab look odd.","width":10.5,"height":8.4,"postHeight":11.5}},{"id":"cc83f4e5-8480-425b-8e83-206754d2e0ab","createdAt":1786942193655,"transform":{"position":[34,0.0029352879201782756,76],"rotation":[0,-0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Follow the scent trail","target":"Click any ant on the glowing trail → Program.","steps":[{"cat":"control","text":"repeat 22 times","depth":0},{"cat":"motion","text":"move forward 6 feet","depth":1},{"cat":"motion","text":"rotate 5 degrees","depth":1},{"cat":"control","text":"wait 0.1 seconds","depth":1}],"tip":"A little forward and a little turn, over and over, draws a curve — which is exactly the shape of the trail. Make the rotate bigger and the curve gets tighter. Make it 0 and the ant walks straight off the edge of the trail.","accent":"#4c97ff"}},{"id":"d4e4f638-a66a-46a9-887c-cc19774ee094","createdAt":1786942193656,"transform":{"position":[44,-3.9968028886505635e-15,50],"rotation":[0,-0.9129077216126866,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"The forager’s round trip","target":"Click an ant near the food → Program.","steps":[{"cat":"motion","text":"move forward 34 feet","depth":0},{"cat":"control","text":"wait 1 seconds","depth":0},{"cat":"look","text":"say found it","depth":0},{"cat":"control","text":"wait 2 seconds","depth":0},{"cat":"motion","text":"go back to start","depth":0}],"tip":"Go back to start puts it exactly where it began — position, turn and size, all at once. It is the undo button for a program that has wandered off, and it is worth knowing before you need it.","accent":"#c48a3a"}},{"id":"1517e1b6-cbd8-428b-b5de-42e043edda0e","createdAt":1786942193657,"transform":{"position":[48,-4.884981308350689e-15,22],"rotation":[0,-0.9544993893988254,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":3,"title":"Tell the whole colony","target":"Two ants. The first three blocks on ONE, the last two on ANOTHER.","steps":[{"cat":"look","text":"say food this way","depth":0},{"cat":"control","text":"wait 1 seconds","depth":0},{"cat":"look","text":"say food this way","depth":0},{"cat":"control","text":"when an object says food this way","depth":0},{"cat":"motion","text":"glide 30 feet over 3 seconds","depth":1}],"tip":"The second ant does nothing when you press play — it is waiting. It only moves when it hears the words, and they have to match exactly. Put the same two blocks on five ants and one scout starts the whole column.","accent":"#ffab19"}},{"id":"aaee1108-b8d5-4d3b-b8a2-dfc7f1722f3d","createdAt":1786942193658,"transform":{"position":[46,1.3322676295501878e-15,-6],"rotation":[0,-0.9342881110069455,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":4,"title":"Carry the crumb home","target":"Click the bread crumb itself → Program.","steps":[{"cat":"control","text":"repeat 8 times","depth":0},{"cat":"motion","text":"glide 7 feet over 1 seconds","depth":1},{"cat":"look","text":"change size by -9 %","depth":1},{"cat":"control","text":"wait 0.5 seconds","depth":0},{"cat":"look","text":"set size to 100 %","depth":0}],"tip":"Watch the last two blocks. Change size BY takes another slice off whatever is left, so eight of them do not remove 72% — they leave about half. Set size TO measures from the size it started at, so 100% is always the whole crumb back.","accent":"#9966ff"}},{"id":"5c7576ab-ea23-4dc5-b024-88935e3a83cf","createdAt":1786942193660,"transform":{"position":[38,7.549516567451064e-15,-34],"rotation":[0,-0.8408966686431651,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":5,"title":"The ladybird takes off","target":"Click the ladybird on the fallen leaf → Program.","steps":[{"cat":"control","text":"repeat 14 times","depth":0},{"cat":"motion","text":"move up by 3 feet","depth":1},{"cat":"motion","text":"rotate 20 degrees","depth":1},{"cat":"look","text":"set opacity to 25 %","depth":1},{"cat":"control","text":"wait 0.15 seconds","depth":1},{"cat":"motion","text":"go back to start","depth":0}],"tip":"Move up is the one motion block that ignores which way a thing is facing — up is up. Set opacity fades it into the sky without deleting it, and go back to start brings it down again solid. Try taking that last block out and see where it ends up.","accent":"#e0455f"}},{"id":"e37a74f3-d6fb-474b-b2d7-0f4f539885a1","createdAt":1786942193661,"transform":{"position":[0,30.000000000000007,-62],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"97d5161f-6abb-4527-8960-d25640e97bca","createdAt":1786942193662,"transform":{"position":[-66,22.000000000000007,-40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"e531a22b-e0c7-446e-b97d-f92295cc4884","createdAt":1786942193663,"transform":{"position":[72,13.999999966181827,26],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"93d8f334-40d6-44d4-8f25-d6c8727a5281","createdAt":1786942193664,"transform":{"position":[0,25.999999999999993,60],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}