":"light-orb","color":"#f2a541"},{"id":"bd22a123-30d6-44b3-969d-09961322a165","createdAt":1787061931505,"transform":{"position":[-24,9,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"ae4ed628-db2a-47b4-bf91-fcfbc14e3b2c","createdAt":1787061931505,"transform":{"position":[4,9,-40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"0d5b4063-0b80-4293-b840-360ff86650f4","createdAt":1787061931505,"transform":{"position":[28,9,-38],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"462f7f56-2edd-4764-ba65-47c792017ecb","createdAt":1787061931505,"transform":{"position":[-32,0,58],"rotation":[0,0.7551044034786732,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"⚛️  GREENBUSH SCIENCE CENTER","lead":"Girard, Kansas — walk in through the front door.","lines":["Fifteen exhibits and five robots inside.","Everything in here can be programmed."],"footnote":"The doorway under the curved canopy is open — walk straight in"}},{"id":"b55aa1ef-7acc-426a-beb6-a38da44c757e","createdAt":1787061931505,"transform":{"position":[-12,0,14],"rotation":[0,0.15264932839526518,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"ABOUT THIS BUILDING","title":"Two thirds of the real thing","body":"The real Science Center has about 220 feet of frontage. This one has 146, because the world is only 390 feet across and you have to be able to stand back far enough to see all of it. Everything else — the twin barrel vaults, the tower, the canopy — is where it really is.","accent":"#1f5c4a"}},{"id":"315f2eb3-e778-4468-b93f-4e1f7dd655df","createdAt":1787061931505,"transform":{"position":[10,0,80],"rotation":[0,-0.6947382761967033,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"0a2428b1-9709-4d82-9f6a-4f48d99b5342","createdAt":1787061931505,"transform":{"position":[10,4,80],"rotation":[0,-0.6947382761967033,0],"scale":[1,1,1]},"kind":"web-browser","url":"https://edusim3dweb.com"},{"id":"afae24c8-12a9-4815-926a-9eeac63c68f3","createdAt":1787061931505,"transform":{"position":[24,0,-8],"rotation":[0,-1.0040671092713902,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Turn the wind turbine","target":"the demonstration turbine by the right wall","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 2 degrees","depth":1}],"tip":"The number is degrees per turn of the loop, not per second. A real turbine turns much slower than you expect — try 0.5, then try 20 and see which one looks right.","accent":"#3fb37f"}},{"id":"584db90e-0ece-4c9d-a02f-0ee6d01c1fa7","createdAt":1787061931505,"transform":{"position":[22,0,-20],"rotation":[0,-0.8097835725701669,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Set the planets going","target":"the orrery on the amber plinth","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 0.6 degrees","depth":1},{"cat":"control","text":"wait 0.05 seconds","depth":1}],"tip":"Take the wait out and it spins far too fast to read. Put it back and change it instead of the angle — that is the difference between how far it turns and how often.","accent":"#f2a541"}},{"id":"1ac93260-14cc-42c1-8ba8-490329f825d5","createdAt":1787061931505,"transform":{"position":[-6,0,-38],"rotation":[0,-0.35299038782691045,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":3,"title":"Drive a robot out of the bay","target":"any of the five robots along the back wall","steps":[{"cat":"control","text":"repeat 4 times","depth":0},{"cat":"motion","text":"move forward 6 feet","depth":1},{"cat":"motion","text":"rotate 90 degrees","depth":1},{"cat":"motion","text":"go back to start","depth":0}],"tip":"360 divided by 4 is 90, so it comes back to the corner it started from — and `go back to start` then puts it exactly where it was parked. Try repeat 3 with rotate 120.","accent":"#22b3cc"}}]}