08382390,"transform":{"position":[-24,-0.06639623203985932,98],"rotation":[0,1.042721878368537,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["ELLIS ISLAND"],"subtitle":"1907 — twelve million people came through this door","width":15,"height":4.2}},{"id":"430f59c5-e7e2-485b-8a83-2bee35b37a01","createdAt":1787008382390,"transform":{"position":[12,-0.11436125995123222,98],"rotation":[0,-0.7086262721276703,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"ee5c448e-2d49-47dd-98e6-fe964d51f89c","createdAt":1787008382390,"transform":{"position":[12,3.8856387400487677,98],"rotation":[0,-0.7086262721276703,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"10d67271-0199-436d-beff-e7ee639d21e9","createdAt":1787008382390,"transform":{"position":[-30,-0.020245107263417966,90],"rotation":[0,0.9380474917927134,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Bring the ship in to the pier","target":"Click the steamship → Program.","steps":[{"cat":"control","text":"repeat 14 times","depth":0},{"cat":"motion","text":"move forward 2 feet","depth":1},{"cat":"control","text":"wait 0.4 seconds","depth":1}],"tip":"Two feet at a time, with a pause — a ship this size comes alongside at walking pace and stops by reversing its engines. Try 12 ft with no wait and you will see why they do not.","accent":"#a8593c"}},{"id":"26c2f385-74f6-4e0c-b58d-1c4a8ffa28e3","createdAt":1787008382390,"transform":{"position":[24,0.021027711955343288,88],"rotation":[0,-0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Make the ship signal, and Liberty answer","target":"Two stacks. Give the first to the STEAMSHIP, the second to the Statue of Liberty.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"look","text":"say land ahead","depth":1},{"cat":"control","text":"wait 6 seconds","depth":1},{"cat":"control","text":"when an object says land ahead","depth":0},{"cat":"look","text":"change color to #ffd27f","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1},{"cat":"look","text":"change color to #7fd4c4","depth":1}],"tip":"Two objects, two stacks, one message. \"when an object says\" does not care WHICH object spoke, so give the same listening stack to the Main Building as well and both answer at once. Liberty really was a dull brown when she arrived — copper turns green as it weathers, and it took about thirty years.","accent":"#74b09a"}},{"id":"540d57b2-f92d-4adf-bc88-891ecdd549d1","createdAt":1787008382390,"transform":{"position":[0,7,26],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"a5c26b25-629e-46e0-93d6-8b60a54cd129","createdAt":1787008382390,"transform":{"position":[-6,6,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}