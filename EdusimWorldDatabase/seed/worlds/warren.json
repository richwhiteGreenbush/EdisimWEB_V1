,"scale":[1,1,1]},"kind":"preset-prop","prop":"bramble-thicket","options":{"radius":9,"canes":18,"seed":51}},{"id":"7c19ee0e-7857-40fe-b49a-a8c269873ffc","createdAt":1786965902241,"transform":{"position":[-52,-0.0014649703865914354,-6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"hawthorn-tree","options":{"height":23,"seed":61}},{"id":"8ba555fb-fea2-4b88-920a-19c4bce1f9af","createdAt":1786965902243,"transform":{"position":[40,-0.0007844541105530567,40],"rotation":[0,-0.6610431688506868,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"🐇  A RABBIT’S DEN","lead":"Everything here is about four times life size.","lines":["The bank is cut open.","Look inside for the nest."],"footnote":"A real rabbit is about sixteen inches nose to tail"}},{"id":"915dfd00-d508-4258-ae42-3b16bd472961","createdAt":1786965902244,"transform":{"position":[46,0.017920446997006234,50],"rotation":[0,-1.1902899496825317,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"d288fd2a-f76e-46ca-af55-84062b2b3cb5","createdAt":1786965902246,"transform":{"position":[46,4.017920446997007,50],"rotation":[0,-1.1902899496825317,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"c490a564-8b57-40cb-97a4-17cd29c3bdcb","createdAt":1786965902247,"transform":{"position":[20,-7.549516567451064e-15,34],"rotation":[0,0.24497866312686414,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Built to be prey","body":"Almost every part of a rabbit is about not being eaten. Its eyes sit high on the SIDES of its head, so it can see nearly all the way round without turning — the blind spot is directly in front of its nose, which is why it uses those long whiskers to judge gaps. The ears turn independently. The white tail is a signal: flashed while running, it tells every other rabbit in the field to bolt."}},{"id":"4a7dbbc9-2ded-45ab-99e2-b24f157a1c1b","createdAt":1786965902249,"transform":{"position":[-4,-1.7763568394002505e-15,8],"rotation":[0,0.5404195002705842,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Inside the warren","body":"A warren is dug, not found. The wide tunnels are runs, and the small blind ones are bolt holes — escape shafts that stop just under the surface so a rabbit can burst out of the ground anywhere. The chamber low down is the nest: the doe lines it with grass and with fur pulled from her own chest, then blocks the entrance with soil every time she leaves."}},{"id":"6d90063d-0957-4490-8ac3-36b6f8f65195","createdAt":1786965902250,"transform":{"position":[-12,6.999999999999999,4],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"}]}