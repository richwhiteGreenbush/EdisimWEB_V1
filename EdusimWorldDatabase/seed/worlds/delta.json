6593023785877,72],"rotation":[0,1.0191413442663497,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Cast off and head downriver","target":"Click the steamboat → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"glide 90 feet over 12 seconds","depth":1},{"cat":"motion","text":"go back to start","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1}],"tip":"Now compare the two movement blocks. \"move forward\" jumps the whole distance at once; \"glide\" spreads it over the seconds you give it, so a boat this size stops teleporting and starts steaming. Downstream a packet made 15 mph and upstream barely 5 — try 12 seconds one way and 36 the other.","accent":"#9a3226"}},{"id":"63ecf76c-0a6f-4a4c-bb97-2c50b97828f0","createdAt":1786942191022,"transform":{"position":[26,0.04183434843066758,70],"rotation":[0,-0.9652516631899266,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Pole the pirogue across","target":"Click one of the little dug-out boats → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"move forward 20 feet","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"motion","text":"move forward 20 feet","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"A pirogue is dug from a single cypress log and draws a few inches, so it goes where the steamboat cannot. Because move forward follows the way it points, you can give it four sides instead of two: repeat 4 times holding move forward and rotate 90 degrees.","accent":"#6b5842"}},{"id":"0eac4037-48aa-4afe-a833-3862e42b4b1c","createdAt":1786942191024,"transform":{"position":[-4,15.99996757605274,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"cf9198aa-6c16-4bab-9bd3