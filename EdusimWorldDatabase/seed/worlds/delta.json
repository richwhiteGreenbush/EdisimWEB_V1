k the call for his pen name."}},{"id":"e729b2a0-d076-4e24-a4aa-012484d3692b","createdAt":1786942191002,"transform":{"position":[-14,-0.018785663944213216,58],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":22,"seed":400,"leafColor":5139258}},{"id":"7906fb97-22f2-4064-a99b-593d498db209","createdAt":1786942191003,"transform":{"position":[14,0.06234503245900047,60],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":27,"seed":407,"leafColor":5139258}},{"id":"bec13470-4623-4172-8fc6-4aa6069c9e43","createdAt":1786942191005,"transform":{"position":[-28,-0.21290100035620663,74],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":22,"seed":414,"leafColor":5139258}},{"id":"ee9f334e-e39a-4e43-bfa8-4820ebfef283","createdAt":1786942191006,"transform":{"position":[28,0.1300517932191143,76],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":27,"seed":421,"leafColor":5139258}},{"id":"fabfec85-67ba-4812-a4da-359a53a27693","createdAt":1786942191007,"transform":{"position":[-46,-0.09572763120817163,6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-rocks","options":{"count":8,"spread":11,"colors":[8221798,6249038,9340792],"seed":501}},{"id":"80e46f75-8912-4544-89c8-47967d9ceb62","createdAt":1786942191008,"transform":{"position":[48,-0.033393226680239696,2],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-rocks","options":{"count":7,"spread":10,"colors":[7038040,9077362,5656644],"seed":503}},{"id":"f0bf174f-02b3-486d-8660-bd2a935bbb29","createdAt":1786942191010,"transform":{"position":[-20,-0.11985580112539695,66],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"wildflowers","options":{"radius":8,"count":110,"seed":601}},{"id":"f4644b82-4bb3-48a7-bbea-fce1ad765b69","createdAt":1786942191011,"transform":{"position":[22,-0.008711513403761195,68],"