t":0.6,"mound":2.375,"seed":494}},{"id":"b8833562-077f-49a0-8aeb-8872ee62be0a","createdAt":1786942196532,"transform":{"position":[-5,4.6629367034256575e-15,-21],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-cave","options":{"width":17,"height":11,"mouth":5.5,"mouthHeight":6.5,"recess":5,"seed":43}},{"id":"31d01af9-f966-4e5b-a0db-78d7a9a44e7f","createdAt":1786942196533,"transform":{"position":[-5,4.6629367034256575e-15,-21],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"coral-garden","options":{"radius":8.5,"count":26,"height":1,"mound":10,"seed":44}},{"id":"584dacdf-4f6b-4fc8-8791-acbece09644c","createdAt":1786942196534,"transform":{"position":[-5,1.1000000000000045,-19.6],"rotation":[0,0.12,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moray-eel","options":{"length":8.5,"seed":11}},{"id":"4bb42ac4-9b90-44af-88d3-ed21e8740d23","createdAt":1786942196536,"transform":{"position":[-14,1.9984014443252818e-15,-9],"rotation":[0,0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Green moray eel","title":"Why its mouth never closes","body":"It is not snarling. A moray has no gill covers to pump water with, so it has to gape to breathe — that open mouth is the animal taking a breath, over and over, all day. This one is about 6 feet of the 8 it grows to; the rest is still down the hole."}},{"id":"0b696ec7-ad01-47ed-b1c8-e1703ebaf0a7","createdAt":1786942196537,"transform":{"position":[-21,1.5543122344752192e-15,-7],"rotation":[0,0.56,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"octopus","options":{"span":6.8,"seed":17}},{"id":"334272a6-1425-4235-a4e4-b29db8e07da9","createdAt":1786942196538,"transform":{"position":[-28,6.661338147750939e-16,-3],"rotation":[0,0.65,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Common octopus","title":"Nine brains and no bones","body":"Two thirds of its neurons are in the arms, so each one solves its own problems while the head thinks about something else. With no skeleton at all, an octopus this size — about 7 feet across — can pour itself through a hole the width of its own eye."}},{"id":"2a492bcf-dbfe-4a83-ac41-6b93593a1199","createdAt":1786942196539,"transform":{"position":[21,14.999401042864354,-25],"rotation":[0.08,-2.05,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-shark","options":{"length":8.5,"seed":5}},{"id":"b6236e1e-d240-4846-a202-5d45e2397942","createdAt":1786942196540,"transform":{"position":[-26,18.19521007508721,-60],"rotation":[-0.05,1.15,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-shark","options":{"length":7,"seed":23}},{"id":"80d60677-5d11-4e9c-82fa-f4ec865435a1","createdAt":1786942196542,"transform":{"position":[15,4.440892098500626e-16,-2],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Caribbean reef shark","title":"It cannot stop swimming","body":"Water has to keep moving over its gills, so it swims even while it sleeps — which is why the fins are always held out like wings. At 8 feet it is longer than a bed, and it eats fish. Divers on this reef swim with them every day."}},{"id":"da6a5e76-40d2-4e65-a303-c5e9479d2620","createdAt":1786942196543,"transform":{"position":[-7,-1.9984014443252818e-15,9],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"starfish","options":{"size":2.2,"color":13908268,"seed":23}},{"id":"a1995222-dcba-47d0-bc09-ca5b87527488","createdAt":1786942196544,"transform":{"position":[8,-6.661338147750939e-16,3],"rotation":[0,-1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"starfish","options":{"size":2,"color":4159688,"seed":29}},{"id":"2213204f-025f-41cb-93ee-8b7c59abac79","createdAt":1786942196545,"transform":{"position":[17,1.7763568394002505e-15,-8],"rotation":[0,2.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"starfish","options":{"size":1.6,"color":14715436,"seed":31}},{"id":"bac5ea6c-0bbd-4249-9279-76b1a5b9dd3e","createdAt":1786942196547,