5,0,-21],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"coral-garden","options":{"radius":10,"count":34,"height":1,"mound":6.5,"seed":44}},{"id":"27170e9a-8c5b-45c2-9c7d-c93a083a7a58","createdAt":1786991115922,"transform":{"position":[-5,1.1,-19.6],"rotation":[0,0.12,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moray-eel","options":{"length":8.5,"seed":11}},{"id":"bf63a969-ddf2-488e-94ef-6c987ca80a0b","createdAt":1786991115922,"transform":{"position":[-14,0,-9],"rotation":[0,0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Green moray eel","title":"Why its mouth never closes","body":"It is not snarling. A moray has no gill covers to pump water with, so it has to gape to breathe — that open mouth is the animal taking a breath, over and over, all day. This one is about 6 feet of the 8 it grows to; the rest is still down the hole."}},{"id":"764dd784-2a3a-45f4-855a-257ba0699a45","createdAt":1786991115922,"transform":{"position":[-21,0,-7],"rotation":[0,0.56,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"octopus","options":{"span":6.8,"seed":17}},{"id":"5702e40f-b3d2-49f6-b5ea-f93d3e40121d","createdAt":1786991115922,"transform":{"position":[-28,0,-3],"rotation":[0,0.65,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Common octopus","title":"Nine brains and no bones","body":"Two thirds of its neurons are in the arms, so each one solves its own problems while the head thinks about something else. With no skeleton at all, an octopus this size — about 7 feet across — can pour itself through a hole the width of its own eye."}},{"id":"ee3f0e42-be2e-44fb-9c60-ca19d343ff09","createdAt":1786991115922,"transform":{"position":[21,18,-25],"rotation":[0.08,-2.05,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-shark","options":{"length":8.5,"seed":5}},{"id":"4ec9f187-1c77-479e-aece-11b469cb9904","createdAt":1786991115922,"transform":{"position":[-26,20.200716773449503,-60],"rotation":[-0.05,1.15,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-shark","options":{"length":7,"seed":23}},{"id":"b58c7061-bc1b-4f0b-9691-18cff329f750","createdAt":1786991115922,"transform":{"position":[15,0,-2],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Caribbean reef shark","title":"It cannot stop swimming","body":"Water has to keep moving over its gills, so it swims even while it sleeps — which is why the fins are always held out like wings. At 8 feet it is longer than a bed, and it eats fish. Divers on this reef swim with them every day."}},{"id":"eb1530e1-a788-47ed-8415-b2aa909b5332","createdAt":1786991115922,"transform":{"position":[-7,0,9],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"starfish","options":{"size":2.2,"color":13908268,"seed":23}},{"id":"cd64eb67-6098-43ac-a1c7-8db817906483","createdAt":1786991115922,"transform":{"position":[8,0,3],"rotation":[0,-1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"starfish","options":{"size":2,"color":4159688,"seed":29}},{"id":"ea14a25a-8234-4b35-9af2-5b4835b248bc","createdAt":1786991115922,"transform":{"position":[17,0,-8],"rotation":[0,2.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"starfish","options":{"size":1.6,"color":14715436,"seed":31}},{"id":"f78270d0-1fb2-472b-bae8-24dd947ab222","createdAt":1786991115922,"transform":{"position":[-24,0,6],"rotation":[0,1.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"starfish","options":{"size":1.8,"color":12601990,"seed":37}},{"id":"0087929a-6d0a-4e9f-9478-f7d5c5bf6eb6","createdAt":1786991115922,"transform":{"position":[-14.5,0,13.5],"rotation":[0,0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Sea stars","title":"No head, no blood, no brain","body":"It walks on hundreds of tiny water-powered feet under each arm, and it pumps sea water instead of blood. Lose an arm and it grows another. Most reef sea stars are hand-sized; the sunflow