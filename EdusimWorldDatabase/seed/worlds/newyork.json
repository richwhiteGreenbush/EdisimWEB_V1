es":[{"text":"TWO TROUSER SUITS","size":0.28,"color":"#f7f1de"},{"text":"$38.50","size":0.36,"color":"#ffd766"}]}},{"id":"e5d2e9a9-b776-4146-be9a-ea03decb25d2","createdAt":1786942195603,"transform":{"position":[26.6,29.99999999999999,80],"rotation":[0,-1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"wall-sign","options":{"width":20,"height":6,"face":"#1d4a2e","lines":[{"text":"TIMES SQ. CAFETERIA","size":0.3,"color":"#f7f1de"},{"text":"OPEN ALL NIGHT","size":0.2,"color":"#ffd766"}]}},{"id":"fc6c21cb-a7ed-4961-9f0d-5911db8d3ab1","createdAt":1786942195604,"transform":{"position":[-24,0.5000000000000078,-67],"rotation":[0,0.12,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"world-portal","options":{"title":"THE LIBRARY","subtitle":"Back to the reading room — the billboard behind the building brings you here again","world":"library","accent":"#1f6b8a","width":11,"height":6.4,"postHeight":11.5}},{"id":"33860674-2fc8-46c7-b2d9-ff5647251f77","createdAt":1786942195605,"transform":{"position":[24,0.4999999999999991,4],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"At the curb","title":"Why the cabs are yellow","body":"A Chicago cab owner read a study saying yellow was the easiest colour to pick out at a distance, and painted his whole fleet. New York followed. This one is about 17 feet long — a foot longer than a modern taxi, and a foot taller."}},{"id":"3b0ff8ad-f619-40a4-b046-5ca53e46265b","createdAt":1786942195606,"transform":{"position":[-24,0.4999999999999911,40],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Look up","title":"The bishop's crook","body":"Cast iron, twenty-one feet to the curl, with the lamp hung out over the roadway so the light lands on the street and not on the sidewalk. New York put up thousands of them from the 1890s; a few hundred are still standing."}},{"id":"8257cca7-6388-4680-bd6c-1295fde437da","createdAt":1786942195608,"transform":{"position":[-24,0.5000000000000102,-78],"rotation":[0,0.15,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Straight ahead","title":"The BOND sign","body":"Two stone figures four storeys up, a lit disc between them, and letters you could read from six blocks away. Times Square was already the brightest place in America — the signs were lit in broad daylight, which is why they are lit here too."}},{"id":"b1d49792-f110-4457-ad95-4516200844ef","createdAt":1786942195609,"transform":{"position":[24,0.4999999999999911,72],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Summer 1949","title":"What is playing","body":"\"The Barkleys of Broadway\" put Fred Astaire and Ginger Rogers back together after ten years apart, and it was the only film they made in colour. Across the street, \"Home of the Brave\" had opened three weeks earlier."}},{"id":"2e9d4a04-fd49-44ec-b251-7706ea632b8d","createdAt":1786942195610,"transform":{"position":[24,0.49999999999999734,12],"rotation":[0,0.45,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Send the yellow cab down Broadway and back","target":"Click the taxi stopped in the road → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move forward 1 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move forward 1 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"The cab is facing you, so the FIRST leg is a plus. Turning it round does not change which way move Z pushes it — that is why the second loop uses minus one. Try wait 0.05 seconds inside a loop to slow it to a crawl.","accent":"#e0a022"}},{"id":"e9a3501e-660e-481e-b294-8053fac98c9a","createdAt":1786942195611,"transform":{"position":[-24,0.4999999999999942,26],"rotation":[0,-0.45,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Fill the avenue with cabs","target":"Click the taxi coming up the near lane → Program.","steps":[{"cat":"control","text":"repeat 3 times","depth":0},{"cat":"control","text":"duplicate 9 ft away","depth":1},{"cat":"control","text":"wait 0.5 seconds","depth":1}],"tip":"Duplicate always drops the copy to the EAST, so the rank marches across the road toward you. Each copy comes out a little further along, which is why three of them do not land in a heap. The copies do not duplicate themselves — that is on purpose.","accent":"#c1272d"}},{"id":"a7cdfc0d-92d3-4e8a-94d7-7813b93f52d6","createdAt":1786942195613,"transform":{"position":[24,0.49999999999999245,34],"rotation":[0,-0.3430239404207034,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"bd964f8f-1935-4772-859a-48aea6117e30","createdAt":1786942195614,"transform":{"position":[24,4.499999999999993,34],"rotation":[0,-0.3430239404207034,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"}]}