,1]},"kind":"preset-prop","prop":"wall-sign","options":{"width":20,"height":6.5,"face":"#14355e","lines":[{"text":"TWO TROUSER SUITS","size":0.28,"color":"#f7f1de"},{"text":"$38.50","size":0.36,"color":"#ffd766"}]}},{"id":"a00bace0-6290-496b-955e-e3b23c92fe10","createdAt":1786996225160,"transform":{"position":[26.6,30,80],"rotation":[0,-1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"wall-sign","options":{"width":20,"height":6,"face":"#1d4a2e","lines":[{"text":"TIMES SQ. CAFETERIA","size":0.3,"color":"#f7f1de"},{"text":"OPEN ALL NIGHT","size":0.2,"color":"#ffd766"}]}},{"id":"39f4aed4-2416-4459-921f-3262de571666","createdAt":1786996225160,"transform":{"position":[-24,0.5,-67],"rotation":[0,0.12,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"world-portal","options":{"title":"THE LIBRARY","subtitle":"Back to the reading room — the billboard behind the building brings you here again","world":"library","accent":"#1f6b8a","width":11,"height":6.4,"postHeight":11.5}},{"id":"d77d4560-79fe-498e-bb9e-9317c83ebb6a","createdAt":1786996225160,"transform":{"position":[24,0.5,4],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"At the curb","title":"Why the cabs are yellow","body":"A Chicago cab owner read a study saying yellow was the easiest colour to pick out at a distance, and painted his whole fleet. New York followed. This one is about 17 feet long — a foot longer than a modern taxi, and a foot taller."}},{"id":"24b6ce96-1b46-4b98-9170-6d8aef54aab4","createdAt":1786996225160,"transform":{"position":[-24,0.5,40],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Look up","title":"The bishop's crook","body":"Cast iron, twenty-one feet to the curl, with the lamp hung out over the roadway so the light lands on the street and not on the sidewalk. New York put up thousands of them from the 1890s; a few hundred are still standing."}},{"id":"853184b0-2d0c-4ecd-8209-d3bed74a96d6","createdAt":1786996225160,"transform":{"position":[-24,0.5,-78],"rotation":[0,0.15,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Straight ahead","title":"The BOND sign","body":"Two stone figures four storeys up, a lit disc between them, and letters you could read from six blocks away. Times Square was already the brightest place in America — the signs were lit in broad daylight, which is why they are lit here too."}},{"id":"6fc0a164-3e31-4ac5-b654-7190ae4b94ee","createdAt":1786996225160,"transform":{"position":[24,0.5,72],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Summer 1949","title":"What is playing","body":"\"The Barkleys of Broadway\" put Fred Astaire and Ginger Rogers back together after ten years apart, and it was the only film they made in colour. Across the street, \"Home of the Brave\" had opened three weeks earlier."}},{"id":"1091a52e-0fcb-40ce-8026-bc52a2f45944","createdAt":1786996225160,"transform":{"position":[24,0.5,12],"rotation":[0,0.45,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Send the yellow cab down Broadway and back","target":"Click the taxi stopped in the road → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move forward 1 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move forward 1 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Both loops say the same thing, because move forward follows whichever way the cab is pointing right now — and the rotate 180 in the middle is what turns it round. Try wait 0.05 seconds inside a loop to slow it to a crawl.","accent":"#e0a022"}},{"id":"9a34aa49-74c7-4fb9-8fc9-9c117cb3b0d3","createdAt":1786996225160,"transform":{"position":[-24,0.5,26],"rotation":[0,-0.45,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Fill the avenue with cabs","target":"Click the taxi coming up the near lane → Program.","steps":[{"cat":"control","text":"repeat 3 times","depth":0},{"cat":"control","text":"duplicate 9 ft away","depth":1},{"cat":"control","text":"wait 0.5 seconds","depth":1}],"tip":"Duplicate always drops the copy to the EAST, so the rank marches across the road toward you. Each copy comes out a little further along, which is why three of them do not land in a heap. The copies do not duplicate themselves — that is on purpose.","accent":"#c1272d"}},{"id":"f05e148b-2803-4c10-a76f-6ce6306ca134","createdAt":1786996225160,"transform":{"position":[24,0.5,34],"rotation":[0,-0.3430239404207034,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"8c0137ad-5cb2-4154-9daf-b1be0047ef34","createdAt":1786996225160,"transform":{"position":[24,4.5,34],"rotation":[0,-0.3430239404207034,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"}]}