44,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"WELCOME TO","lead":"SEATTLE CENTER","lines":["The 74 acres left behind by the 1962 World’s Fair.","Walk to the fountain, then on to the Space Needle."],"footnote":"Three coding challenges are at the Pacific Science Center, to the west."}},{"id":"19bbcdaf-22cd-4021-9ba8-56d092bc4de0","createdAt":1787017329783,"transform":{"position":[-22,0,-34],"rotation":[0,0.1257694207605277,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"The Space Needle","title":"605 feet, built in 400 days","body":"Raised for the 1962 fair and painted in four named colours: Astronaut White, Orbital Olive, Re-entry Red and Galaxy Gold. The roof went back to Galaxy Gold in 2012. Built here at one quarter size."}},{"id":"24edafaa-d5e3-49f2-8ee5-3bdf11a056a8","createdAt":1787017329783,"transform":{"position":[0,0,62],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"International Fountain","title":"A 220-foot bowl and 274 nozzles","body":"The silver dome throws water up to 120 feet, choreographed to music. Rebuilt in 1995 to let people walk right down into the basin. Built here at one third size."}},{"id":"42f5b292-3454-4f6f-a098-58ccae3c6602","createdAt":1787017329783,"transform":{"position":[58,0,30],"rotation":[0,-0.4852269925673362,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"The Monorail","title":"Still running the 1962 trains","body":"Alweg built two trains for the fair to carry people the mile to downtown in two minutes. They have run ever since — the oldest full-scale monorail still in daily service anywhere."}},{"id":"e78c4961-2189-4c62-a544-0002727538d5","createdAt":1787017329783,"transform":{"position":[40,0,-14],"rotation":[0,-0.2541247495556341,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Glass and pop culture","title":"Chihuly, and Gehry’s metal","body":"Dale Chihuly blows glass in colours paint cannot reach. Next door, Frank Gehry clad MoPOP in 21,000 shingles of gold, silver, purple, red and blue — and ran the monorail straight through it."}},{"id":"40deeb69-8afd-46d9-bd08-7fe5f2ac7675","createdAt":1787017329783,"transform":{"position":[-46,0.27450290353352713,108],"rotation":[0,0.9629943306809362,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["PACIFIC SCIENCE CENTER"],"subtitle":"Three coding challenges — head west past the arches"}},{"id":"01b81f44-be6c-4259-aa10-56b7d9f42317","createdAt":1787017329783,"transform":{"position":[8,0.3446644374002072,130],"rotation":[0,-0.6747409422235527,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"9bd7e112-34a2-4779-827c-4c8874db45a9","createdAt":1787017329783,"transform":{"position":[8,4.3446644374002075,130],"rotation":[0,-0.6747409422235527,0],"scale":[1,1,1]},"kind":"web-browser","url":"https://www.youtube-nocookie.com/embed/OMzEjtHOSnw"}]}