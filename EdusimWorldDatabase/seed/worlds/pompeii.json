9235,90],"rotation":[0,0.6202494859828215,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"546c9d77-4912-4a5b-869b-3c4e810ff77d","createdAt":1786942189036,"transform":{"position":[-10,3.3192612528800765,90],"rotation":[0,0.6202494859828215,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"ef96eda2-9585-47b6-bc72-21378b7f1c6d","createdAt":1786942189037,"transform":{"position":[-25,-0.23364965368806478,78],"rotation":[0,0.7657928325402437,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Raise the ash column","target":"Click the falling ash near the forum → Program.","steps":[{"cat":"control","text":"repeat 30 times","depth":0},{"cat":"motion","text":"move up by 1 feet","depth":1},{"cat":"look","text":"change size by 3 %","depth":1},{"cat":"control","text":"wait 0.1 seconds","depth":1}],"tip":"It rises and spreads at the same time, which is what a Plinian column does — up fast, then flat at the top where the air stops it climbing. The real one reached 21 miles in about an hour. Pliny the Younger watched it from across the bay and wrote the only eyewitness account we have.","accent":"#c2521f"}},{"id":"8e344787-ad56-44cd-bae9-5f2b28f87fc1","createdAt":1786942189039,"transform":{"position":[25,0.03944907341722814,76],"rotation":[0,-0.7288547264526309,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Send a cart up the street","target":"Click a stretch of paved street → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"move forward 40 feet","depth":1},{"cat":"control","text":"wait 3 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"motion","text":"move forward 40 feet","depth":1},{"cat":"control","text":"wait 3 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Look at the ruts worn into the basalt, and the raised stepping stones across the road. The gaps between the stones are exactly a cart axle wide — the street doubled as the drain, and you crossed it without stepping in it.","accent":"#9e3b28"}},{"id":"1c407337-227d-4692-a144-10d2b90600a3","createdAt":1786942189040,"transform":{"position":[-11,4.999999999999993,30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"ae5de098-0d72-43ca-9fb5-fdda1340dcd4","createdAt":1786942189041,"transform":{"position":[-34,8.999257580339846,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"fcc76095-8f6b-449b-b193-b59953dd6f89","createdAt":1786942189042,"transform":{"position":[34,8.999508759396429,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"fc8785b5-85a9-4c3b-85cc-86e4a971bcae","createdAt":1786942189043,"transform":{"position":[-46,3.8671989983668675,27],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}