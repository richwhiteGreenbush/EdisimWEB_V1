1786940865632,"transform":{"position":[87.37383539249431,0.09848559204029772,-63.48080724758712],"rotation":[0,-0.9424777960769377,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"membrane-wall","options":{"span":72,"height":17,"curve":0.16,"seed":18}},{"id":"7152b06e-dcaa-449c-a6a5-f6c8c67acc62","createdAt":1786940865634,"transform":{"position":[0,7.549516567451064e-15,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cell-nucleus","options":{"radius":25,"pores":30,"seed":3}},{"id":"2ae061cb-d0cb-4b6f-adf7-686920b381b4","createdAt":1786940865635,"transform":{"position":[23,7.000000000000002,-8],"rotation":[0,-0.27346098709024436,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Nucleus","realSize":"really about 6 µm across","job":"Holds the DNA · controls the cell","width":13,"accent":"#c79ae8"}},{"id":"f442e407-7306-43c0-a581-c533322f50e9","createdAt":1786940865636,"transform":{"position":[-13,8.881784197001251e-16,-4],"rotation":[0,0.16514867741462683,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"The nucleus","body":"The biggest thing in the cell and the one in charge. The purple shell is a DOUBLE membrane — look for the gold rings, which are nuclear pores: the doorways that let messages out to the ribosomes. The dark ball inside is the nucleolus, where ribosomes are built. The loose pink threads are chromatin — not neat X-shaped chromosomes, because those only exist while a cell is dividing."}},{"id":"ee973a69-aaff-48e5-853b-bdaec3c08fd9","createdAt":1786940865638,"transform":{"position":[-46,-1.7763568394002505e-15,8],"rotation":[0,0.6086893073274118,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mitochondrion","options":{"length":34,"radius":7.5,"cristae":12,"seed":8}},{"id":"7b2721dc-aba1-47a2-b077-3535146168c0","createdAt":1786940865639,"transform":{"position":[-26,5,-2],"rotation":[0,0.3296244074207427,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Mitochondrion","realSize":"really about 2 µm long","job":"Releases energy from food","width":12,"accent":"#f2a05c"}},{"id":"ac74c847-5566-4a9e-9f21-79197f07d164","createdAt":1786940865640,"transform":{"position":[-34,-5.329070518200751e-15,24],"rotation":[0,0.5971766580926776,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"The powerhouse","body":"It is cut open lengthwise so you can see the folds. Those folds are called cristae, and they are the point: folding the inner membrane back and forth packs an enormous surface area into a tiny space, and that surface is where energy is actually released. A muscle cell has thousands of these. A skin cell has far fewer."}},{"id":"25309510-c825-4051-8c93-d9c38834e647","createdAt":1786940865641,"transform":{"position":[-62,4.884981308350689e-15,-22],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mitochondrion","options":{"length":26,"radius":6,"cristae":9,"seed":14}},{"id":"04998be1-c08b-4c34-a6c6-b09adc4d62a5","createdAt":1786940865643,"transform":{"position":[40,3.9968028886505635e-15,-18],"rotation":[0,-1.9513027039072617,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"rough-er","options":{"width":30,"depth":18,"sheets":5,"seed":12}},{"id":"5ad6fa61-b811-4aa6-ac6b-93a41f4bc6af","createdAt":1786940865644,"transform":{"position":[62,5.000000000000005,-22],"rotation":[0,-0.573440526154829,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Rough ER","realSize":"sheets about 50 nm thick","job":"Builds and folds proteins","width":12,"accent":"#6f9ee0"}},{"id":"81341ae6-62f7-47a2-813d-2aebb9da80c8","createdAt":1786940865645,"transform":{"position":[28,-8.881784197001252e-16,4],"rotation":[0,-0.3805063771123649,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Why \"rough\"?","body":"The blue beads all over it. Each one is a ribosome — the machine that reads the instructions from the nucleus and builds a protein from them. Nothing else makes it rough. Notice the sheets run right up to the nucleus: the rough ER is joined to the nuclear envelope, so a message has almost no distance to travel."}},{"id":"e31eefef-6506-48fa-b114-04b99d46db8c","createdAt":1786940865647,"transform":{"position":[62,-1.3322676295501878e-15,6],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"smooth-er","options":{"extent":14,"strands":9,"seed":21}},{"id":"e2427e3b-0037-43d7-a0e5-34ab53d0d933","createdAt":1786940865648,"transform":{"position":[80,3.9999999999999964,16],"rotation":[0,-0.943488134519134,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Smooth ER","realSize":"tubes about 60 nm across","job":"Makes fats · no ribosomes","width":10,"accent":"#d9c07a"}},{"id":"7a5dd581-77b5-4b78-b5a9-d1468ab5e566","createdAt":1786940865649,"transform":{"position":[34,-7.549516567451064e-15,34],"rotation":[0,-0.7044940642422177,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"golgi-body","options":{"width":24,"sacs":6,"seed":17}},{"id":"ed8fda9e-449b-4dcf-8952-6a6acb7a1ae8","createdAt":1786940865651,"transform":{"position":[54,3.999999999999991,40],"rotation":[0,-1.0088747645380813,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Golgi Body","realSize":"really about 1.5 µm wide","job":"Packs and ships proteins","width":12,"accent":"#5fd0cf"}},{"id":"4c1557c2-08ed-47c4-ab11-d1dc752fd849","createdAt":1786940865652,"transform":{"position":[21,-9.769962616701378e-15,44],"rotation":[0,-0.6107259643892086,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"The post office","body":"Proteins arrive from the ER at the bottom of the stack, get finished and labelled as they move up it, and leave from the top wrapped in a bubble — one of the little green vesicles pinching off the edges. The stack is curved, always; that dish shape is how you tell a Golgi from anything else in a picture."}},{"id":"aa287689-bb46-44ea-b588-39697c1c2dc6","createdAt":1786940865653,"transform":{"position":[-30,-4.440892098500626e-15,52],"rotation":[0,0.9380474917927134,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"membrane-panel","options":{"width":32,"height":14,"columns":28,"seed":5}},{"id":"b2eda388-59f0-4d1f-a0e8-7c4f0069f549","createdAt":1786940865655,"transform":{"position":[-50,3.999999999999994,60],"rotation":[0,1.297787623708186,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Cell Membrane","realSize":"really about 8 nm thick","job":"Decides what gets in and out","width":13,"accent":"#f0d68c"}},{"id":"47daaf8c-4ff7-4890-994d-408c7a65be43","createdAt":1786940865656,"transform":{"position":[-46,-5.329070518200751e-15,56],"rotation":[0,1.1978086049948355,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Two layers, tails inward","body":"This is a slice through the wall you can see curving away all around you, blown up much larger again. Every gold ball is the water-loving head of one phospholipid and the two strands under it are its water-hating tails — which is why they point at each other in the middle. The blue barrels are channel proteins: the doors. Nothing crosses this wall by accident."}},{"id":"ef1dd5c9-ed23-4529-bfc4-c6245a7f2062","createdAt":1786940865657,"transform":{"position":[56,8.881784197001252e-15,-40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"lysosome","options":{"radius":5,"seed":30}},{"id":"067a83eb-9c6a-4c03-9d6d-25b8f792992d","createdAt":1786940865659,"transform":{"position":[-18,5.329070518200751e-15,-56],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"lysosome","options":{"radius":4,"seed":31}},{"id":"f057c15d-3a05-4660-9f77-d2500455cf92","createdAt":1786940865660,"transform":{"position":[-74,-8.881784197001252e-16,4],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"lysosome","options":{"radius":4.4,"seed":32}},{"id":"fd47a6b1-eef3-4d8d-89d9-93246fdce9fa","createdAt":1786940865661,"transform":{"position":[8,-9.769962616701378e-15,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"transport-vesicle","options":{"radius":2.2,"cargo":6,"seed":42}},{"id":"3bc44c47-3bb8-4289-907d-31e358604819","createdAt":1786940865663,"transform":{"position":[-6,-3.9968028886505635e-15,50],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"transport-vesicle","options":{"radius":1.9,"cargo":6,"seed":43}},{"id":"fe9104ac-0af2-4394-9c02-29013df56f42","createdAt":1786940865664,"transform":{"position":[-44,-7.549516567451064e-15,34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"transport-vesicle","options":{"radius":2.4,"cargo":6,"seed":44}},{"id":"0de06c02-e879-4662-bfe0-e0343785e6ab","createdAt":1786940865665,"transform":{"position":[46,-3.1086244689504383e-15,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"transport-vesicle","options":{"radius":2,"cargo":6,"seed":45}},{"id":"d7863963-ed16-4ca4-bec0-79e67ef7105c","createdAt":1786940865666,"transform":{"position":[-64,1.7763568394002505e-15,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"transport-vesicle","options":{"radius":2.2,"cargo":6,"seed":46}},{"id":"7e9dfb1b-92cb-4a0f-87f7-8461fd11deb6","createdAt":1786940865668,"transform":{"position":[72,3.000000000000008,-36],"rotation":[0,-0.5795639852933231,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Lysosome","realSize":"about 0.5 µm","job":"Digests worn-out parts","width":9,"accent":"#e88ab8"}},{"id":"55593cbc-5d52-474e-8ebd-27c5e0610451","createdAt":1786940865669,"transform":{"position":[-66,-8.881784197001252e-15,40],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"centriole-pair","options":{"length":8,"radius":2.6}},{"id":"42c661ee-fea6-4a47-ae72-048f7e5c8dd2","createdAt":1786940865670,"transform":{"position":[-82,2.9954122293519814,46],"rotation":[0,1.2417466319545571,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Centrioles","realSize":"about 0.5 µm long","job":"Pull chromosomes apart","width":10,"accent":"#b9c6d6"}},{"id":"c2ac3c14-7b4f-4ce2-9c10-1ce5ad2b464a","createdAt":1786940865672,"transform":{"position":[-78,-0.00009227421917357148,46],"rotation":[0,1.2261490111768705,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Nine sets of three","body":"Count the tubes around one barrel: nine groups of three, every time, in every animal cell anybody has ever looked at. The two barrels sit at right angles to each other. When the cell divides, these move to opposite ends and haul the chromosomes apart."}},{"id":"c5385454-6883-4a58-bb5c-db8b98d5c8e8","createdAt":1786940865673,"transform":{"position":[52,-8.881784197001252e-15,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"free-ribosome","options":{"radius":1.8}},{"id":"86f81960-903f-40f1-8346-00aed117e4d1","createdAt":1786940865674,"transform":{"position":[57,-9.769962616701378e-15,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"free-ribosome","options":{"radius":1.5}},{"id":"703f2248-d005-46d1-874e-93e8709ccbb9","createdAt":1786940865676,"transform":{"position":[48,-9.992007221626409e-15,45],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"free-ribosome","options":{"radius":1.8}},{"id":"41d84528-d093-46e6-ae24-0edf92781278","createdAt":1786940865677,"transform":{"position":[-52,9.769962616701378e-15,-44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"free-ribosome","options":{"radius":1.5}},{"id":"a1dfabb9-3dff-4b18-b42f-4971461bc071","createdAt":1786940865678,"transform":{"position":[24,5.329070518200751e-15,-56],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"free-ribosome","options":{"radius":1.8}},{"id":"786b1250-405d-49a0-a77e-e73ee409257c","createdAt":1786940865680,"transform":{"position":[66,3.9999999999999916,38],"rotation":[0,-1.0714496051147666,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organelle-tag","options":{"name":"Free Ribosomes","realSize":"really 25 nm — shown much bigger","job":"Build proteins loose in the cytosol","width":12,"accent":"#6f9ee0"}},{"id":"105d483c-e96a-434c-b617-72e96d766582","createdAt":1786940865681,"transform":{"position":[-34,-2.6645352591003757e-15,12],"rotation":[0,0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cytoskeleton-strand","options":{"length":46,"radius":0.22,"seed":55}},{"id":"8a384e1d-91a1-46da-af61-fcb8250ecf3d","createdAt":1786940865682,"transform":{"position":[40,1.3322676295501878e-15,-6],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cytoskeleton-strand","options":{"length":46,"radius":0.22,"seed":56}},{"id":"66ecd9cd-a7c6-4433-89fd-475a0c128872","createdAt":1786940865684,"transform":{"position":[-46,7.549516567451064e-15,-34],"rotation":[0,1.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cytoskeleton-strand","options":{"length":46,"radius":0.22,"seed":57}},{"id":"2aded3b0-a1bc-420d-9966-3ccd3978c164","createdAt":1786940865685,"transform":{"position":[58,-4.884981308350689e-15,22],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cytoskeleton-strand","options":{"length":46,"radius":0.22,"seed":58}},{"id":"55208c47-0c07-42a6-9f55-fe249b1c69fb","createdAt":1786940865686,"transform":{"position":[8,7.105427357601002e-15,-64],"rotation":[0,1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cytoskeleton-strand","options":{"length":46,"radius":0.22,"seed":59}},{"id":"7dbc1bd7-6169-4443-a8dc-84487a40aebc","createdAt":1786940865687,"transform":{"position":[20,-8.881784197001252e-15,40],"rotation":[0,-1.3352513460740334,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"transport-vesicle","options":{"radius":3,"cargo":8,"seed":41}},{"id":"92b18aa6-2ee6-4df4-83f8-240e109fb5d3","createdAt":1786940865689,"transform":{"position":[-22,-4.884981308350689e-15,54],"rotation":[0,0.8329812666744317,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Ship the protein out","target":"the green transport vesicle by the Golgi","steps":[{"cat":"control","text":"repeat 12 times","depth":0},{"cat":"motion","text":"move forward 4 feet","depth":1},{"cat":"control","text":"wait 0.3 seconds","depth":1},{"cat":"look","text":"change size by -4 %","depth":1}],"tip":"It is already pointing at the cell membrane, so it travels the real route a finished protein takes: Golgi → vesicle → wall. Shrinking as it goes is what happens when it fuses and empties.","accent":"#2f9c8f"}},{"id":"f3cb4efd-c0f1-45ca-9539-7ba5fe182aba","createdAt":1786940865690,"transform":{"position":[24,-4.884981308350689e-15,54],"rotation":[0,-0.8760580505981934,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Make the powerhouse pulse","target":"the big orange mitochondrion","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"look","text":"change size by 6 %","depth":1},{"cat":"control","text":"wait 0.4 seconds","depth":1},{"cat":"look","text":"change size by -6 %","depth":1},{"cat":"control","text":"wait 0.4 seconds","depth":1}],"tip":"Mitochondria really do change shape — they stretch, split and join up all day. Change the 6 to 20 and watch it get out of hand.","accent":"#d4633c"}},{"id":"81704005-5dd2-418a-8f3e-a20c422328ae","createdAt":1786940865691,"transform":{"position":[0,9.000000000000004,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"066e19ef-0d04-4e87-99a6-02269f15d03c","createdAt":1786940865693,"transform":{"position":[-44,7.999999999999997,12],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"dffb9bcf-3664-4faa-b87a-290b4b149c97","createdAt":1786940865694,"transform":{"position":[38,8.000000000000004,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"557bff7a-f370-4f25-9fe2-3c8