{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T04:27:45.697Z","records":[{"id":"3d51c536-8af2-4fb4-9470-df2c69a08428","kind":"world-theme","theme":"cell","createdAt":1786940865615,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"86acadf5-ed07-4003-aba0-a48cdcf04530","createdAt":1786940865617,"transform":{"position":[0,-3.9968028886505635e-15,50],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"🔬  INSIDE AN ANIMAL CELL","lead":"You have been shrunk about six million times.","lines":["Five organelles, all to scale.","The nucleus is straight ahead."],"footnote":"The whole cell would be a fifth the width of a human hair"}},{"id":"14204634-d428-4e4a-999b-e6cc34aaa5c1","createdAt":1786940865618,"transform":{"position":[9,-7.105427357601002e-15,64],"rotation":[0,-0.7328151017865066,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"aa48a82f-eeee-4f59-9d51-ea581a2fd839","createdAt":1786940865619,"transform":{"position":[9,3.999999999999993,64],"rotation":[0,-0.7328151017865066,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"e31b4dd5-87c7-4d8c-a46a-6a58df872761","createdAt":1786940865621,"transform":{"position":[108,0.14241028102700426,0],"rotation":[0,-1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"membrane-wall","options":{"span":72,"height":17,"curve":0.16,"seed":9}},{"id":"59573f44-01a5-47c3-89b2-5be364dbb54a","createdAt":1786940865622,"transform":{"position":[87.37383539249433,0.0777797248036266,63.4808072475871],"rotation":[0,-2.199114857512855,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"membrane-wall","options":{"span":72,"height":17,"curve":0.16,"seed":10}},{"id":"ab5c0148-8628-4f1c-abcd-0404ff8f5437","createdAt":1786940865623,"transform":{"position":[33.37383539249433,0.12413651501512953,102.71410375987658],"rotation":[0,-2.827433388230814,0],"scale":[1,1,1]},"kind":"pres