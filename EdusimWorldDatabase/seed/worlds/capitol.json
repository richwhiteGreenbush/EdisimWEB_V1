{"format":"edusim-world","version":1,"exportedAt":"2026-08-16T22:56:37.108Z","label":"The U.S. Capitol","spawn":{"x":0,"z":150,"yaw":0},"records":[{"id":"799efae6-e0c1-472f-b6b5-78d8d3bcbc53","kind":"world-theme","theme":"capitol","createdAt":1786920997021,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"9e33b1ae-127b-46d8-ad47-f45fe5424550","createdAt":1786920997022,"transform":{"position":[0,4.884981308350689e-15,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"capitol-building","options":{"centreWidth":48,"wingWidth":42,"depth":36,"height":26,"seed":7}},{"id":"ed67905f-0336-4987-97d2-c7a695b05146","createdAt":1786920997023,"transform":{"position":[0,29.000000000000004,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"capitol-dome","options":{"drumRadius":15,"seed":3}},{"id":"0b08f894-1109-4814-aff0-49783f193eb2","createdAt":1786920997025,"transform":{"position":[-30,-4.440892098500626e-15,52],"rotation":[0,0.2970642123410428,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Finished during the Civil War","title":"The dome","accent":"#8a8578","body":"Nearly nine million pounds of cast iron, built in rings and bolted together. Lincoln insisted the work continue through the war — \"if people see the Capitol going on, it is a sign we intend the Union shall go on\". It is not a hemisphere: it is markedly taller than it is wide, which is what separates it from every state house that copied it."}},{"id":"797ec6cf-64ee-49f8-9f3b-1b1d70ca52f6","createdAt":1786920997026,"transform":{"position":[30,-4.440892098500626e-15,52],"rotation":[0,-0.2970642123410428,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"On top, 19ft of bronze","title":"The Statue of Freedom","accent":"#6e6a52","body":"She wears a feathered helmet, not a liberty cap. Jefferson Davis — then Secretary of War, later president of the Confederacy — objected to the cap because it was the Roman symbol of a freed slave, and had it changed. The statue was cast by Philip Reid, who was himself enslaved."}},{"id":"29d1b3b2-0ed2-47f8-8a70-0018b99a4ba7","createdAt":1786920997028,"transform":{"position":[0,-1.021405182655144e-14,78],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reflecting-pool","options":{"length":84,"width":24,"seed":17}},{"id":"fe25cea4-bec7-46a5-b58f-271cae4d0443","createdAt":1786920997030,"transform":{"position":[-120,-0.44924182963352166,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"washington-monument","options":{"height":96,"seed":13}},{"id":"20c0625a-3952-4230-99a1-3d437ccb8145","createdAt":1786920997031,"transform":{"position":[-74,0.04268180749677786,92],"rotation":[0,0.906021831977551,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Look two thirds of the way up","title":"The Washington Monument","accent":"#d2cec2","body":"The stone changes colour, and you can see the line from a mile off. Building stopped in 1854 when the money ran out, the Civil War came, and it stood as a stump for 23 years. When they finished it in 1884 the original quarry was gone and no other marble matched."}},{"id":"f40112ec-9010-43dd-ac4a-d14cff03b318","createdAt":1786920997032,"transform":{"position":[-56,-4.884981308350689e-15,22],"rotation":[0,0.4124104415973873,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"chamber-desks","options":{"rows":5,"seed":19}},{"id":"17ed2ac5-76ac-48eb-ad8c-eb77807b4bac","createdAt":1786920997034,"transform":{"position":[-40,-7.549516567451064e-15,34],"rotation":[0,0.3320594675428855,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"A cutaway of the chamber","title":"435 and 100","accent":"#6b4a2c","body":"The House has 435 voting members and the Senate 100 — two per state regardless of size, which is why Wyoming and California have the same Senate power. The desks face a rostrum, and members of the two parties sit on opposite sides of the centre aisle."}},{"id":"76095852-e1cb-4e4e-b49b-94a9e8d926b4","createdAt":1786920997036,"transform":{"position":[-24,-6.661338147750939e-15,30],"rotation":[0,0.19739555984988078,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":9,"seed":60,"robe":true}},{"id":"0db174a9-5eff-4d23-abf4-8ed514032d19","createdAt":1786920997037,"transform":{"position":[24,-6.661338147750939e-15,30],"rotation":[0,-0.19739555984988078,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":10,"seed":65,"robe":false}},{"id":"08c82a9c-4269-412c-8639-ed611f76b10a","createdAt":1786920997038,"transform":{"position":[-34,-1.7763568394002505e-15,8],"rotation":[0,0.23501221572065706,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":9,"seed":70,"robe":true}},{"id":"948f0497-7c8d-4d47-ba49-7ee8b92b057f","createdAt":1786920997040,"transform":{"position":[34,-1.7763568394002505e-15,8],"rotation":[0,-0.23501221572065706,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":10,"seed":75,"robe":false}},{"id":"8f1ac576-6a93-4ece-81be-f0ff6e61f369","createdAt":1786920997041,"transform":{"position":[-24,8.881784197001251e-16,-4],"rotation":[0,0.15460054543120083,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":9,"seed":80,"robe":true}},{"id":"9936765b-433e-47ee-aa2d-cf9c9e666092","createdAt":1786920997043,"transform":{"position":[24,8.881784197001251e-16,-4],"rotation":[0,-0.15460054543120083,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":10,"seed":85,"robe":false}},{"id":"b12c2d40-9aea-4448-8781-9ac9e559a2b7","createdAt":1786920997044,"transform":{"position":[40,-7.549516567451064e-15,34],"rotation":[0,-0.3320594675428855,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Two from every state","title":"Statuary Hall","accent":"#6e6a52","body":"Each state chooses two people to stand in the Capitol, and can swap them. States have been changing theirs — several have replaced Confederate figures since 2020. Who a place decides to put on a plinth is a live argument, not settled history."}},{"id":"ba0d7552-0b60-433d-8c82-5692b0b4817e","createdAt":1786920997046,"transform":{"position":[-18,-8.881784197001252e-15,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flag-pole","options":{"height":28,"seed":29}},{"id":"ffcbaa67-e64b-471a-a68f-3f47e8dad540","createdAt":1786920997047,"transform":{"position":[18,-8.881784197001252e-15,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flag-pole","options":{"height":28,"seed":31}},{"id":"7e74eb99-9485-4e9d-8ffa-3821f93b33a9","createdAt":1786920997049,"transform":{"position":[-46,0.09685031370584607,116],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":24,"seed":300,"leafColor":5143098}},{"id":"07289318-81e5-4b10-b649-2e050f6e10ca","createdAt":1786920997050,"transform":{"position":[46,0.14455852180483486,116],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":27,"seed":320,"leafColor":5143098}},{"id":"bd9fea77-bfd8-4fea-8d54-67caf3789ab2","createdAt":1786920997052,"transform":{"position":[-46,0.011707749151071312,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":27,"seed":307,"leafColor":5143098}},{"id":"ec15dd36-6dcf-4249-b72f-65e7cfa4a8c9","createdAt":1786920997054,"transform":{"position":[46,0.05954228011878371,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":30,"seed":327,"leafColor":5143098}},{"id":"538b2fc6-9832-44d2-9681-d0104dcc86a3","createdAt":1786920997055,"transform":{"position":[-46,-9.769962616701378e-15,76],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":30,"se