":[1,1,1]},"kind":"preset-prop","prop":"planter","options":{"size":3.6}},{"id":"4ab6bbeb-0407-40b3-956e-5e194662cb16","createdAt":1786942189980,"transform":{"position":[20,0.0807070133949579,122],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planter","options":{"size":3.6}},{"id":"513f79d8-603a-4321-b239-440320ff29bb","createdAt":1786942189981,"transform":{"position":[-12,-9.769962616701378e-15,44],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flower-bed","options":{"width":11,"depth":5,"seed":601}},{"id":"e0a8ba93-abe2-4168-a45d-19db2232fe45","createdAt":1786942189982,"transform":{"position":[12,-9.769962616701378e-15,44],"rotation":[0,-0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flower-bed","options":{"width":11,"depth":5,"seed":603}},{"id":"d9983e9e-b2fa-4227-a399-4e47ca79cad2","createdAt":1786942189983,"transform":{"position":[22,0.1663817389245401,138],"rotation":[0,-1.0714496051147666,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE U.S. CAPITOL"],"subtitle":"The West Front, from the Mall","width":15,"height":4.2}},{"id":"4e004c73-0be8-4913-a9c0-43a05a02d693","createdAt":1786942189985,"transform":{"position":[-11,0.09746910605733738,136],"rotation":[0,0.6659692373791098,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"7eb12516-9e68-4467-9eea-8467a2b9af6a","createdAt":1786942189986,"transform":{"position":[-11,4.097469106057337,136],"rotation":[0,0.6659692373791098,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"95b140e5-5b65-4bd7-9ad9-df22ec3b46b7","createdAt":1786942189987,"transform":{"position":[-26,-0.007078959292456943,128],"rotation":[0,0.8685393952858895,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Raise the dome into place","target":"Click the dome (not the building) → Program.","steps":[{"cat":"motion","text":"move up by 30 feet","depth":0},{"cat":"control","text":"repeat 24 times","depth":0},{"cat":"motion","text":"move up by -1.5 feet","depth":1},{"cat":"control","text":"wait 0.12 seconds","depth":1},{"cat":"look","text":"say the union shall go on","depth":0}],"tip":"Lift it clear, then lower it onto the building a foot and a half at a time. The real dome went up in cast-iron rings hoisted by a derrick standing inside it, right through the Civil War — Lincoln insisted the work carry on. The dome and the building are separate objects here, which is why you can move one without the other.","accent":"#8a8578"}},{"id":"d98b72ab-53d7-45a2-b04d-d0d836896cd6","createdAt":1786942189989,"transform":{"position":[26,0.12344201552337353,128],"rotation":[0,-0.8685393952858895,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Send a statue on tour","target":"Click any bronze statue → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"move forward 16 feet","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"motion","text":"move forward 16 feet","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"States really do swap theirs — several have been replaced in the last few years. Try changing the colour too: these are bronze, and bronze goes green outdoors, which is exactly what happened to the Statue of Liberty.","accent":"#6e6a52"}},{"id":"0bde6462-e817-43f0-8289-62c4789e45a8","createdAt":1786942189990,"transform":{"position":[0,10,4],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"5e9b3d8e-bb6e-48b9-bea4-c7d5feb7d4fe","createdAt":1786942189991,"transform":{"position":[-56,6.999999999999995,22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"90a41711-c056-4139-ada1-4b2e6ae5c2a2","createdAt":1786942189992,"transform":{"position":[0,46.00000000000001,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}