th":1}],"tip":"The real dome went up in cast-iron rings hoisted by a steam derrick standing inside it, all through the Civil War. The dome and the building are two separate objects here, which is why you can move one without the other.","accent":"#8a8578"}},{"id":"f6f23e0c-edea-40cc-9817-ff79cbd386e2","createdAt":1786920997104,"transform":{"position":[26,0.12344201552337353,128],"rotation":[0,-0.8685393952858895,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Send a statue on tour","target":"Click any bronze statue → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"move X by 16 ft","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"motion","text":"move X by 16 ft","depth":1},{"cat":"control","text":"wait 2 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"States really do swap theirs — several have been replaced in the last few years. Try changing the colour too: these are bronze, and bronze goes green outdoors, which is exactly what happened to the Statue of Liberty.","accent":"#6e6a52"}},{"id":"76270316-4abe-4a19-9a98-ec53282f5033","createdAt":1786920997105,"transform":{"position":[0,10,4],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"f07e7dc2-267b-4067-a8cd-4ad07a26a158","createdAt":1786920997107,"transform":{"position":[-56,6.999999999999995,22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"63a88288-716b-42bf-b190-7285b0ef1cd8","createdAt":1786920997108,"transform":{"position":[0,46.00000000000001,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}