{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T04:49:49.992Z","records":[{"id":"e61ccbc5-7f31-4cd8-b1c5-77b989754fb2","kind":"world-theme","theme":"capitol","createdAt":1786942189918,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"3f83578d-ba02-4fca-b634-6bffccb08275","kind":"world-spawn","createdAt":1786942189918,"transform":{"position":[0,0,150],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"c7444842-ea2d-4941-94cc-f9e246725908","createdAt":1786942189919,"transform":{"position":[0,4.884981308350689e-15,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"capitol-building","options":{"centreWidth":48,"wingWidth":42,"depth":36,"height":26,"seed":7}},{"id":"6a4a0e84-7745-4a56-999f-34398ae5f163","createdAt":1786942189921,"transform":{"position":[0,29.000000000000004,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"capitol-dome","options":{"drumRadius":15,"seed":3}},{"id":"088538b4-e6ab-4997-bb85-b0729a4ee9f1","createdAt":1786942189922,"transform":{"position":[-30,-4.440892098500626e-15,52],"rotation":[0,0.2970642123410428,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Finished during the Civil War","title":"The dome","accent":"#8a8578","body":"Nearly nine million pounds of cast iron, built in rings and bolted together. Lincoln insisted the work continue through the war — \"if people see the Capitol going on, it is a sign we intend the Union shall go on\". It is not a hemisphere: it is markedly taller than it is wide, which is what separates it from every state house that copied it."}},{"id":"41c49bef-d97f-430a-a3ea-7b3a1fc001e5","createdAt":1786942189924,"transform":{"position":[30,-4.440892098500626e-15,52],"rotation":[0,-0.2970642123410428,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"On top, 19ft of bronze","title":"The Statue of Freedom","accent":"#6e6a52","body":"She wears a feathered helmet, not a liberty cap. Jefferson Davis — then Secretary of War, later president of the Confederacy — objected to the cap because it was the Roman symbol of a freed slave, and had it changed. The statue was cast by Philip Reid, who was himself enslaved."}},{"id":"c5a27f6a-81b7-419c-84c4-1d40fa217da5","createdAt":1786942189925,"transform":{"position":[0,-1.021405182655144e-14,78],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reflecting-pool","options":{"length":84,"width":24,"seed":17}},{"id":"78a8c6d2-34ca-4a88-a783-6d02b67a88c5","createdAt":1786942189926,"transform":{"position":[-120,-0.44924182963352166,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"washington-monument","options":{"height":96,"seed":13}},{"id":"f06b07b7-bffa-432b-888c-905651df63d7","createdAt":1786942189928,"transform":{"position":[-74,0.04268180749677786,92],"rotation":[0,0.906021831977551,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Look two thirds of the way up","title":"The Washington Monument","accent":"#d2cec2","body":"The stone changes colour, and you can see the line from a mile off. Building stopped in 1854 when the money ran out, the Civil War came, and it stood as a stump for 23 years. When they finished it in 1884 the original quarry was gone and no other marble matched."}},{"id":"bea3af38-6a87-42b6-b760-f504900e94c7","createdAt":1786942189929,"transform":{"position":[-56,-4.884981308350689e-15,22],"rotation":[0,0.4124104415973873,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"chamber-desks","options":{"rows":5,"seed":19}},{"id":"0460c412-1ff4-4634-b7d5-b4ef72ad4415","createdAt":1786942189930,"transform":{"position":[-40,-7.549516567451064e-15,34],"rotation":[0,0.3320594675428855,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"A cutaway of the chamber","title":"435 and 100","accent":"#6b4a2c","body":"The House has 435 voting members and the Senate 100 — two per state regardless of size, which is why Wyoming and California have the same Senate power. The desks face a rostrum, and members of the two parties sit on opposite sides of the centre aisle."}},{"id":"9fd89ec9-715c-4f7b-b40e-047fa4fee976","createdAt":1786942189932,"transform":{"position":[-24,-6.661338147750939e-15,30],"rotation":[0,0.19739555984988078,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":9,"seed":60,"robe":true}},{"id":"5462116d-2677-4dab-98dc-0ed79f977ada","createdAt":1786942189933,"transform":{"position":[24,-6.661338147750939e-15,30],"rotation":[0,-0.19739555984988078,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":10,"seed":65,"robe":false}},{"id":"d0cbca7b-243a-4396-afa5-34a1f6221905","createdAt":1786942189934,"transform":{"position":[-34,-1.7763568394002505e-15,8],"rotation":[0,0.23501221572065706,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":9,"seed":70,"robe":true}},{"id":"2d51f90b-5e6e-4e97-9c02-2f7b5918a8a1","createdAt":1786942189935,"transform":{"position":[34,-1.7763568394002505e-15,8],"rotation":[0,-0.23501221572065706,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":10,"seed":75,"robe":false}},{"id":"5813f7bb-8a98-4c10-8117-2f542966e6a0","createdAt":1786942189936,"transform":{"position":[-24,8.881784197001251e-16,-4],"rotation":[0,0.15460054543120083,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":9,"seed":80,"robe":true}},{"id":"8aa94a79-2d7e-4bcf-a997-3179aa0b2a23","createdAt":1786942189938,"transform":{"position":[24,8.881784197001251e-16,-4],"rotation":[0,-0.15460054543120083,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"statuary-figure","options":{"height":10,"seed":85,"robe":false}},{"id":"88b93469-9c6c-4e75-98dc-a159db163168","createdAt":1786942189939,"transform":{"position":[40,-7.549516567451064e-15,34],"rotation":[0,-0.3320594675428855,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Two from every state","title":"Statuary Hall","accent":"#6e6a52","body":"Each state chooses two people to stand in the Capitol, and can swap them. States have been changing theirs — several have replaced Confederate figures since 2020. Who a place decides to put on a plinth is a live argument, not settled history."}},{"id":"7a175dca-fc66-4bfa-a669-f5dfd603e6e2","createdAt":1786942189941,"transform":{"position":[-18,-8.881784197001252e-15,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flag-pole","options":{"height":28,"seed":29}},{"id":"05ad465a-26f8-4d0b-8f1a-2195783dfc0d","createdAt":1786942189942,"transform":{"position":[18,-8.881784197001252e-15,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flag-pole","options":{"height":28,"seed":31}},{"id":"e1116862-4879-4a98-a6c7-1d18d1693180","createdAt":1786942189943,"transform":{"position":[-46,0.09685031370584607,116],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":24,"seed":300,"leafColor":5143098}},{"id":"b88a0671-94d4-456d-821d-d110c9f981d0","createdAt":1786942189944,"transform":{"position":[46,0.14455852180483486,116],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":27,"seed":320,"leafColor":5143098}},{"id":"b5e91eef-9af6-4a56-91fb-5b00d392c538","createdAt":1786942189946,"transform":{"position":[-46,0.011707749151071312,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":27,"seed":307,"leafColor":5143098}},{"id":"86db8e9f-3d6e-4ee2-bda3-a34187fccbdd","createdAt":1786942189947,"transform":{"position":[46,0.05954228011878371,96],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":30,"seed":327,"leafColor":5143098}},{"id":"928dfdda-e0be-4a41-967c-7b2543842a84","createdAt":1786942189948,"transform":{"position":[-46,-9.769962616701378e-15,76]