scale":[1,1,1]},"kind":"preset-prop","prop":"volcanic-bomb","options":{"seed":41,"length":5.5,"girth":1.76}},{"id":"d469751c-7ad3-43c4-8d5b-e0883b98358d","createdAt":1787163363662,"transform":{"position":[34,0.0050732087707694795,22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"volcanic-bomb","options":{"seed":42,"length":4.6,"girth":1.472}},{"id":"41fd06a9-140e-44a7-bdc4-eb3c1bb8be6f","createdAt":1787163363662,"transform":{"position":[-58,-0.39819055004807197,4],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"volcanic-bomb","options":{"seed":43,"length":6.2,"girth":1.9840000000000002}},{"id":"381cd42c-209c-42d5-8146-3cdd418daf1e","createdAt":1787163363662,"transform":{"position":[-30,-0.1699071221872648,52],"rotation":[0,1.0303768265243125,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"🌋  VOLCANOES & ROCKS","lead":"A volcano with a quarter cut out of it, so you can see inside.","lines":["Walk the arc of twelve rocks.","Every one is somewhere on the rock cycle."],"footnote":"The layers on the cut face are lava and ash, one eruption at a time"}},{"id":"5df95205-8d3c-46f9-b372-e9b076427fa5","createdAt":1787163363662,"transform":{"position":[-14,0,6],"rotation":[0,0.21535769969773805,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"WHY IT IS CUT OPEN","title":"The interesting half is inside","body":"From outside, a volcano is a hill. The quarter taken out of this one shows the magma chamber it is fed from, the conduit up to the crater, the dikes prising the rock apart — and the alternating beds of lava and ash that are why it is called a STRATOvolcano.","accent":"#e0455f"}},{"id":"8da02479-464d-4526-9cf8-0a6926638511","createdAt":1787163363662,"transform":{"position":[20,0,6],"rotation":[0,-0.3028848683749714,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"READING A ROCK","title":"Texture, not shape","body":"Basalt and marble are the same lump. What tells them apart is texture and structure: columns, glassy fracture, gas holes, bedding, banding, a sparkle of mica. Each specimen here is built round the one feature that identifies it.","accent":"#8a5cf5"}},{"id":"cc1d261c-f4f7-4abf-aa25-26ab5f89a950","createdAt":1787163363662,"transform":{"position":[8,0.07192129553383791,60],"rotation":[0,-0.6747409422235527,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"cd7be960-436c-4954-83f4-3702442f07b2","createdAt":1787163363662,"transform":{"position":[8,4.071921295533838,60],"rotation":[0,-0.6747409422235527,0],"scale":[1,1,1]},"kind":"web-browser","url":"https://www.youtube-nocookie.com/embed/Vp_S3BDiR-I"},{"id":"e1ef7a25-3696-45eb-be40-608601449f12","createdAt":1787163363662,"transform":{"position":[-46,-0.13669671811813472,30],"rotation":[0,1.1606689862534056,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Send the lava flow down the mountain","target":"the lava flow on the left flank","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"glide 26 feet over 4 seconds","depth":1},{"cat":"motion","text":"go back to start","depth":1}],"tip":"`glide` takes time where `move forward` happens all at once, which is the whole difference between a flow creeping and a rock being teleported. Make the seconds bigger and the lava slows down.","accent":"#e0455f"}},{"id":"c5ea01d0-afe1-4db1-8aa6-ccc24b3c7a5c","createdAt":1787163363662,"transform":{"position":[46,-0.07009861483831079,30],"rotation":[0,-1.1606689862534056,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Turn a rock into the next one","target":"any specimen on a coloured plinth","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"look","text":"change color to 🟠","depth":1},{"cat":"control","text":"wait 1.5 seconds","depth":1},{"cat":"look","text":"change color to 🟣","depth":1},{"cat":"control","text":"wait 1.5 seconds","depth":1}],"tip":"Crimson, amber and violet are the three classes on the plinth rings. Cycle a rock through them in the order the chart draws and you have animated the rock cycle.","accent":"#f2a541"}},{"id":"9e503f5c-79d0-4c29-b198-131ac3cfc78a","createdAt":1787163363662,"transform":{"position":[-36,-0.0011855706808484021,-4],"rotation":[0,0.5880026035475675,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":3,"title":"Grow the ash plume","target":"the ash column above the crater","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"look","text":"change size by 3 %","depth":1},{"cat":"control","text":"wait 0.3 seconds","depth":1},{"cat":"look","text":"change size by -3 %","depth":1},{"cat":"control","text":"wait 0.3 seconds","depth":1}],"tip":"Plus 3 then minus 3 does NOT come back to the same size — each is a percentage of whatever it is now. Watch it shrink and work out why, then use `set size to` instead.","accent":"#3fb37f"}},{"id":"5ec5f81c-ce76-45d8-98b6-6dd27b42c3c8","createdAt":1787163363662,"transform":{"position":[0,83.09507482373826,-100],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#ff7a1e"},{"id":"7d44519f-4734-400e-87cd-36db65d9404b","createdAt":1787163363662,"transform":{"position":[-20,0.33643266644311187,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#ff6a16"},{"id":"9d62a091-26c9-489f-b7d5-35ef80fecd20","createdAt":1787163363662,"transform":{"position":[26,0.33046670966087555,-32],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#ff6a16"}]}