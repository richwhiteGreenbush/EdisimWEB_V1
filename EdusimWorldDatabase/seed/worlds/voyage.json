{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T04:49:47.633Z","records":[{"id":"025f98dd-77b3-4a29-a134-c353486c09f1","kind":"world-theme","theme":"voyage","createdAt":1786942187524,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"742efedb-1498-403a-b188-370c17cbd480","kind":"world-spawn","createdAt":1786942187524,"transform":{"position":[0,0,82],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"abfa873f-ac1b-4aed-a52a-b71c491241dd","createdAt":1786942187526,"transform":{"position":[0,-7.993605777301127e-15,68],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["FANTASTIC VOYAGE"],"subtitle":"YOU HAVE BEEN MINIATURISED","width":15,"height":3.4,"postHeight":8,"face":"#12323d","accent":"#5fc9dd"}},{"id":"abd0f002-d14a-41bd-a9b9-3f32da97e2a3","createdAt":1786942187528,"transform":{"position":[-9,-9.103828801926284e-15,73],"rotation":[0,0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"c71b2b39-98a2-4211-b8a5-f43665879b0e","createdAt":1786942187530,"transform":{"position":[-9,3.999999999999991,73],"rotation":[0,0.7853981633974483,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"1dfd787e-42ea-49c6-890c-4845db5dd015","createdAt":1786942187531,"transform":{"position":[18,-6.217248937900877e-15,60],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"micro-sub","options":{}},{"id":"d28c6117-0c70-4090-9a04-18e60561d1f0","createdAt":1786942187532,"transform":{"position":[8,-7.549516567451064e-15,66],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Launch the micro-sub","target":"Click the submarine → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 30 times","depth":1},{"cat":"motion","text":"move forward 0.8 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"control","text":"repeat 30 times","depth":1},{"cat":"motion","text":"move forward 0.8 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Twenty-four feet down the hall and back. Swallowable pill-sized cameras have been doing the real version of this trip since 2001 — no crew, but a very long journey.","accent":"#0f7d8c"}},{"id":"cdacec43-b4ce-4b29-b58b-7d848cf962dd","createdAt":1786942187534,"transform":{"position":[10,-4.218847493575595e-15,51],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Your ride","title":"Shrunk down and injected","body":"A 1966 film imagined a submarine and its crew miniaturised and injected into a patient. That part is still fiction — but swallowable pill-sized cameras have been photographing the inside of real intestines since 2001.","accent":"#2f8ba0","width":2.6}},{"id":"5131b82e-1f12-4fa1-a9fd-209cec6b16b3","createdAt":1786942187535,"transform":{"position":[-18,-6.217248937900877e-15,60],"rotation":[0,0.7,0],"scale":[1,1,1]},"kind":"startup-billboard","targetHeight":3,"baseOnGround":true},{"id":"b558d193-868e-4b94-bb0d-6cb92926b1c3","createdAt":1786942187536,"transform":{"position":[-8,-4.6629367034256575e-15,53],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Scale","title":"Everything here is enlarged","body":"A real liver is the size of a football, and a kidney is the size of your fist. At life size you could not walk round any of it, so every model here is roughly fifteen to twenty times too big. Each sign tells you the real size.","accent":"#2f8ba0","width":2.6}},{"id":"0fac7a78-c52f-4ceb-8f1e-7ba02eec5ae8","createdAt":1786942187537,"transform":{"position":[0,-9.325873406851315e-15,42],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"artery-tunnel","options":{"length":28,"radius":6.5}},{"id":"8f930e3a-cc39-4bc6-ad9a-21703b968a61","createdAt":1786942187539,"transform":{"position":[0,-3.9968028886505635e-15,50],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"blood-cells","options":{"count":10,"radius":5,"height":9,"seed":5}},{"id":"cdacc538-8a83-49e2-bead-e8f97a7dfe38","createdAt":1786942187540,"transform":{"position":[0,-7.549516567451064e-15,34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"blood-cells","options":{"count":8,"radius":5,"height":9,"seed":19}},{"id":"db51b946-2e5f-49b6-a295-cb4eb7f5cd2c","createdAt":1786942187541,"transform":{"position":[0,4.999999999999996,53],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"900dd617-89f2-4173-a591-06beb127cad1","createdAt":1786942187542,"transform":{"position":[0,4.99999999999999,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"f3cf4833-8d1f-4520-a073-112efab41ed0","createdAt":1786942187544,"transform":{"position":[0,4.999999999999992,35],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"1db92a3f-8fc6-4ad4-a645-fd71f698a7fa","createdAt":1786942187545,"transform":{"position":[9,-5.773159728050814e-15,26],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Where you are","title":"Inside an artery","body":"Laid end to end, one person’s blood vessels would run about 60,000 miles — enough to wrap around the Earth twice. The biggest, the aorta, is about as wide as a garden hose. The smallest are narrower than one red blood cell.","accent":"#2f8ba0","width":2.6}},{"id":"4c89476e-1bc0-4aa5-8aa7-e2f7c290f01e","createdAt":1786942187546,"transform":{"position":[0,-3.1086244689504383e-15,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"rib-cage-arch","options":{"span":15,"height":13,"pairs":7}},{"id":"decd8bc5-b0e5-4b9d-9d8e-481e85aa4034","createdAt":1786942187547,"transform":{"position":[0,9.999999999999996,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"eac1bad0-a0ff-4f0e-9e45-fd3792224893","createdAt":1786942187548,"transform":{"position":[11,-3.774758283725532e-15,17],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"The rib cage","title":"A cage that has to breathe","body":"Twelve pairs of ribs, and they are not a fixed box — every rib swings up and out when you breathe in. Behind you they join the spine; in front, the top seven pairs join the breastbone through flexible cartilage.","accent":"#2f8ba0","width":2.6}},{"id":"b9440506-5f64-4d32-9ae8-c5d8ced6b2c1","createdAt":1786942187550,"transform":{"position":[-22,1.3322676295501878e-15,-6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Lungs","sublabel":"RESPIRATORY SYSTEM","radius":5.4,"height":3}},{"id":"9f0fae22-dd55-4c4f-8cc0-31efea92d8ae","createdAt":1786942187551,"transform":{"position":[-22,3.0000000000000013,-6],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"lungs-model","options":{}},{"id":"f79797ec-3214-4bfc-857b-3ad45ecfd375","createdAt":1786942187552,"transform":{"position":[-13,1.1102230246251565e-16,-0.5],"rotation":[0,0.65,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Lungs","title":"A folded-up tennis court","body":"Real lungs are about 10 inches tall. Inside are 300–500 million alveoli — tiny air sacs — and unfolded they would cover about 70 square metres, roughly a classroom floor. That is the surface oxygen crosses to reach your blood.","accent":"#2f8ba0","width":2.6}},{"id":"61bd3484-ca61-4909-8d7b-d5879e4addf9","createdAt":1786942187553,"transform":{"position":[-32,3.774758283725532e-15,-17],"rotation":[0,2.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Left and right","title":"They are not a matching pair","body":"The right lung has three lobes, the left only two — the heart takes the space where the third would be. That is also why an inhaled peanut nearly always ends up in the right lung: its bronchus is wider and steeper.","accent":"#2f8ba0","width":2.6}},{"id":"79f4fec3-813b-4657-9b40-d62039b460c8","createdAt":1786942187554,"transform":{"position":[-28,8,0],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"718b14e1-e084-4eec-9571-ad1d97a8465d","createdAt":1786942187556,"transform":{"position":[-16,8.000000000000004,-13],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"3ce0f498-09eb-4b6b-a5af-10b71eb9ee81","createdAt":1786942187557,"transform":{"position":[-38,-1.1102230246251565e-15,5],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"alveoli-cluster","options":{}},{"id":"9892b869-63ef-4da5-b031-b0028689b47c","createdAt":1786942187558,"transform":{"position":[-29,-2.4424906541753444e-15,11],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Zoom in","title":"Where the swap happens","body":"This is one alveolus and its blood vessels, blown up enormously. The wall between air and blood is about one five-hundredth of a millimetre thick — thin enough for oxygen to cross by simply drifting.","accent":"#2f8ba0","width":2.6}},{"id":"c78303a1-80a4-4471-91d2-0f45f68d8296","createdAt":1786942187559,"transform":{"position":[-38,6.999999999999998,7],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"a2e960df-6726-4fe0-bfc8-8423ca5323bc","createdAt":1786942187560,"transform":{"position":[22,1.3322676295501878e-15,-6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Stomach","sublabel":"DIGESTIVE SYSTEM","radius":4.6,"height":3}},{"id":"c6c40240-af5e-4e53-9aae-f4af31b4b805","createdAt":1786942187562,"transform":{"position":[22,3.0000000000000013,-6],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"stomach-model","options":{}},{"id":"9f029870-9b3f-4acb-86dd-b22941adc015","createdAt":1786942187563,"transform":{"position":[13,1.1102230246251565e-16,-0.5],"rotation":[0,-0.65,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Stomach","title":"A bag of acid that does not digest itself","body":"Stomach acid sits around pH 1.5–3.5 — strong enough to strip rust off steel. The reason it does not eat through you is a layer of mucus that the stomach lining replaces every few days.","accent":"#2f8ba0","width":2.6}},{"id":"ef2042e0-892b-45f8-be48-2954fafd0511","createdAt":1786942187564,"transform":{"position":[31,1.9984014443252818e-15,-9],"rotation":[0,-2.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"How much fits","title":"Empty, it is fist-sized","body":"An empty stomach holds well under a cup. Full, it stretches to about four times that. Those folds you can see inside — the rugae — are what unfold to let it. Food stays here two to four hours, then leaves a teaspoon at a time.","accent":"#2f8ba0","width":2.6}},{"id":"89ac4332-e911-4e2e-98ab-9ee1c1053cbd","createdAt":1786942187565,"transform":{"position":[28,8,0],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"025d7eb7-0eea-4a85-ad2e-3636de08c498","createdAt":1786942187566,"transform":{"position":[16,8.000000000000004,-13],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"f32e3d69-2141-4f08-a405-a9bd106d0825","createdAt":1786942187568,"transform":{"position":[36,-1.1102230246251565e-15,5],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"villi-patch","options":{"count":46,"radius":6,"seed":11}},{"id":"146696a3-a8de-4800-a147-2b7eb94352c5","createdAt":1786942187569,"transform":{"position":[28,-2.6645352591003757e-15,12],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Small intestine","title":"Lined with millions of fingers","body":"Almost all of your food is actually absorbed here, not in the stomach. The lining is covered in villi like these — magnified hugely — and they turn a 22-foot tube into about 30 square metres of absorbing surface.","accent":"#2f8ba0","width":2.6}},{"id":"2bbcfb66-f191-4958-8525-7b9af500ebdf","createdAt":1786942187570,"transform":{"position":[36,3.9968028886505635e-15,-18],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Intestines","sublabel":"ABOUT 27 FEET OF TUBE","radius":5,"height":3}},{"id":"66840099-1209-4290-a822-f8f12a302495","createdAt":1786942187571,"transform":{"position":[36,3.000000000000004,-18],"rotation":[0,-0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"intestine-coil","options":{}},{"id":"a97891b3-3f41-4781-be5e-8eb96e4facdf","createdAt":1786942187573,"transform":{"position":[30,8.000000000000005,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"6e8026cc-4490-4e4a-9337-f17f0e0ebe72","createdAt":1786942187574,"transform":{"position":[0,4.440892098500626e-15,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Heart","sublabel":"THE HUB OF ALL OF IT","radius":4.2,"height":3.5,"accent":"#ff7a6e"}},{"id":"b2906447-b264-4e47-aa11-fd220e21a49b","createdAt":1786942187575,"transform":{"position":[0,3.5000000000000044,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"heart-model","options":{}},{"id":"5dcd626d-6da6-4abd-a7e2-963c05bb7ae8","createdAt":1786942187576,"transform":{"position":[-7,3.1086244689504383e-15,-14],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Heart","title":"Your own fist, beating","body":"A heart is about the size of the owner’s clenched fist. It beats around 100,000 times a day and pushes roughly 7,500 litres of blood — enough to fill a small swimming pool every week, without ever taking a break.","accent":"#2f8ba0","width":2.6}},{"id":"68907caa-d3fa-496a-be1f-dfea33cc774a","createdAt":1786942187577,"transform":{"position":[7,3.1086244689504383e-15,-14],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Two pumps in one","title":"Blue side, red side","body":"The right half pumps blood to the lungs to collect oxygen; the left half pumps it to everywhere else. That is why anatomy models colour them differently — the blue side is not cold, it is just carrying blood that has not been to the lungs yet.","accent":"#2f8ba0","width":2.6}},{"id":"c8888af8-4fe9-452c-95a3-883b5ea7859b","createdAt":1786942187578,"transform":{"position":[-6,9.000000000000005,-25],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"fe37d1c8-4307-428e-8381-d0f40a4e2393","createdAt":1786942187580,"transform":{"position":[6,9.000000000000005,-25],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"2ab9a8fa-4b5c-4196-819d-53ab8e21011b","createdAt":1786942187581,"transform":{"position":[-13,5.329070518200751e-15,-24],"rotation":[0,0.55,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Make the heart beat","target":"Click the heart → Program.","steps":[{"cat":"control","text":"repeat 12 times","depth":0},{"cat":"look","text":"change size by 6 %","depth":1},{"cat":"control","text":"wait 0.3 seconds","depth":1},{"cat":"look","text":"change size by -6 %","depth":1},{"cat":"control","text":"wait 0.3 seconds","depth":1}],"tip":"Squeeze, rest, squeeze, rest — about 100,000 times a day without a single break. Watch carefully and the heart ends up a shade smaller than it started: +6% then -6% does not quite cancel out. Percentages are sneaky like that.","accent":"#b8324a"}},{"id":"33d2c515-13d1-4486-a7fb-2a6dcf921fdf","createdAt":1786942187582,"transform":{"position":[-9,6.661338147750939e-15,-30],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{}},{"id":"e88ee32d-d0b1-42d4-a16c-28265287ed24","createdAt":1786942187583,"transform":{"position":[9,6.661338147750939e-15,-30],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{}},{"id":"2f6063ad-3a21-47dd-b34e-571ca12bb8e3","createdAt":1786942187585,"transform":{"position":[-22,7.993605777301127e-15,-36],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Liver","sublabel":"THE CHEMICAL PLANT","radius":4.8,"height":3}},{"id":"0beb0925-d8c4-42d0-ae78-de25025188fb","createdAt":1786942187586,"transform":{"position":[-22,3.000000000000008,-36],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"liver-model","options":{}},{"id":"cfc8924c-162a-4af4-a670-5bb3f27ff339","createdAt":1786942187587,"transform":{"position":[-13,6.8833827526759706e-15,-31],"rotation":[0,0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Liver","title":"Five hundred jobs at once","body":"The largest organ inside you, about 3 pounds and roughly football-sized. It cleans the blood arriving from your gut, stores energy, makes bile for digesting fat, and breaks down medicines — several hundred jobs in one lump of tissue.","accent":"#2f8ba0","width":2.6}},{"id":"9478b274-6633-462e-892f-3870237f4228","createdAt":1786942187588,"transform":{"position":[-30,9.547918011776346e-15,-43],"rotation":[0,2.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Unique","title":"It can grow back","body":"The liver is the only human organ that regrows. Remove up to two thirds of it and the rest will grow back to full size in a matter of weeks — which is what makes it possible for a living person to donate part of theirs.","accent":"#2f8ba0","width":2.6}},{"id":"c4c4de14-49a7-4be2-97dc-dcc98811ca39","createdAt":1786942187589,"transform":{"position":[-28,8.000000000000007,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"4186eba0-29e7-465a-a62a-32216e5a7509","createdAt":1786942187591,"transform":{"position":[-16,8.000000000000009,-43],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"667086f5-17de-4aee-bd16-95bc1ee8ccd9","createdAt":1786942187592,"transform":{"position":[22,7.993605777301127e-15,-36],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Kidneys","sublabel":"URINARY SYSTEM","radius":4.6,"height":3}},{"id":"083195b7-1750-4230-91e1-9966635c09c1","createdAt":1786942187593,"transform":{"position":[22,3.000000000000008,-36],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"kidney-model","options":{}},{"id":"dfa5e1f9-5ada-4eda-940e-b7493c64bef1","createdAt":1786942187594,"transform":{"position":[13,6.8833827526759706e-15,-31],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Kidneys","title":"Filtering the whole lot, 40 times a day","body":"Each kidney is fist-sized and holds about a million microscopic filters. Together they pull around 180 litres of fluid out of your blood every day — then put about 99% of it straight back. What is left is roughly 1.5 litres of urine.","accent":"#2f8ba0","width":2.6}},{"id":"ee70f1cf-231a-4d90-8383-d13cfb8a80e6","createdAt":1786942187596,"transform":{"position":[30,9.547918011776346e-15,-43],"rotation":[0,-2.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Why two?","title":"You only need one","body":"The right kidney sits lower than the left, pushed down by the liver above it. You are born with two, but a single healthy kidney does the whole job — which is why a living person can donate one.","accent":"#2f8ba0","width":2.6}},{"id":"5c069591-409d-4a5a-b443-f90d62abed03","createdAt":1786942187597,"transform":{"position":[28,8.000000000000007,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"0b41c0d8-b9dd-4969-8378-04c3d6379e94","createdAt":1786942187598,"transform":{"position":[16,8.000000000000009,-43],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"2096cc4d-78bd-4394-8c40-cec468146ee0","createdAt":1786942187599,"transform":{"position":[38,3.774758283725532e-15,-49],"rotation":[0,-1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"anatomy-chart","options":{"chart":"kidney-section","width":8}},{"id":"e48d0d8c-fa36-4e17-9456-1b24b235206e","createdAt":1786942187601,"transform":{"position":[-42,5.329070518200751e-15,-24],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Brain","sublabel":"NERVOUS SYSTEM","radius":3.8,"height":3}},{"id":"77929a98-80f6-47c1-8e67-eac4a116b796","createdAt":1786942187602,"transform":{"position":[-42,3.0000000000000053,-24],"rotation":[0,1.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"brain-model","options":{}},{"id":"85c5e8a1-155d-4fcc-9b15-74e2801796c3","createdAt":1786942187603,"transform":{"position":[-38,2.886579864025407e-15,-13],"rotation":[0,1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Brain","title":"Two per cent of you, twenty per cent of the fuel","body":"About 86 billion nerve cells, folded up so that three times as much surface fits inside your skull. It is only about 2% of your body weight but burns around 20% of the oxygen you breathe — even while you sleep.","accent":"#2f8ba0","width":2.6}},{"id":"5404bad7-75f0-4e8e-b3c6-9ff392875793","createdAt":1786942187604,"transform":{"position":[-42,8.000000000000007,-29],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"864f69e0-31c4-474a-a5df-925de8771c42","createdAt":1786942187605,"transform":{"position":[-58,-1.3322676295501878e-15,6],"rotation":[0,1.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"neuron-model","options":{"length":24}},{"id":"b76b4eaf-eb8c-4fcd-a628-787b23b6172e","createdAt":1786942187606,"transform":{"position":[-46,-3.552713678800501e-15,16],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"One nerve cell","title":"Signals at 270 miles an hour","body":"Signals arrive on the branching end, travel down the long fibre, and are handed to the next cell at the tips. The pale sleeves are insulation — the gaps between them let the signal leap ahead instead of crawling, up to 120 metres per second.","accent":"#2f8ba0","width":2.6}},{"id":"2b52fd3c-56c9-42c5-abdf-9d21679cf51e","createdAt":1786942187608,"transform":{"position":[-56,7,2],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"4690069d-db1a-43d2-9493-893536761f72","createdAt":1786942187609,"transform":{"position":[46,6.661338147750939e-15,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dna-helix","options":{"height":22,"turns":3.2}},{"id":"35c021dd-a63a-4e24-a0f3-b41fd86eb9ec","createdAt":1786942187610,"transform":{"position":[45,3.3306690738754696e-15,-15],"rotation":[0,-1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"DNA","title":"Two metres, in every cell","body":"The rungs are the four letters the whole instruction book is written in. About three billion of them are packed into nearly every one of your cells — roughly two metres of DNA, coiled into a space you need a microscope to see.","accent":"#2f8ba0","width":2.6}},{"id":"0666aa45-5112-4b71-990c-01d3875c80df","createdAt":1786942187611,"transform":{"position":[46,8.000000000000007,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"564746b8-d662-432c-8b15-8dbbe863e720","createdAt":1786942187613,"transform":{"position":[-54,8.881784197001252e-15,-40],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cell-model","options":{}},{"id":"f5fbbc65-447c-49ca-9c40-538734e483c3","createdAt":1786942187614,"transform":{"position":[-60,5.773159728050814e-15,-26],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"anatomy-chart","options":{"chart":"cell","width":8}},{"id":"d1df6e82-ea51-45cc-91c3-43a89bcb9b62","createdAt":1786942187615,"transform":{"position":[-45,6.8833827526759706e-15,-31],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"One cell","title":"Thirty-seven trillion of these","body":"Every organ in this hall is built from cells like this one. The purple ball is the nucleus, holding the DNA; the orange capsules are mitochondria, which release the energy from your food. This model is about a million times life size.","accent":"#2f8ba0","width":2.6}},{"id":"5d67feab-1db0-4058-8927-d890a85c9569","createdAt":1786942187616,"transform":{"position":[-54,8.000000000000007,-36],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"39f2614f-bffe-49ad-8334-d09894044eb4","createdAt":1786942187617,"transform":{"position":[0,9.325873406851315e-15,-42],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE SYSTEMS GALLERY"],"subtitle":"HOW THE PIECES JOIN UP","width":13,"height":3,"postHeight":7.5,"face":"#12323d","accent":"#5fc9dd"}},{"id":"ab8db59f-c531-4392-a381-d58eb0f31b50","createdAt":1786942187619,"transform":{"position":[0,7.105427357601002e-15,-64],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"anatomy-chart","options":{"chart":"body-systems","width":12}},{"id":"f894735a-e6a5-4c28-84b6-669c4134cebf","createdAt":1786942187620,"transform":{"position":[-34,6.217248937900877e-15,-60],"rotation":[0,0.34,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"anatomy-chart","options":{"chart":"respiratory","width":9}},{"id":"b0ec861a-47d5-44a6-a353-1c76a6d22e88","createdAt":1786942187621,"transform":{"position":[-18,6.661338147750939e-15,-62],"rotation":[0,0.16,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"anatomy-chart","options":{"chart":"circulatory","width":9}},{"id":"6b893ea4-6af5-415c-bac7-f4a0413f7102","createdAt":1786942187622,