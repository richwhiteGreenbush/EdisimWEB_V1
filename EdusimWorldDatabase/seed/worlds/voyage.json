{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T21:03:45.030Z","records":[{"id":"eda51026-64d5-4d18-8811-2089ba512e55","kind":"world-theme","theme":"voyage","createdAt":1787000625030,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"ee45df8e-da22-4fa2-a66d-1632c505cc68","kind":"world-spawn","createdAt":1787000625030,"transform":{"position":[0,0,82],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"f194b61b-67d2-486d-b43b-dff63e9d5b14","createdAt":1787000625030,"transform":{"position":[-13,0,66],"rotation":[0,0.36,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["FANTASTIC VOYAGE"],"subtitle":"YOU HAVE BEEN MINIATURISED","width":15,"height":3.4,"postHeight":8,"face":"#12323d","accent":"#5fc9dd"}},{"id":"cf09aece-f69f-4890-8b73-1a67abc0ecd6","createdAt":1787000625030,"transform":{"position":[10,0,73],"rotation":[0,-0.83798122500839,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"a1a90711-49d5-4498-81f2-369315a1a1a7","createdAt":1787000625030,"transform":{"position":[10,4,73],"rotation":[0,-0.83798122500839,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"db4784ce-2014-4e76-992c-ddd5174beb9c","createdAt":1787000625030,"transform":{"position":[18,0,60],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"micro-sub","options":{}},{"id":"3b668dff-1d4a-4eaa-b32b-dbaf84f537b3","createdAt":1787000625030,"transform":{"position":[8,0,66],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Launch the micro-sub","target":"Click the submarine → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 30 times","depth":1},{"cat":"motion","text":"move forward 0.8 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"control","text":"repeat 30 times","depth":1},{"cat":"motion","text":"move forward 0.8 feet","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Twenty-four feet down the hall and back. Swallowable pill-sized cameras have been doing the real version of this trip since 2001 — no crew, but a very long journey.","accent":"#0f7d8c"}},{"id":"db6456e1-c50d-41aa-8248-2f4ca93860a2","createdAt":1787000625030,"transform":{"position":[10,0,51],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Your ride","title":"Shrunk down and injected","body":"A 1966 film imagined a submarine and its crew miniaturised and injected into a patient. That part is still fiction — but swallowable pill-sized cameras have been photographing the inside of real intestines since 2001.","accent":"#5fc9dd","width":2.6}},{"id":"71f2f002-47ff-45a8-940e-d92fda09f55d","createdAt":1787000625030,"transform":{"position":[-8,0,53],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Scale","title":"Everything here is enlarged","body":"A real liver is the size of a football, and a kidney is the size of your fist. At life size you could not walk round any of it, so every model here is roughly fifteen to twenty times too big. Each sign tells you the real size.","accent":"#5fc9dd","width":2.6}},{"id":"143f2eb5-2411-43af-b548-ce6416fd69b9","createdAt":1787000625030,"transform":{"position":[0,0,42],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"artery-tunnel","options":{"length":28,"radius":6.5}},{"id":"50dec889-3824-4d35-b475-cb2be1c1c0b8","createdAt":1787000625030,"transform":{"position":[0,0,48],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"blood-cells","options":{"count":11,"radius":5,"height":9,"seed":5}},{"id":"06e40bad-a4eb-4ea2-af08-c2427195214a","createdAt":1787000625030,"transform":{"position":[0,0,35],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"blood-cells","options":{"count":9,"radius":5,"height":9,"seed":19}},{"id":"5955325e-887b-43c7-b7ee-f47ad696f920","createdAt":1787000625030,"transform":{"position":[0,5,50],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"0c0a412e-d9d4-4920-9584-f95de5bdbd0d","createdAt":1787000625030,"transform":{"position":[0,5,38],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"75ac3c38-2120-4327-8213-0ceefd4ba58f","createdAt":1787000625030,"transform":{"position":[9,0,26],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Where you are","title":"Inside an artery","body":"Laid end to end, one person’s blood vessels would run about 60,000 miles — enough to wrap around the Earth twice. The biggest, the aorta, is about as wide as a garden hose. The smallest are narrower than one red blood cell.","accent":"#ff5f6d","width":2.6}},{"id":"ae01e9de-3880-468d-8e60-e1c8de3d2397","createdAt":1787000625030,"transform":{"position":[0,0,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"rib-cage-arch","options":{"span":15,"height":13,"pairs":7}},{"id":"def4c661-093e-408f-bbbc-682bd958df37","createdAt":1787000625030,"transform":{"position":[0,10,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"fc067eba-98af-41a4-9cac-a2f37abc907b","createdAt":1787000625030,"transform":{"position":[11,0,17],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"The rib cage","title":"A cage that has to breathe","body":"Twelve pairs of ribs, and they are not a fixed box — every rib swings up and out when you breathe in. Behind you they join the spine; in front, the top seven pairs join the breastbone through flexible cartilage, which is the pale blue-white part here.","accent":"#d8cba6","width":2.6}},{"id":"1980478d-fc09-4097-960f-5790ef62ba43","createdAt":1787000625030,"transform":{"position":[-22,0,-6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Lungs","sublabel":"RESPIRATORY SYSTEM","radius":5.4,"height":3,"accent":"#57c4e5"}},{"id":"eb9cb30c-0176-4e89-81e5-ab1a07ecf579","createdAt":1787000625030,"transform":{"position":[-22,3,-6],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"lungs-model","options":{}},{"id":"1b0a388d-ef50-4526-837b-f3df62246614","createdAt":1787000625030,"transform":{"position":[-13,0,-0.5],"rotation":[0,0.65,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Lungs","title":"A folded-up tennis court","body":"Real lungs are about 10 inches tall. Inside are 300–500 million alveoli — tiny air sacs — and unfolded they would cover about 70 square metres, roughly a classroom floor. That is the surface oxygen crosses to reach your blood.","accent":"#57c4e5","width":2.6}},{"id":"f175286a-c130-47c6-994f-433286329c6a","createdAt":1787000625030,"transform":{"position":[-32,0,-17],"rotation":[0,2.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Left and right","title":"They are not a matching pair","body":"The right lung has three lobes and the left only two — the heart takes the space where the third would be. The left one here is cut open so you can see the airway inside. That is also why an inhaled peanut nearly always ends up in the right lung: its bronchus is wider and steeper.","accent":"#57c4e5","width":2.6}},{"id":"7cf53dc9-d488-442b-9fad-a9b557bdaeef","createdAt":1787000625030,"transform":{"position":[-30,7,-12],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"ce3b258e-82fc-4e14-ba92-b0c71e8a3f69","createdAt":1787000625030,"transform":{"position":[-38,0,5],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"alveoli-cluster","options":{}},{"id":"0cf410a9-a0ed-43ae-bb63-2d498b338bf4","createdAt":1787000625030,"transform":{"position":[-29,0,11],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Zoom in","title":"Where the swap happens","body":"This is one alveolus and its blood vessels, blown up enormously. The wall between air and blood is about one five-hundredth of a millimetre thick — thin enough for oxygen to cross by simply drifting. Blue vessels arrive, red ones leave.","accent":"#57c4e5","width":2.6}},{"id":"cd7172de-df1b-403b-9668-949996e9a3af","createdAt":1787000625030,"transform":{"position":[22,0,-6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Stomach","sublabel":"DIGESTIVE SYSTEM","radius":4.6,"height":3,"accent":"#f4a83a"}},{"id":"88b0dff7-9e38-4ab0-9cd9-02fc2e46a34f","createdAt":1787000625030,"transform":{"position":[22,3,-6],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"stomach-model","options":{}},{"id":"433c1e1c-2676-4161-b236-95664bab8406","createdAt":1787000625030,"transform":{"position":[13,0,-0.5],"rotation":[0,-0.65,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Stomach","title":"A bag of acid that does not digest itself","body":"Stomach acid sits around pH 1.5–3.5 — strong enough to strip rust off steel. The reason it does not eat through you is a layer of mucus that the stomach lining replaces every few days.","accent":"#f4a83a","width":2.6}},{"id":"33a3519c-67f0-4c7b-9c5e-31813d5036d1","createdAt":1787000625030,"transform":{"position":[31,0,-9],"rotation":[0,-2.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"How much fits","title":"Empty, it is fist-sized","body":"An empty stomach holds well under a cup. Full, it stretches to about four times that. This one is cut open so you can see the folds — the rugae — that unfold to let it. Food stays here two to four hours, then leaves a teaspoon at a time.","accent":"#f4a83a","width":2.6}},{"id":"1af4f349-5a79-4222-97b6-aef84870988f","createdAt":1787000625030,"transform":{"position":[28,8,0],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"61178d5b-4e82-4a34-abba-b5fd1edf5566","createdAt":1787000625030,"transform":{"position":[36,0,5],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"villi-patch","options":{"count":46,"radius":6,"seed":11}},{"id":"fb0571bb-79b0-49c3-ab50-0db19ea33135","createdAt":1787000625030,"transform":{"position":[28,0,12],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Small intestine","title":"Lined with millions of fingers","body":"Almost all of your food is actually absorbed here, not in the stomach. The lining is covered in villi like these — magnified hugely — and they turn a 22-foot tube into about 30 square metres of absorbing surface.","accent":"#f4a83a","width":2.6}},{"id":"984550ae-62f9-4dce-90c0-06d1b4107f83","createdAt":1787000625030,"transform":{"position":[36,0,-18],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Intestines","sublabel":"ABOUT 27 FEET OF TUBE","radius":5,"height":3,"accent":"#f4a83a"}},{"id":"ff3dac81-28d4-4185-b20f-21a9c01d1888","createdAt":1787000625030,"transform":{"position":[36,3,-18],"rotation":[0,-0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"intestine-coil","options":{}},{"id":"c11a3e10-a270-4112-9128-d096bc9238d8","createdAt":1787000625030,"transform":{"position":[30,8,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"ca9f6b1e-0680-4d70-a51d-52ea698aff3c","createdAt":1787000625030,"transform":{"position":[44,0,-13],"rotation":[0,-1.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Why it is lumpy","title":"Three ribbons pulling it in","body":"The large intestine has three ribbons of muscle running its whole length, and they are shorter than the tube they are on — so it puckers between them into that row of pouches. The little yellow tags hanging off it are fat.","accent":"#f4a83a","width":2.6}},{"id":"26cde79a-3799-4d49-ba82-3b0014e8a9b9","createdAt":1787000625030,"transform":{"position":[0,0,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Heart","sublabel":"THE HUB OF ALL OF IT","radius":4.2,"height":3.5,"accent":"#ff5f6d"}},{"id":"0f7e01a0-43ab-4f5d-a4f8-cd6742a182f9","createdAt":1787000625030,"transform":{"position":[0,3.5,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"heart-model","options":{}},{"id":"69f68ea3-64b1-4c04-a0be-d39ee7cfc882","createdAt":1787000625030,"transform":{"position":[-7,0,-14],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Heart","title":"Your own fist, beating","body":"A heart is about the size of the owner’s clenched fist. It beats around 100,000 times a day and pushes roughly 7,500 litres of blood — enough to fill a small swimming pool every week, without ever taking a break.","accent":"#ff5f6d","width":2.6}},{"id":"efea2d45-f6c5-4cf7-9680-2602f33dfee0","createdAt":1787000625030,"transform":{"position":[7,0,-14],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Two pumps in one","title":"Blue side, red side","body":"The right half pumps blood to the lungs to collect oxygen; the left half pumps it to everywhere else. The colour changes along the groove where the two halves meet — and the blue side is not cold, it is just carrying blood that has not been to the lungs yet.","accent":"#ff5f6d","width":2.6}},{"id":"1761bb95-7801-485a-98d4-d95d1ace80bc","createdAt":1787000625030,"transform":{"position":[-6,9,-25],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"5083e5d1-9415-4f84-9d37-734728472fdd","createdAt":1787000625030,"transform":{"position":[6,9,-25],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"a54ff551-29e0-472b-a715-2ba9d60ea9e9","createdAt":1787000625030,"transform":{"position":[-13,0,-24],"rotation":[0,0.55,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Make the heart beat","target":"Click the heart → Program.","steps":[{"cat":"control","text":"repeat 12 times","depth":0},{"cat":"look","text":"change size by 6 %","depth":1},{"cat":"control","text":"wait 0.3 seconds","depth":1},{"cat":"look","text":"change size by -6 %","depth":1},{"cat":"control","text":"wait 0.3 seconds","depth":1}],"tip":"Squeeze, rest, squeeze, rest — about 100,000 times a day without a single break. Watch carefully and the heart ends up a shade smaller than it started: +6% then -6% does not quite cancel out. Percentages are sneaky like that.","accent":"#b8324a"}},{"id":"3ba3dbcc-ac6a-4410-878a-e1cf25147119","createdAt":1787000625030,"transform":{"position":[-22,0,-36],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Liver","sublabel":"THE CHEMICAL PLANT","radius":4.8,"height":3,"accent":"#f4a83a"}},{"id":"bbfdd889-d047-485f-9a62-d1668011e87d","createdAt":1787000625030,"transform":{"position":[-22,3,-36],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"liver-model","options":{}},{"id":"414f4bf8-8b98-4f29-9818-035cc444be5f","createdAt":1787000625030,"transform":{"position":[-13,0,-31],"rotation":[0,0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Liver","title":"Five hundred jobs at once","body":"The largest organ inside you, about 3 pounds and roughly football-sized. It cleans the blood arriving from your gut, stores energy, makes bile for digesting fat, and breaks down medicines — several hundred jobs in one lump of tissue.","accent":"#f4a83a","width":2.6}},{"id":"7707d6ab-0966-4b8c-a555-bdbd05477f79","createdAt":1787000625030,"transform":{"position":[-30,0,-43],"rotation":[0,2.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Three pipes and a bag","title":"What goes in and out underneath","body":"Turn to the underside and there are three tubes: indigo is blood arriving from your gut, scarlet is blood arriving with oxygen, green is bile leaving. The green sac tucked into the liver is the gallbladder, which stores that bile until you eat something fatty.","accent":"#f4a83a","width":2.6}},{"id":"f31177c8-b9c8-4217-b2d7-3f62933b0456","createdAt":1787000625030,"transform":{"position":[-28,8,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"c5bbd3c9-149d-493e-8bc2-f8e1c15e26b8","createdAt":1787000625030,"transform":{"position":[22,0,-36],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Kidneys","sublabel":"URINARY SYSTEM","radius":4.6,"height":3,"accent":"#3fc09b"}},{"id":"36815461-58b9-4e2b-8ff0-d7840b480e19","createdAt":1787000625030,"transform":{"position":[22,3,-36],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"kidney-model","options":{}},{"id":"4c4f0c5d-88c8-4578-92fc-c28e65f2f46e","createdAt":1787000625030,"transform":{"position":[13,0,-31],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Kidneys","title":"Filtering the whole lot, 40 times a day","body":"Each kidney is fist-sized and holds about a million microscopic filters. Together they pull around 180 litres of fluid out of your blood every day — then put about 99% of it straight back. What is left is roughly 1.5 litres of urine.","accent":"#3fc09b","width":2.6}},{"id":"52095d2e-30ea-4aa2-a49f-e02599c2fd29","createdAt":1787000625030,"transform":{"position":[30,0,-43],"rotation":[0,-2.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Cut in half","title":"A pale rind over dark triangles","body":"One of these is sliced open. The pale outer rind is where the filtering happens; the dark triangles are bundles of tiny tubes all pointing inward, draining into the funnel in the middle and then down the ureter. The yellow caps on top are a different organ entirely — they make adrenaline.","accent":"#3fc09b","width":2.6}},{"id":"b991639c-715a-4f05-915f-a5f78e421cee","createdAt":1787000625030,"transform":{"position":[28,8,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"247380a9-7624-4a70-956b-5a992c6921cf","createdAt":1787000625030,"transform":{"position":[-42,0,-24],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"organ-plinth","options":{"label":"Brain","sublabel":"NERVOUS SYSTEM","radius":3.8,"height":3,"accent":"#a78bfa"}},{"id":"fd483b08-8ede-4e42-8406-79982f3df814","createdAt":1787000625030,"transform":{"position":[-42,3,-24],"rotation":[0,1.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"brain-model","options":{}},{"id":"bd0ed99d-97b8-4871-b320-85662d9cd558","createdAt":1787000625030,"transform":{"position":[-38,0,-13],"rotation":[0,1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Brain","title":"Two per cent of you, twenty per cent of the fuel","body":"About 86 billion nerve cells, folded up so that three times as much surface fits inside your skull — those folds are what all the ridges and grooves are. It is only about 2% of your body weight but burns around 20% of the oxygen you breathe, even while you sleep.","accent":"#a78bfa","width":2.6}},{"id":"7e63d811-fa26-48de-98ab-b72c60886266","createdAt":1787000625030,"transform":{"position":[-42,8,-29],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#3d8bf2"},{"id":"535ff578-b91d-4b0a-b4ec-08cb80fa2205","createdAt":1787000625030,"transform":{"position":[-58,0,6],"rotation":[0,1.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"neuron-model","options":{"length":24}},{"id":"9706be1a-da8b-4ab4-88a1-10f9be80e92f","createdAt":1787000625030,"transform":{"position":[-46,0,16],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"One nerve cell","title":"Signals at 270 miles an hour","body":"Signals arrive on the branching end, travel down the long fibre, and are handed to the next cell at the tips. The pale sleeves are insulation — and the GAPS between them are the trick: the signal leaps from one gap to the next instead of crawling, up to 120 metres per second.","accent":"#a78bfa","width":2.6}},{"id":"703ca60b-fccb-495b-9edc-760db74dab02","createdAt":1787000625030,"transform":{"position":[-56,7,2],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"20f3db7f-a40a-4553-adb8-6cb1ec89e741","createdAt":1787000625030,"transform":{"position":[46,0,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dna-helix","options":{"height":22,"turns":3.2}},{"id":"016f1f8d-f815-4f72-9b5f-48c539d4b718","createdAt":1787000625030,"transform":{"position":[45,0,-15],"rotation":[0,-1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"DNA","title":"Two metres, in every cell","body":"The flat plates in the middle are the four letters the whole instruction book is written in. Notice the two rails are not opposite each other — that offset is what leaves a wide groove and a narrow one, which is how the proteins that read DNA find their way along it.","accent":"#e879b8","width":2.6}},{"id":"22868f51-d42e-48cc-b115-9510bdae1057","createdAt":1787000625030,"transform":{"position":[46,8,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"f53235c9-bcd3-4e17-8bba-d01c8a87a53d","createdAt":1787000625030,"transform":{"position":[-54,0,-40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cell-model","options":{}},{"id":"0ec86801-a804-4391-a965-ce0fe4658a46","createdAt":1787000625030,"transform":{"position":[-45,0,-31],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"One cell","title":"Thirty-seven trillion of these","body":"Every organ 