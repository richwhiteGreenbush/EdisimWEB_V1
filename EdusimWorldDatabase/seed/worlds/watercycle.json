{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T04:49:48.694Z","records":[{"id":"dc2b82a8-da28-441e-9c35-9dd39476f1d0","kind":"world-theme","theme":"watercycle","createdAt":1786942188618,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"0837dbeb-f602-4fb9-a4e1-5790036b88b5","kind":"world-spawn","createdAt":1786942188618,"transform":{"position":[0,0,100],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"8289e6dd-9552-4747-8b5e-8a5686dbd57f","createdAt":1786942188619,"transform":{"position":[62,-0.902025433895346,30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"water-body","options":{"width":74,"depth":62,"seed":23}},{"id":"32279843-901f-49aa-b95d-75ebd863f31c","createdAt":1786942188621,"transform":{"position":[52,0.36223457582830054,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"vapour-column","options":{"height":22,"radius":4,"seed":17}},{"id":"fc030820-49ae-4e24-8804-2e6eb6c56108","createdAt":1786942188623,"transform":{"position":[74,-0.5505768900801917,22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"vapour-column","options":{"height":18,"radius":3.4,"seed":19}},{"id":"8795d7f8-ce39-407f-92b8-d0c83db039f5","createdAt":1786942188624,"transform":{"position":[66,1.3459395241154972,48],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"vapour-column","options":{"height":20,"radius":3.8,"seed":21}},{"id":"a4cb4e12-b6af-470b-a8e0-bb89c6fe0a83","createdAt":1786942188626,"transform":{"position":[46,0.6005979372742676,56],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cycle-arrow","options":{"span":26,"rise":16,"label":"EVAPORATION","sub":"the sun lifts water as invisible vapour","color":4033522}},{"id":"90d0eb79-4074-478f-b60c-b2cf8deecb64","createdAt":1786942188627,"transform":{"position":[38,0.03247497801634314,44],"rotation":[0,-0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Stage 1","title":"Evaporation","accent":"#3d8bf2","body":"The sun heats the surface and water leaves it as a gas. You cannot see water vapour — the wisps here stand in for something genuinely invisible. About 90% of the water in the air came off the oceans this way; the rest came out of plants."}},{"id":"b4ee7638-e378-49cf-9333-71fbd0d48888","createdAt":1786942188627,"transform":{"position":[6,62,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cumulus-cloud","options":{"size":46,"height":22,"seed":7}},{"id":"2afd81cb-de73-4404-9b68-a11a8c5de80c","createdAt":1786942188627,"transform":{"position":[-34,58,-26],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cumulus-cloud","options":{"size":38,"height":18,"seed":11}},{"id":"89155eef-a86f-4351-b934-2257a8732ae6","createdAt":1786942188627,"transform":{"position":[46,60,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cumulus-cloud","options":{"size":34,"height":16,"seed":13}},{"id":"6e6178a6-e344-44f9-8a94-322978c6f61a","createdAt":1786942188627,"transform":{"position":[-70,56,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cumulus-cloud","options":{"size":40,"height":19,"seed":27,"dark":true}},{"id":"27e92bb9-21c9-4502-9324-2cd777830202","createdAt":1786942188628,"transform":{"position":[26,-0.0012949954708210143,-4],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cycle-arrow","options":{"span":24,"rise":14,"label":"CONDENSATION","sub":"vapour cools and turns back into droplets","color":8019920}},{"id":"3308b4f2-9ce5-44f5-9795-13edaf28191c","createdAt":1786942188629,"transform":{"position":[20,-1.7763568394002505e-15,8],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Stage 2","title":"Condensation","accent":"#7a5fd0","body":"Air cools as it rises. Cold air holds less vapour, so at a certain height the water turns back into liquid droplets around specks of dust — and that is a cloud. Look at the bottoms: they are all flat, and all at the same height. That height is where the air got cold enough."}},{"id":"2e10a551-a894-4282-9761-5bed91a44752","createdAt":1786942188629,"transform":{"position":[-70,10,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"rain-curtain","options":{"radius":15,"height":44,"count":300,"seed":13}},{"id":"094b7553-1bdb-4e3c-ad40-c62aad8301d4","createdAt":1786942188630,"transform":{"position":[-46,-0.4546434436815123,2],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cycle-arrow","options":{"span":24,"rise":13,"label":"PRECIPITATION","sub":"drops get too heavy to stay up","color":3120783}},{"id":"48f9bd0f-16e2-4ce1-8f89-782bb6c6494e","createdAt":1786942188632,"transform":{"position":[-44,-0.3473568732731671,16],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Stage 3","title":"Precipitation","accent":"#2f9e8f","body":"A cloud droplet is far too small to fall — it would take days to reach the ground and would evaporate first. Rain happens when about a million of them collide and merge into one drop. Higher up and colder, the same process makes snow and hail."}},{"id":"fac61a51-7123-4547-885e-be6b70425d51","createdAt":1786942188633,"transform":{"position":[-104,1.5025441583983268,-52],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mountain-peak","options":{"height":52,"radius":38,"seed":29,"snowline":0.52}},{"id":"fff2b509-bdd4-4a21-b562-eed964faca42","createdAt":1786942188634,"transform":{"position":[-150,3.0216531753540083,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mountain-peak","options":{"height":34,"radius":26,"seed":33,"snowline":0.62}},{"id":"8739d2ab-5b7d-428d-958e-e5eec6f2f68a","createdAt":1786942188635,"transform":{"position":[-78,-2.8521461818891125,6],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"stream-course","options":{"length":70,"drop":9,"width":4.5,"seed":31,"bends":3}},{"id":"c21f12e5-2f92-4c51-b142-afccc5f2a478","createdAt":1786942188636,"transform":{"position":[-44,-0.8763484745870365,48],"rotation":[0,-1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"stream-course","options":{"length":64,"drop":5,"width":6,"seed":35,"bends":2}},{"id":"bc16fab8-63fa-4a5f-aae3-0d434a806da0","createdAt":1786942188638,"transform":{"position":[-84,-3.7744389249694863,26],"rotation":[0,0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Stage 4","title":"Collection and runoff","accent":"#8a93a8","body":"Snow on a mountain is water in storage — sometimes for months, sometimes for thousands of years. When it melts it runs downhill, gathers into streams and rivers, and heads back to the sea. Look at where the snow stops: that line is where it is cold enough for snow to survive the summer."}},{"id":"70530583-da4c-493e-b117-7cbf73349b79","createdAt":1786942188639,"transform":{"position":[-30,-0.8085487208971069,62],"rotation":[0,1.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cycle-arrow","options":{"span":26,"rise":11,"label":"COLLECTION","sub":"rivers carry it back to the sea","color":3108520}},{"id":"4ac9aed6-afbf-49d3-8af0-067bab593e2d","createdAt":1786942188640,"transform":{"position":[-34,-0.9741113420387748,64],"rotation":[0,0.55,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"groundwater-cutaway","options":{"width":24,"height":10,"depth":8,"seed":37}},{"id":"80646bc4-dbcb-4788-a525-6bc8db7d1254","createdAt":1786942188641,"transform":{"position":[-20,-0.45745503902436857,70],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Where the rest of it goes","title":"Groundwater","accent":"#a08a63","body":"Not all rain runs off. Much of it soaks down through soil and porous rock until it reaches a layer water cannot pass, and collects there. That is the water table, and it is where a well gets its water. It moves — but slowly: a few feet a day, not a few feet a second."}},{"id":"5ec04c86-b0b7-4e70-a963-75a207266625","createdAt":1786942188643,"transform":{"position":[-16,0.007250653021579456,30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":22,"seed":60}},{"id":"06870e3d-76aa-4de7-a222-9de0513603b2","createdAt":1786942188644,"transform":{"position":[-26,-0.0040311318792638495,22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":26,"seed":65}},{"id":"928ba2bb-2e20-4590-b471-fc2fb5e92705","createdAt":1786942188645,"transform":{"position":[-6,0.003910499204367479,26],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":30,"seed":70}},{"id":"e70e2ea3-281f-40c1-a13a-7b7673ae2bfe","createdAt":1786942188646,"transform":{"position":[-34,-0.22984876625545114,34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":22,"seed":75}},{"id":"0faf7a23-3ff0-41b6-b54d-3c352b0b80dc","createdAt":1786942188648,"transform":{"position":[-20,-0.1208109715736283,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":26,"seed":80}},{"id":"baa4d93b-3d69-4325-92a6-111e648c8c9c","createdAt":1786942188649,"transform":{"position":[4,0.07923012117199546,34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":30,"seed":85}},{"id":"802bebef-b5bf-4069-a30b-b02a9db2b9cd","createdAt":1786942188650,"transform":{"position":[-42,-0.3325949932919756,26],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":22,"seed":90}},{"id":"98d79ad8-6128-49b7-9ab5-644201e64d36","createdAt":1786942188650,"transform":{"position":[-22,20,30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"vapour-column","options":{"height":14,"radius":3,"seed":43,"tint":14348514}},{"id":"1aa721cf-6fad-4817-aff4-1611c6877367","createdAt":1786942188650,"transform":{"position":[-6,20,27],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"vapour-column","options":{"height":12,"radius":2.6,"seed":45,"tint":14348514}},{"id":"ed8fe399-a0d4-473f-81f5-cd124f5bd1f3","createdAt":1786942188651,"transform":{"position":[-16,-3.552713678800501e-15,16],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cycle-arrow","options":{"span":20,"rise":12,"label":"TRANSPIRATION","sub":"plants breathe water out too","color":5151807}},{"id":"ea81a09c-2761-4817-971e-b372c7c5786b","createdAt":1786942188653,"transform":{"position":[-6,-3.1086244689504383e-15,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Stage 5","title":"Transpiration","accent":"#4e9c3f","body":"Plants pull water up from their roots and let it out through tiny pores in their leaves. One large oak moves about 40,000 gallons a year — a whole forest can put more water into the air than a lake of the same size."}},{"id":"62cc4e09-e705-4e43-8488-d0a7c75fbbf3","createdAt":1786942188654,"transform":{"position":[24,0.30824950384586636,88],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE WATER CYCLE"],"subtitle":"Follow the five arrows all the way round — you will finish where you started","width":15,"height":4.2}},{"id":"3c155376-403d-4373-b40f-3ed2396d0dd6","createdAt":1786942188655,"transform":{"position":[-11,-1.2410192420308,86],"rotation":[0,0.7419472680059175,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"65e81a79-28f9-4264-9bf4-d238f1266bd1","createdAt":1786942188656,"transform":{"position":[-11,2.7589807579692,86],"rotation":[0,0.7419472680059175,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"d6c6c8dc-5c82-4aa2-bc8e-7919a849ad2c","createdAt":1786942188658,"transform":{"position":[-24,-0.5911216749494024,80],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Send a cloud across the sky","target":"Click the big white cloud → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"move forward 60 feet","depth":1},{"cat":"control","text":"wait 4 seconds","depth":1},{"cat":"motion","text":"move forward 60 feet","depth":1},{"cat":"control","text":"wait 4 seconds","depth":1}],"tip":"Weather really does travel — in most of the world, west to east. Add a second cloud running at a different speed and you have the thing that makes forecasting hard: they do not all move together.","accent":"#3d8bf2"}},{"id":"241c6ea7-2651-49e3-8ede-6c9096d2af25","createdAt":1786942188659,"transform":{"position":[8,-1.222277969435798,82],"rotation":[0,-0.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Make the rain fall","target":"Click the grey rain under the dark cloud → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move up by -1 feet","depth":2},{"cat":"control","text":"wait 0.05 seconds","depth":2},{"cat":"motion","text":"go back to start","depth":1}],"tip":"Fall a bit at a time, then jump back to the top — which is exactly how a cartoon makes endless rain out of one drawing. \"go back to start\" is what resets it, and it remembers where the rain was when you pressed play. Change -1 to -3 and it becomes a downpour.","accent":"#2f9e8f"}},{"id":"d9736fff-9ed4-4f1c-bd7c-ef49742c3e23","createdAt":1786942188660,"transform":{"position":[30,0.5661185992634095,74],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"path-stones","options":{"length":16,"width":5,"seed":200}},{"id":"895b21e0-a277-44f8-bccf-295436031b30","createdAt":1786942188661,"transform":{"position":[42,0.7076319802232485,60],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"path-stones","options":{"length