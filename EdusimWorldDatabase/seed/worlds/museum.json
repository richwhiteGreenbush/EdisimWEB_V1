transform":{"position":[0,6.900000000000011,-47.8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"framed-painting","options":{"style":"nightsky","title":"Village Under Turning Stars","artistLine":"Post-Impressionism · 1880s","body":"Thick, visible brushstrokes that swirl. These painters cared more about feeling and movement than about copying exactly what the eye sees."}},{"id":"db043d1b-452a-4727-946b-5e293d30885b","createdAt":1786894182343,"transform":{"position":[14,6.900000000000011,-47.8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"framed-painting","options":{"style":"ukiyoe","title":"Great Swell Before the Mountain","artistLine":"Ukiyo-e woodblock · 1830s","body":"Carved into wood, then printed. Flat areas of colour and bold outlines — a Japanese style that later reshaped European painting."}},{"id":"97b289e2-17fd-4238-8e6e-1800c872a190","createdAt":1786894182344,"transform":{"position":[-20.4,6.900000000000006,-24],"rotation":[0,1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"framed-painting","options":{"style":"pointillist","title":"Afternoon on the Riverbank","artistLine":"Pointillism · 1880s","body":"Every colour here is separate dots. Your eye blends them into new colours — the same trick a phone screen uses with red, green and blue pixels."}},{"id":"71a873a8-3a13-4bab-929b-3ac9cf5f4922","createdAt":1786894182345,"transform":{"position":[-20.4,6.900000000000009,-40],"rotation":[0,1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"framed-painting","options":{"style":"colorfield","title":"Three Warm Fields","artistLine":"Colour Field · 1950s","body":"No people, no places, no objects. Just enormous soft-edged rectangles of colour, meant to be stood close to and felt."}},{"id":"120e464e-c1a2-4034-a580-720b113f06d8","createdAt":1786894182347,"transform":{"position":[20.4,6.9000000000000075,-32],"rotation":[0,-1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"framed-painting","options":{"style":"geometric","title":"Improvisation in Circles","artistLine":"Abstract art · 1910s","body":"The first paintings that showed nothing at all from the real world. Shape, colour and line became the subject themselves."}},{"id":"face5b1f-058c-4bfd-94e8-73542dbfedf7","createdAt":1786894182348,"transform":{"position":[-12,12.700000000000005,-24],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"56eef37f-b75d-4ed5-bfaa-1e0371c639f1","createdAt":1786894182350,"transform":{"position":[12,12.700000000000005,-24],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"d01db3fd-0a02-4ea2-84e5-3823c1862e76","createdAt":1786894182351,"transform":{"position":[-12,12.700000000000008,-42],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"bfad3307-ea85-4d90-bf1f-cfe66f00367d","createdAt":1786894182352,"transform":{"position":[12,12.700000000000008,-42],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"cb7f4567-5251-454b-969d-44912e874bc0","createdAt":1786894182354,"transform":{"position":[0,12.700000000000006,-32],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"a1436b85-3218-4e36-8fdd-105794f6f3ad","createdAt":1786894182355,"transform":{"position":[10,1.7000000000000075,-34],"rotation":[0,-0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Set the mobile turning","target":"Click the hanging mobile → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 2 degrees","depth":1}],"tip":"Two degrees a frame is a slow, gallery-ish drift. Try 10 for a fairground spin, or 0.5 if you want visitors to wonder whether it is moving at all.","accent":"#6b3fa0"}},{"id":"0c1409d2-65ad-40e9-b502-f48020d1f40c","createdAt":1786894182356,"transform":{"position":[-7,1.700000000000008,-36],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-pro