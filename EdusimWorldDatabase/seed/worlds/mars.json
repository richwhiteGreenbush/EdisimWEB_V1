{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T04:49:46.376Z","records":[{"id":"39585a51-df06-43a9-9941-48c5bc3e57fe","kind":"world-theme","theme":"mars","createdAt":1786942186287,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"a047492e-9e01-4b8a-a0bb-4a9d858b3c81","kind":"world-spawn","createdAt":1786942186287,"transform":{"position":[0,0,34],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"2b62c3de-8201-4968-876a-6bce3d4db301","createdAt":1786942186290,"transform":{"position":[-8,-5.329070518200751e-15,24],"rotation":[0,0.6747409422235527,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"bb1d383a-a8c6-440f-a9a1-23e567318d98","createdAt":1786942186292,"transform":{"position":[-8,3.9999999999999947,24],"rotation":[0,0.6747409422235527,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"f173f65d-6fc7-4b3d-968e-5edce1811438","createdAt":1786942186293,"transform":{"position":[0,3.1086244689504383e-15,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"habitation-dome","options":{"label":"MARS BASE ONE"}},{"id":"b57cc750-464b-45dd-84a3-a57de183ad51","createdAt":1786942186294,"transform":{"position":[-13,4.884981308350689e-15,-22],"rotation":[0,1.0191413442663497,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"hydroponic-rack","options":{"seed":5}},{"id":"656fa586-ca0e-4c97-b2e1-6b8f1a4911a1","createdAt":1786942186295,"transform":{"position":[-8,6.217248937900877e-15,-28],"rotation":[0,0.5191461142465229,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"hydroponic-rack","options":{"seed":11}},{"id":"22dd8bdf-a759-4ea2-bab2-5574b9f0093c","createdAt":1786942186297,"transform":{"position":[-15,2.886579864025407e-15,-13],"rotation":[0,1.6373644905707205,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"hydroponic-rack","options":{"seed":17}},{"id":"cf8ab6e3-0348-499a-ae65-c72442552683","createdAt":1786942186298,"transform":{"position":[13,4.8849813