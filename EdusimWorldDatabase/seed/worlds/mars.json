82776-f2f3-4af7-92fb-134ccbe7009f","createdAt":1786942186348,"transform":{"position":[56,-0.13711294847499822,24],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-rocks","options":{"count":7,"spread":6,"scale":0.8,"seed":47}},{"id":"8d27beb5-334d-4a67-a425-0b6e53ae095f","createdAt":1786942186349,"transform":{"position":[-14,-1.0729077777843927,-70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-rocks","options":{"count":11,"spread":10,"scale":1.2,"seed":53}},{"id":"2f8b82df-48f3-4103-a695-94c08ca091df","createdAt":1786942186351,"transform":{"position":[-150,0.8907836675644287,-165],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distant-mountain","options":{"height":46,"baseRadius":130}},{"id":"2c20b68a-1454-4938-8c26-764400caa8c8","createdAt":1786942186352,"transform":{"position":[155,2.490335345268287,-135],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distant-mountain","options":{"height":34,"baseRadius":92,"caldera":false,"color":9392689}},{"id":"34a949cc-0b1a-4d49-ab36-7ea54525b376","createdAt":1786942186353,"transform":{"position":[-55,-1.372280333847169,178],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distant-mountain","options":{"height":28,"baseRadius":80,"caldera":false,"color":9721658}},{"id":"6007b79e-c6be-4ccb-b69a-c3dd64dbab3e","createdAt":1786942186353,"transform":{"position":[118,138,-228],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"phobos-in-sky","options":{"radius":6}},{"id":"92272fcd-587e-4199-b359-c42eb74a2c15","createdAt":1786942186354,"transform":{"position":[-13,-3.774758283725532e-15,17],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-13,"z":17,"rotY":0.35,"eyebrow":"Welcome","title":"You are a long way from home","body":"Mars is between 34 and 250 million miles away depending on where the two planets are. Even the fast trips take about seven months each way."}},{"id":"983a7f3d-f936-4be4-a82d-a8d20a30d163","createdAt":1786942186356,"transform":{"position":[14,-4.884981308350689e-15,22],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":14,"z":22,"rotY":-0.35,"eyebrow":"Look up","title":"Why the sky is butterscotch","body":"Fine dust in the air scatters the red end of sunlight all over the sky. The strange part: at sunset it flips, and the glow around the setting sun turns BLUE."}},{"id":"e10980e0-754b-42e3-82a1-ffb7b3421dc8","createdAt":1786942186357,"transform":{"position":[-26,-6.439293542825908e-15,29],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-26,"z":29,"rotY":0.5,"eyebrow":"Gravity","title":"You would weigh a third","body":"Mars pulls with about 38% of Earth's gravity. A 100-pound student weighs 38 pounds here — and could jump nearly three times as high."}},{"id":"6871b038-dff6-4636-b7c9-ff661f71fadc","createdAt":1786942186358,"transform":{"position":[-50,-0.15220216878800175,34],"rotation":[0,0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-50,"z":34,"rotY":0.7,"eyebrow":"On the horizon","title":"The biggest volcano anywhere","body":"Olympus Mons is about 16 miles high and as wide as Arizona — but its slopes are so gentle that standing on it, you would never know you were on a mountain."}},{"id":"b0b552d1-a0e7-4df2-a9e1-eeae392eff39","createdAt":1786942186359,"transform":{"position":[-34,0,0],"rotation":[0,-1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-34,"z":0,"rotY":-1.1,"eyebrow":"The greenhouse","title":"Farming without soil","body":"Martian dirt contains perchlorates, which are poisonous to us. Crops here are grown in trays of water instead — and every plant also helps recycle the air."}},{"id":"03d10b5d-6dee-4a7b-a16b-e6626ea15f28","createdAt":1786942186360,"transform":{"position":[45,-0.001757049519243381,-24],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":45,"z":-24,"rotY":-0.3,"eyebrow":"The drill","title":"There is ice under your feet","body":"Buried water ice covers much of Mars. It is drinking water, it is breathable oxygen, and split into hydrogen and oxygen it is rocket fuel for the trip home."}},{"id":"1823e31c-5e0c-4e47-8388-00577d196735","createdAt":1786942186362,"transform":{"position":[22,-1.7763568394002505e-15,8],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":22,"z":8,"rotY":-0.6,"eyebrow":"The relay dish","title":"Nobody phones home","body":"A radio signal takes 3 to 22 minutes each way. Ask Earth a question and the answer is at best six minutes behind you, so crews send messages, not conversations."}},{"id":"0b03f514-bb68-4067-b199-245507b41cdb","createdAt":1786942186363,"transform":{"position":[-33,-3.1086244689504383e-15,14],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-33,"z":14,"rotY":-0.5,"eyebrow":"Power","title":"Sunlight, and a dust problem","body":"Mars gets less than half the sunlight Earth does, and dust settling on the panels steals more. Planet-wide dust storms can dim the sky for months at a time."}},{"id":"69bc8444-91fb-470a-83c1-7e54a9591516","createdAt":1786942186364,"transform":{"position":[38,-3.9968028886505635e-15,18],"rotation":[0,-2.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":38,"z":18,"rotY":-2.2,"eyebrow":"The rover","title":"Wheels made of metal","body":"About 10 feet long — twice your height. The wheels are milled from aluminium, because rubber goes brittle at −100°F and would fall apart in the near-vacuum."}},{"id":"7026a752-100d-431c-8388-2c0b5970a172","createdAt":1786942186365,"transform":{"position":[21,-7.993605777301127e-15,36],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":21,"z":36,"rotY":0.2,"eyebrow":"The scout","title":"First flight on another world","body":"The air here is 1% as thick as Earth's, so the blades have to spin about 2,400 times a minute — five times a helicopter at home — to find anything to push against."}},{"id":"c5028de4-36f4-4fe5-a763-56023f2517cc","createdAt":1786942186367,"transform":{"position":[20,-8.881784197001252e-16,4],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":20,"z":4,"rotY":-0.4,"eyebrow":"The weather mast","title":"Wind you would barely feel","body":"A 60 mph Martian gale pushes about as hard as a 4 mph breeze on Earth, because there is so little air in it. The movie version of a Mars storm is fiction."}},{"id":"d99e7dda-17ae-4815-95d7-9a605eb17cd4","createdAt":1786942186368,"transform":{"position":[39,-8.881784197001252e-16,4],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":39,"z":4,"rotY":-0.8,"eyebrow":"Two moons","title":"Phobos and Deimos","body":"Both are tiny lumps, probably captured asteroids. Phobos races around so fast that it rises in the WEST and sets in the east — twice every single day."}},{"id":"42beb7e1-9ad2-407d-9161-6dabeffdb71c","createdAt":1786942186369,"transform":{"position":[-17,8.659739592076221e-15,-39],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-17,"z":-39,"rotY":0.6,"eyebrow":"The cargo lander","title":"How all this got here","body":"Nothing was carried by the crew. Supplies are landed years ahead, unmanned, and checked from Earth — so the base is already built and working before anyone arrives."}},{"id":"7ed9cb86-7c19-456c-a253-9d4ca6d4cf22","createdAt":1786942186370,"transform":{"position":[16,7.549516567451064e-15,-34],"rotation":[0,-2.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":16,"z":-34,"rotY":-2.6,"eyebrow":"The calendar","title":"A year that lasts 687 days","body":"Mars is further out, so its orbit takes almost twice as long. You would have birthdays half as often — and each of the four seasons lasts about six Earth months."}},{"id":"83b3b791-7143-4ce1-a20e-b35f69adbae3","createdAt":1786942186371,"transform":{"position":[-49,0.1290743316204046,-46],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-49,"z":-46,"rotY":0.5,"eyebrow":"Geology","title":"Why Mars is red","body":"The dust is full of iron oxide. That is rust — the same thing that forms on an old bicycle, spread across an entire planet and blown into every corner of it."}},{"id":"47f5369c-55bd-4834-b404-25cccb9cf78c","createdAt":1786942186372,"transform":{"position":[-40,5.000000000000002,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"9f79ebee-95f7-44a1-a2a2-9a86cbfbcdb7","createdAt":1786942186374,"transform":{"position":[-30,5.991951542071414,-42],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"5c144a9c-7a03-4618-979b-88486101062d","createdAt":1786942186375,"transform":{"position":[0,5.9999999999999964,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"9b025cc7-884e-4895-9211-fb089dead063","createdAt":1786942186376,"transform":{"position":[36,7.000000000000007,-32],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}