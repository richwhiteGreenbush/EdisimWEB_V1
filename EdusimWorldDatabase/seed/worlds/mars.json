{"format":"edusim-world","version":1,"exportedAt":1786894182651,"records":[{"id":"2b9d595c-0f97-43d4-9702-8fa74b3f82c6","kind":"world-theme","theme":"mars","createdAt":1786894182561,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"34828c2c-84d1-4002-aa4e-f268b8f112fa","createdAt":1786894182563,"transform":{"position":[-8,-5.329070518200751e-15,24],"rotation":[0,0.6747409422235527,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"68cf124b-d6d6-4f8c-8434-b661b92f5988","createdAt":1786894182564,"transform":{"position":[-8,3.9999999999999947,24],"rotation":[0,0.6747409422235527,0],"scale":[1,1,1]},"kind":"web-browser","url":"https://richwhitegreenbush.github.io/EdisimWEB_V1"},{"id":"f68159e5-ce99-4c6e-82c0-c88d12375ab6","createdAt":1786894182565,"transform":{"position":[0,3.1086244689504383e-15,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"habitation-dome","options":{"label":"MARS BASE ONE"}},{"id":"08e7a02f-c498-40e7-bdd4-6461156aa87c","createdAt":1786894182566,"transform":{"position":[-13,4.884981308350689e-15,-22],"rotation":[0,1.0191413442663497,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"hydroponic-rack","options":{"seed":5}},{"id":"ec473af6-081b-4c8e-a5f7-77af61a707a1","createdAt":1786894182568,"transform":{"position":[-8,6.217248937900877e-15,-28],"rotation":[0,0.5191461142465229,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"hydroponic-rack","options":{"seed":11}},{"id":"90d08dda-461b-4549-b4ff-1fe0d9fdfe3b","createdAt":1786894182569,"transform":{"position":[-15,2.886579864025407e-15,-13],"rotation":[0,1.6373644905707205,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"hydroponic-rack","options":{"seed":17}},{"id":"0e08502a-4a35-45af-b4e5-536aaf72d8a7","createdAt":1786894182570,"transform":{"position":[13,4.884981308350689e-15,-22],"rotation":[0,-1.0191413442663497,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bunk-pod","options":{}},{"id":"eba45b65-7071-4a2c-94e0-95f1800cda32","createdAt":1786894182571,"transform":{"position":[15,2.6645352591003757e-15,-12],"rotation":[0,-1.7033478590915707,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bunk-pod","options":{}},{"id":"43ef1376-2b8d-4e52-9e85-4053e2cc7ca0","createdAt":1786894182573,"transform":{"position":[5,6.439293542825908e-15,-29],"rotation":[0,-0.3217505543966422,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"life-support-rack","options":{}},{"id":"db4df1aa-3add-49c2-978c-52dd49d699e7","createdAt":1786894182574,"transform":{"position":[10,1.1102230246251565e-15,-5],"rotation":[0,-2.3036114285814033,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"command-console","options":{}},{"id":"f1a5d722-376f-4836-b2c6-5fcff238d542","createdAt":1786894182575,"transform":{"position":[-4,2.4424906541753444e-15,-11],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{}},{"id":"106ff6d7-3d93-45de-8726-a8ff0d804f41","createdAt":1786894182576,"transform":{"position":[4,2.4424906541753444e-15,-11],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{}},{"id":"d19cd79d-5cc6-46c7-a8ac-e6a34efcfad2","createdAt":1786894182577,"transform":{"position":[-9,3.3306690738754696e-15,-15],"rotation":[0,1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-9,"z":-15,"rotY":1.1,"eyebrow":"The grow bay","title":"Dinner under pink light","body":"No soil — the roots sit in nutrient water. The lights are magenta because plants only use the red and blue parts of sunlight; the green is reflected, which is why leaves look green."}},{"id":"54de2dbf-5070-450f-a523-aea5609890e6","createdAt":1786894182579,"transform":{"position":[-1,5.329070518200751e-15,-24],"rotation":[0,-0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-1,"z":-24,"rotY":-0.2,"eyebrow":"Life support","title":"Oxygen out of thin air","body":"Martian air is 95% carbon dioxide. Split CO₂ and you get carbon and the O₂ you breathe. NASA really did this on Mars in 2021, with an instrument the size of a toaster."}},{"id":"4883977f-7ee7-47c0-9668-e927b75e669c","createdAt":1786894182580,"transform":{"position":[11,3.552713678800501e-15,-16],"rotation":[0,-1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":11,"z":-16,"rotY":-1,"eyebrow":"Crew quarters","title":"A day and a bit","body":"A Martian day — a \"sol\" — is 24 hours 37 minutes. Close enough to sleep by, but the extra 37 minutes add up: crews drift a whole night out of step with Earth in about a month."}},{"id":"1582fa1c-0c97-4c96-927b-a9a9255bbe09","createdAt":1786894182581,"transform":{"position":[-7,-6.661338147750939e-16,3],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-7,"z":3,"rotY":0.3,"eyebrow":"Why the dome","title":"The air is the problem","body":"Outside, the pressure is under 1% of Earth's — so low that the water in your blood would boil. The dome is not for warmth. It is holding an atmosphere in."}},{"id":"be1e8e0b-05be-486c-aeee-ed8be793e32c","createdAt":1786894182582,"transform":{"position":[0,9.000000000000004,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"3fe28094-b9ef-4824-8942-c48af3ae7c28","createdAt":1786894182584,"transform":{"position":[-12,9.000000000000004,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#e0455f"},{"id":"46ad486b-d860-4d8d-8668-3ddd5ef73c2b","createdAt":1786894182585,"transform":{"position":[12,9.000000000000004,-18],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"759442e0-fcfc-4adc-97fe-392ba5f81dcf","createdAt":1786894182586,"transform":{"position":[2,9.000000000000007,-28],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"ef0a42e5-6ac3-45b5-aa6e-3d335acb0435","createdAt":1786894182587,"transform":{"position":[0,9,-2],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"4722f2e1-9a78-45c7-bf58-35a6e7d9b388","createdAt":1786894182589,"transform":{"position":[-23,-4.884981308350689e-15,22],"rotation":[0,0.45,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["MARS BASE ONE"],"subtitle":"ARES PLANITIA · SOL 412 · CREW OF SIX","width":13,"height":3.2,"postHeight":7.5,"face":"#3a1d12","accent":"#ff9a5c"}},{"id":"4243b941-f9bd-44b1-b48b-3768090cf840","createdAt":1786894182590,"transform":{"position":[-40,1.7763568394002505e-15,-8],"rotation":[0,0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"greenhouse-tunnel","options":{}},{"id":"781a3d73-7f9c-4f20-8857-2c4023869bc0","createdAt":1786894182591,"transform":{"position":[36,7.105427357601002e-15,-32],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"ice-drill-rig","options":{}},{"id":"6ef7bc0f-92af-4d4c-abb1-ffb9ba99ad1b","createdAt":1786894182592,"transform":{"position":[30,-2.6645352591003757e-15,12],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"comms-relay","options":{}},{"id":"827affdf-641e-4316-bb8a-067c6e1a31bc","createdAt":1786894182594,"transform":{"position":[-30,-0.08221197304759542,-48],"rotation":[0,0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-lander","options":{}},{"id":"bbef8761-ac2f-4cff-997f-19b34a5fbef0","createdAt":1786894182595,"transform":{"position":[26,1.3322676295501878e-15,-6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"weather-mast","options":{}},{"id":"e11fc73e-7cea-423c-a3a3-223a3c94b9b2","createdAt":1786894182596,"transform":{"position":[-40,-5.773159728050814e-15,26],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"solar-array","options":{}},{"id":"3ca5b3b2-ab06-4690-abd6-ca77f05865da","createdAt":1786894182598,"transform":{"position":[-62,-0.47637900717249115,6],"rotation":[0,-0.15,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"solar-array","options":{}},{"id":"b1e740ec-fc12-4c63-b4f3-d7405214a536","createdAt":1786894182599,"transform":{"position":[-52,-0.0262613022233249,-34],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"solar-array","options":{}},{"id":"4e14d5fc-e2d8-49ed-a8a8-110866181c33","createdAt":1786894182600,"transform":{"position":[28,-4.884981308350689e-15,22],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-rover","options":{}},{"id":"c55966dc-b8f1-4a5f-bbe7-b1509f0aa4e5","createdAt":1786894182601,"transform":{"position":[10,-7.993605777301127e-15,36],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"rover-tracks","options":{"count":20,"seed":7}},{"id":"a51cd0ef-f286-4c91-ae25-e7d4b6089909","createdAt":1786894182603,"transform":{"position":[36,-6.217248937900877e-15,28],"rotation":[0,-2.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Send the rover out on survey","target":"Click the six-wheeled rover → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move Z by -0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move Z by 0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Real Mars rovers crawl. Curiosity averages about 100 feet an HOUR, because every step has to be checked from Earth first — and Earth is up to 22 light-minutes away.","accent":"#c2521f"}},{"id":"6956c343-9747-4b80-932e-b8b825f90b4b","createdAt":1786894182604,"transform":{"position":[16,-6.661338147750939e-15,30],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-helicopter","options":{}},{"id":"51279e3c-cbee-4721-a889-419d4d663f96","createdAt":1786894182605,"transform":{"position":[8,-9.325873406851315e-15,42],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Fly the scout copter","target":"Click the little helicopter → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 10 times","depth":1},{"cat":"motion","text":"move Y by 0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2},{"cat":"control","text":"repeat 10 times","depth":1},{"cat":"motion","text":"move Y by -0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2}],"tip":"Up four feet, hover, back down. move Y is the only block that goes UP — and on Mars getting off the ground is the hard part, because there is barely any air for the blades to push against.","accent":"#1f6b8a"}},{"id":"86374263-0d5d-4201-a7cf-73d3d7595e69","createdAt":1786894182606,"transform":{"position":[-76,2.754159395560714,-70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dust-devil","options":{"height":46,"radius":7}},{"id":"1582249f-52cc-42b0-b8d4-edb95364661c","createdAt":1786894182608,"transform":{"position":[92,0.7943909470397661,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dust-devil","options":{"height":34,"radius":5}},{"id":"322d2c6f-8f90-4e60-92b0-fd6ac5444ba8","createdAt":1786894182609,"transform":{"position":[-60,-0.696919128671655,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-crater","options":{"radius":20,"rimHeight":2.2,"seed":3}},{"id":"374091b6-338f-4eb4-856b-9b753b8975fd","createdAt":1786894182610,"transform":{"position":[70,1.1268937587738193,-70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-crater","options":{"radius":26,"rimHeight":2.2,"seed":7}},{"id":"e7bdfbfd-ac5f-43e4-879c-bac1c3d34456","createdAt":1786894182611,"transform":{"position":[-74,1.8797439706855377,-60],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-crater","options":{"radius":16,"rimHeight":2.2,"seed":11}},{"id":"d812432