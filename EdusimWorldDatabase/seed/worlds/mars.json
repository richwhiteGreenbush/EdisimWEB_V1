on":[0,-0.15,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"solar-array","options":{}},{"id":"cd40ceed-6761-4549-bd2d-f5170f232478","createdAt":1786942186326,"transform":{"position":[-52,-0.0262613022233249,-34],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"solar-array","options":{}},{"id":"6acb3f52-b4ad-4894-b814-052b94eaa269","createdAt":1786942186327,"transform":{"position":[28,-4.884981308350689e-15,22],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-rover","options":{}},{"id":"248180a8-d756-492c-962b-de478b4fe438","createdAt":1786942186329,"transform":{"position":[10,-7.993605777301127e-15,36],"rotation":[0,-0.9,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"rover-tracks","options":{"count":20,"seed":7}},{"id":"8e03ed8e-2f69-47ca-98db-4f2f3e04f88c","createdAt":1786942186330,"transform":{"position":[36,-6.217248937900877e-15,28],"rotation":[0,-2.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Send the rover out on survey","target":"Click the six-wheeled rover → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move forward 0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"control","text":"repeat 20 times","depth":1},{"cat":"motion","text":"move forward 0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Real Mars rovers crawl. Curiosity averages about 100 feet an HOUR, because every step has to be checked from Earth first — and Earth is up to 22 light-minutes away.","accent":"#c2521f"}},{"id":"3c136d1f-ddef-47ea-acc4-d9b7321eab45","createdAt":1786942186331,"transform":{"position":[16,-6.661338147750939e-15,30],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-helicopter","options":{}},{"id":"0b91a888-b6df-4ecf-94c0-7e2b6932ca9d","createdAt":1786942186332,"transform":{"position":[8,-9.325873406851315e-15,42],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Fly the scout copter","target":"Click the little helicopter → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"control","text":"repeat 10 times","depth":1},{"cat":"motion","text":"move up by 0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2},{"cat":"control","text":"repeat 10 times","depth":1},{"cat":"motion","text":"move up by -0.4 feet","depth":2},{"cat":"control","text":"wait 0.1 seconds","depth":2}],"tip":"Up four feet, hover, back down — a negative number in move up goes down. On Mars getting off the ground is the hard part: the air is so thin the blades have almost nothing to push against, which is why the real Ingenuity had to spin at 2,500 rpm.","accent":"#1f6b8a"}},{"id":"bb827715-cf9c-49b5-a098-cbffafa9753f","createdAt":1786942186333,"transform":{"position":[-76,2.754159395560714,-70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dust-devil","options":{"height":46,"radius":7}},{"id":"40e5653c-c425-47eb-907a-12f4129fce03","createdAt":1786942186335,"transform":{"position":[92,0.7943909470397661,-34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dust-devil","options":{"height":34,"radius":5}},{"id":"f7aa0439-b326-4dc8-b785-1928e3bca51f","createdAt":1786942186336,"transform":{"position":[-60,-0.696919128671655,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-crater","options":{"radius":20,"rimHeight":2.2,"seed":3}},{"id":"ec9c1a5d-9985-43f9-9f1e-5b945a2a0f09","createdAt":1786942186337,"transform":{"position":[70,1.1268937587738193,-70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-crater","options":{"radius":26,"rimHeight":2.2,"seed":7}},{"id":"63f90c6b-38a0-414d-a6d9-8589769ef637","createdA