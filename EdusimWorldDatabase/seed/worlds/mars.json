spread":6,"scale":0.8,"seed":47}},{"id":"5ece9b64-6df8-4b30-b0a4-5d7509948547","createdAt":1786894182623,"transform":{"position":[-14,-1.0729077777843927,-70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"mars-rocks","options":{"count":11,"spread":10,"scale":1.2,"seed":53}},{"id":"cf08e6ac-b08c-4d3f-8cc5-3961fd898090","createdAt":1786894182624,"transform":{"position":[-150,0.8907836675644287,-165],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distant-mountain","options":{"height":46,"baseRadius":130}},{"id":"eab38b9a-3135-44f8-9993-6d2e6ce80492","createdAt":1786894182625,"transform":{"position":[155,2.490335345268287,-135],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distant-mountain","options":{"height":34,"baseRadius":92,"caldera":false,"color":9392689}},{"id":"9f4bc3f2-1528-402c-a1d6-7ced7993c701","createdAt":1786894182627,"transform":{"position":[-55,-1.372280333847169,178],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"distant-mountain","options":{"height":28,"baseRadius":80,"caldera":false,"color":9721658}},{"id":"8e99cc4f-e6ff-44a6-93ce-276eabcd6b1f","createdAt":1786894182627,"transform":{"position":[118,138,-228],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"phobos-in-sky","options":{"radius":6}},{"id":"d586fb53-b906-4482-96d1-50a5e3e2bc01","createdAt":1786894182628,"transform":{"position":[-13,-3.774758283725532e-15,17],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-13,"z":17,"rotY":0.35,"eyebrow":"Welcome","title":"You are a long way from home","body":"Mars is between 34 and 250 million miles away depending on where the two planets are. Even the fast trips take about seven months each way."}},{"id":"71714b48-7bc9-4710-83de-4d766eea3874","createdAt":1786894182629,"transform":{"position":[14,-4.884981308350689e-15,22],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":14,"z":22,"rotY":-0.35,"eyebrow":"Look up","title":"Why the sky is butterscotch","body":"Fine dust in the air scatters the red end of sunlight all over the sky. The strange part: at sunset it flips, and the glow around the setting sun turns BLUE."}},{"id":"7f6739f4-ff4a-46a1-97a1-f066060173c7","createdAt":1786894182630,"transform":{"position":[-26,-6.439293542825908e-15,29],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-26,"z":29,"rotY":0.5,"eyebrow":"Gravity","title":"You would weigh a third","body":"Mars pulls with about 38% of Earth's gravity. A 100-pound student weighs 38 pounds here — and could jump nearly three times as high."}},{"id":"390aa7ff-9904-43a5-a23f-c8083df0448f","createdAt":1786894182632,"transform":{"position":[-50,-0.15220216878800175,34],"rotation":[0,0.7,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-50,"z":34,"rotY":0.7,"eyebrow":"On the horizon","title":"The biggest volcano anywhere","body":"Olympus Mons is about 16 miles high and as wide as Arizona — but its slopes are so gentle that standing on it, you would never know you were on a mountain."}},{"id":"2c93f9fe-3066-4104-a407-a27eb88e49fe","createdAt":1786894182633,"transform":{"position":[-34,0,0],"rotation":[0,-1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-34,"z":0,"rotY":-1.1,"eyebrow":"The greenhouse","title":"Farming without soil","body":"Martian dirt contains perchlorates, which are poisonous to us. Crops here are grown in trays of water instead — and every plant also helps recycle the air."}},{"id":"3e5e4ce6-de3f-4c34-a22d-7f8a3022f36a","createdAt":1786894182634,"transform":{"position":[45,-0.001757049519243381,-24],"rotation":[0,-0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":45,"z":-24,"rotY":-0.3,"eyebrow":"The drill","title":"There is ice under your feet","body":"Buried water ice covers much of Mars. It is drinking water, it is breathable oxygen, and split into hydrogen and oxygen it is rocket fuel for the trip home."}},{"id":"5faf00dd-7427-49a6-a012-3118f6732952","createdAt":1786894182635,"transform":{"position":[22,-1.7763568394002505e-15,8],"rotation":[0,-0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":22,"z":8,"rotY":-0.6,"eyebrow":"The relay dish","title":"Nobody phones home","body":"A radio signal takes 3 to 22 minutes each way. Ask Earth a question and the answer is at best six minutes behind you, so crews send messages, not conversations."}},{"id":"2bb327fe-d533-4a8d-88f3-ddc7df87ab03","createdAt":1786894182637,"transform":{"position":[-33,-3.1086244689504383e-15,14],"rotation":[0,-0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-33,"z":14,"rotY":-0.5,"eyebrow":"Power","title":"Sunlight, and a dust problem","body":"Mars gets less than half the sunlight Earth does, and dust settling on the panels steals more. Planet-wide dust storms can dim the sky for months at a time."}},{"id":"ed2bfe0b-6744-48c7-b700-0269ff1f7799","createdAt":1786894182638,"transform":{"position":[38,-3.9968028886505635e-15,18],"rotation":[0,-2.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":38,"z":18,"rotY":-2.2,"eyebrow":"The rover","title":"Wheels made of metal","body":"About 10 feet long — twice your height. The wheels are milled from aluminium, because rubber goes brittle at −100°F and would fall apart in the near-vacuum."}},{"id":"7ec62145-f75e-4f6d-a2c6-fc78a7cb1fdf","createdAt":1786894182639,"transform":{"position":[21,-7.993605777301127e-15,36],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":21,"z":36,"rotY":0.2,"eyebrow":"The scout","title":"First flight on another world","body":"The air here is 1% as thick as Earth's, so the blades have to spin about 2,400 times a minute — five times a helicopter at home — to find anything to push against."}},{"id":"fc584acf-7dc3-4711-a59a-bc71aab6a1de","createdAt":1786894182641,"transform":{"position":[20,-8.881784197001252e-16,4],"rotation":[0,-0.4,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":20,"z":4,"rotY":-0.4,"eyebrow":"The weather mast","title":"Wind you would barely feel","body":"A 60 mph Martian gale pushes about as hard as a 4 mph breeze on Earth, because there is so little air in it. The movie version of a Mars storm is fiction."}},{"id":"fb6468ac-8211-4fec-9f67-2492d7f10a23","createdAt":1786894182642,"transform":{"position":[39,-8.881784197001252e-16,4],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":39,"z":4,"rotY":-0.8,"eyebrow":"Two moons","title":"Phobos and Deimos","body":"Both are tiny lumps, probably captured asteroids. Phobos races around so fast that it rises in the WEST and sets in the east — twice every single day."}},{"id":"4857cf0f-86e6-472c-a885-1f1a652311f2","createdAt":1786894182643,"transform":{"position":[-17,8.659739592076221e-15,-39],"rotation":[0,0.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-17,"z":-39,"rotY":0.6,"eyebrow":"The cargo lander","title":"How all this got here","body":"Nothing was carried by the crew. Supplies are landed years ahead, unmanned, and checked from Earth — so the base is already built and working before anyone arrives."}},{"id":"77168b15-af9b-4e43-b70a-c79804dc8bc0","createdAt":1786894182645,"transform":{"position":[16,7.549516567451064e-15,-34],"rotation":[0,-2.6,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":16,"z":-34,"rotY":-2.6,"eyebrow":"The calendar","title":"A year that lasts 687 days","body":"Mars is further out, so its orbit takes almost twice as long. You would have birthdays half as often — and each of the four seasons lasts about six Earth months."}},{"id":"d1a00d8b-bce8-4c46-92a9-62fac955fbd6","createdAt":1786894182646,"transform":{"position":[-49,0.1290743316204046,-46],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"x":-49,"z":-46,"rotY":0.5,"eyebrow":"Geology","title":"Why Mars is red","body":"The dust is full of iron oxide. That is rust — the same thing that forms on an old bicycle, spread across an entire planet and blown into every corner of it."}},{"id":"b09b9141-2ab9-486a-96c0-aa5f4f9b2437","createdAt":1786894182647,"transform":{"position":[-40,5.000000000000002,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"832f2a1f-a695-4090-bfaf-16ac799f7fb4","createdAt":1786894182648,"transform":{"position":[-30,5.991951542071414,-42],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"ab414350-c64f-4424-b293-1c024d68d7c2","createdAt":1786894182650,"transform":{"position":[0,5.9999999999999964,14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"76ed81c1-9bd7-4b61-ad2b-218633c8413f","createdAt":1786894182651,"transform":{"position":[36,7.000000000000007,-32],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}