p","prop":"desert-shrub","options":{"radius":3,"seed":47}},{"id":"c0cc3748-b2bc-4aaa-bb28-fac497dbb95c","createdAt":1786982737493,"transform":{"position":[-14,-8.881784197001252e-15,40],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dry-grass","options":{"radius":1.8,"height":2.4,"blades":26,"seed":48}},{"id":"b74c85e0-0648-4c23-9568-4200bcb8587d","createdAt":1786982737495,"transform":{"position":[12,-7.549516567451064e-15,34],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dry-grass","options":{"radius":1.8,"height":2.4,"blades":26,"seed":49}},{"id":"13432c0f-dd57-4078-ab00-7424bf495702","createdAt":1786982737497,"transform":{"position":[26,-8.43769498715119e-15,70],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"dry-grass","options":{"radius":1.8,"height":2.4,"blades":26,"seed":50}},{"id":"9d8ebb20-15ff-45bf-bdd3-e159f5e37be5","createdAt":1786982737497,"transform":{"position":[65,122,227],"rotation":[0,-2.692869309579072,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"sky-constellation","options":{"figure":"orion","span":90,"tilt":0.663,"roll":-0.2,"seed":26}},{"id":"4e34c1db-9f97-45c2-95e9-7527f0ba4115","createdAt":1786982737497,"transform":{"position":[-52,96,214],"rotation":[0,2.7386810627362776,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"sky-star","options":{"magnitude":1.98,"spectral":"F","size":3,"label":"POLARIS","sub":"the dome’s own north","tilt":0.6}},{"id":"4b819aed-dcf0-42c8-9070-d984c3743ec4","createdAt":1786982737497,"transform":{"position":[0,172,30],"rotation":[0,1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"milky-way","options":{"length":440,"width":108,"tilt":0.85,"opacity":0.3,"seed":82}},{"id":"a2022b36-b1ad-4ccd-a7c6-2be6fc093774","createdAt":1786982737497,"transform":{"position":[95,118,-55],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"moon-in-sky","options":{"radius":14,"seed":92}},{"id":"d07e35aa-5e8a-4ca3-bd7b-ddd8c178e6aa","createdAt":1786982737499,"transform":{"position":[14,-2.220446049250313e-14,100],"rotation":[0,-2.0899424410414196,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["PRAIRIE RIDGE OBSERVATORY"],"subtitle":"EAST DOME OPEN · PLEASE KEEP LIGHTS RED","width":9,"height":2.6,"postHeight":6.2,"face":"#1d2b3a"}},{"id":"7e17aebe-1be9-42b4-83dc-13532617e1b8","createdAt":1786982737501,"transform":{"position":[-19,-6.217248937900877e-15,60],"rotation":[0,0.5358112379604637,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"🔭  TELESCOPE OBSERVATORY","lead":"The shutter is open and the telescope is tracking.","lines":["Walk in through the door.","The dome turns. Watch it."],"footnote":"The dome and the telescope run the same program — that is the whole trick"}},{"id":"0dd6f0c5-417b-469d-b04b-41140146fe97","createdAt":1786982737503,"transform":{"position":[20,-8.43769498715119e-15,70],"rotation":[0,-0.7378150601204649,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"ef9ab977-163d-45c9-8ffb-5a1ea37d3bcb","createdAt":1786982737505,"transform":{"position":[20,3.9999999999999916,70],"rotation":[0,-0.7378150601204649,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"7d372df8-1d8d-4d48-b1a4-0e251a693e34","createdAt":1786982737507,"transform":{"position":[-12,-1.021405182655144e-14,46],"rotation":[0,0.2551823906208184,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Why a dome turns","body":"A dome is not a roof, it is a shield with one gap in it. The telescope has to see out, but the wind must not get in — moving air shakes a 36-inch mirror enough to smear every star into a blur. So the dome carries a single slit, rides on wheels round a circular track, and follows the telescope all night. Everything else stays shut. Watch this one: it is turning at the same rate as the telescope inside it, which is why the slit stays in front of the tube instead of drifting off it."}},{"id":"019f812c-2e86-4c3b-91fa-f5d6f318dd19","createdAt":1786982737509,"transform":{"position":[12,-1.021405182655144e-14,46],"rotation":[0,-0.2551823906208184,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Nobody looks through it","body":"There is no eyepiece on this telescope and no chair at the top of it. The light goes to a camera cooled to well below freezing, and the astronomer sits at the desk inside reading numbers off a screen — often in another building, sometimes in another country. That is not laziness: a camera can stare at one faint galaxy for an hour and add up every photon, and an eye cannot add anything up at all. The eye is still the better instrument for one job, which is enjoying it."}},{"id":"8360971f-a1cc-4566-93f8-f2884b1c566f","createdAt":1786982737511,"transform":{"position":[-9,-2.6645352591003757e-15,12],"rotation":[0,0.31099828060554097,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"How much more it sees than you do","body":"A dark-adapted pupil is about 7 millimetres across. This mirror is 36 inches — 914 millimetres — and light-gathering goes with AREA, so it collects roughly seventeen thousand times as much light as one eye. That is the difference between seeing four thousand stars and seeing a hundred million. The mirror is glass with a coating of aluminium a few hundred atoms thick, and it is a shallow bowl, not a lens: big lenses sag under their own weight, which is why every large telescope built in the last century has been a mirror."}},{"id":"d3418e24-60d3-4d40-9221-b17fb2ab2e1b","createdAt":1786982737513,"transform":{"position":[36,-4.440892098500626e-15,20],"rotation":[0,-0.4636476090008061,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Why observatories live on dry hills","body":"Air is the enemy. Every warm patch of it between the mirror and the star bends the light a little differently, and the result is a star that boils instead of sitting still — which is all twinkling actually is. So sites are chosen high, dry and far from cities: less air overhead, less water vapour in it, no streetlights. The vents round the bottom of this dome are opened hours before dark so the whole building cools to the outside temperature. A dome even a couple of degrees warm than the night air ruins its own view."}},{"id":"fe93811f-486a-47cd-a8e3-57e6a4104890","createdAt":1786982737514,"transform":{"position":[-24,-4.884981308350689e-15,22],"rotation":[0,0.3302973548292537,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Turn the dome","target":"the silver dome overhead","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 0.05 degrees","depth":1}],"tip":"It is ALREADY running, and so is the telescope, on exactly the same number. Click the dome, choose Program, and change 0.05 to 3 — then watch the slit run away from the telescope and leave it staring at the inside of the roof. Now you know why the two are wired together.","accent":"#6f9bd1"}},{"id":"3fb7d6df-6894-4950-9a05-5a05e4b35ad1","createdAt":1786982737516,"transform":{"position":[24,-5.329070518200751e-15,56],"rotation":[0,-0.5880026035475675,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Sweep the sky with the little telescope","target":"the wooden Dobsonian by the path","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 12 degrees","depth":1},{"cat":"control","text":"wait 1 seconds","depth":1}],"tip":"Thirty steps of 12 degrees is a full circle, so it comes back to where it started. Real observers do exactly this — sweep, stop, look, sweep — because a telescope only sees a patch of sky the width of your little fingernail.","accent":"#d9b45f"}},{"id":"aa44e38d-69f3-4895-b288-6f1d63ef6447","createdAt":1786982737518,"transform":{"position":[-30,-8.881784197001252e-15,40],"rotation":[0,0.5232783221319754,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{"length":5,"woodColor":7035455}},{"id":"f4de9111-5ee7-4c40-850b-fb1807f951c8","createdAt":1786982737520,"transform":{"position":[26,-6.661338147750939e-15,62],"rotation":[0,-0.714090698612158,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{"length":5,"woodColor":7035455}},{"id":"8c1087dc-715b-4b1f-90c3-b9b863c70eb1","createdAt":1786982737522,"transform":{"position":[14,-9.769962616701378e-15,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"red-lamp","options":{"height":9,"seed":123}},{"id":"5ee03af9-4d26-4004-875c-cad8caeb370b","createdAt":1786982737524,"transform":{"position":[10,9.999999999999995,21],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"c3976ce3-c23e-4453-bbbd-39f960c25c1b","createdAt":1786982737526,"transform":{"position":[-10,9.999999999999993,31],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"92a7da29-7da6-47cd-ab5e-0f9986538c44","createdAt":1786982737528,"transform":{"position":[0,10.999999999999991,38],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"}]}