m":{"position":[-14,12.94978562634492,-34],"rotation":[0,2.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"sea-turtle","options":{"length":3.8,"seed":9}},{"id":"096698eb-a98e-4bb1-930c-ee8c03b966d3","createdAt":1786942190607,"transform":{"position":[16,0.026070060546317553,30],"rotation":[0,-0.36397895650964407,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Green sea turtle","title":"Older than you would guess","accent":"#5c6b3f","body":"They take 25 to 50 years to become adults and can live past 80. A female returns to lay eggs on the same beach she hatched on, navigating by the Earth’s magnetic field. Note the flat shell and the huge front flippers — a domed shell and small feet would make this a tortoise."}},{"id":"57ae9e2a-9948-48a8-a2b1-ecefa9509873","createdAt":1786942190608,"transform":{"position":[-8,18.000000000000004,-20],"rotation":[0,0.5,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"manta-ray","options":{"span":14,"seed":11}},{"id":"e55eb05e-7895-45a1-b8ba-30311b74eb72","createdAt":1786942190609,"transform":{"position":[4,-4.884981308350689e-15,22],"rotation":[0,-0.07982998571223732,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Reef manta","title":"Fifteen feet across","accent":"#2b3442","body":"It swims by flapping its whole body like a wing, and feeds by cruising with its mouth wide open, filtering plankton. The two rolled fins on its head funnel water in. Every manta’s belly spots are unique, so researchers identify individuals the way we use fingerprints."}},{"id":"cca16a9d-cfa1-44d3-a352-e316806dd601","createdAt":1786942190610,"transform":{"position":[-18,4.999999999999998,8],"rotation":[0,1.1,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"potato-cod","options":{"length":5.2,"seed":17}},{"id":"727f37db-a0e6-4d64-a234-e79a3f18b737","createdAt":1786942190611,"transform":{"position":[22,14.953884524426499,-30],"rotation":[0,-0.8,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-shark","options":{"length":6,"seed":21}},{"id":"6cf23c69-6c06-498a-85c0-e41daeb0c9b9","createdAt":1786942190613,"transform":{"position":[52,18.007324717133454,-44],"rotation":[0,-1.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-shark","options":{"length":4.6,"seed":25}},{"id":"9da7e852-b275-4fc1-b04f-53719f6e8ee5","createdAt":1786942190614,"transform":{"position":[-20,7.000000000000002,-10],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-fish-school","options":{"count":34,"radius":7,"seed":73}},{"id":"a05eb4a3-fc0e-45e5-a463-b899832918d2","createdAt":1786942190615,"transform":{"position":[12,11.000000000000002,-8],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"reef-fish-school","options":{"count":28,"radius":6,"seed":75}},{"id":"3fcda748-a63e-463c-98d0-e6f9b2b0a8f5","createdAt":1786942190616,"transform":{"position":[26,-0.002239684644057327,-12],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bleached-patch","options":{"size":16,"seed":23}},{"id":"180623fe-12ed-417f-b8d1-3d15504886d5","createdAt":1786942190618,"transform":{"position":[32,-0.037052556208432286,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"staghorn-coral","options":{"size":5.5,"bleached":true,"seed":205}},{"id":"b32e856a-1644-457b-8f34-d6b42555cdaa","createdAt":1786942190619,"transform":{"position":[20,-0.005171301844067333,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"staghorn-coral","options":{"size":4.5,"bleached":true,"seed":207}},{"id":"f8acdb70-dd06-4b8d-a265-345b07342462","createdAt":1786942190620,"transform":{"position":[34,-0.00694911430107803,-6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"plate-coral","options":{"radius":3.6,"bleached":true,"seed":305}},{"id":"cf39f02a-6075-47b5-82b1-004ed2a7e908","createdAt":1786942190621,"transform":{"position":[20,-8.881784197001252e-16,4],"rotation":[0,-0.2860514417173182,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"The white section is not a species","title":"Bleaching","accent":"#e8e4d8","body":"Coral is an animal that farms algae inside itself, and the algae give it both its colour and most of its food. When the water gets too warm the coral expels them and turns bone white. It is not dead yet at that point — it is starving, and it can recover if the water cools quickly enough. In 2016 and 2017 much of it did not."}},{"id":"a30ee016-d08e-434e-8654-5e04dc5e9271","createdAt":1786942190623,"transform":{"position":[20,0.05341858277803668,62],"rotation":[0,-1.1071487177940904,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE GREAT BARRIER REEF"],"subtitle":"Twenty-five feet down on the outer reef","width":16,"height":4.2}},{"id":"ce2c2f35-4710-4b75-8450-ed6268ed8c35","createdAt":1786942190624,"transform":{"position":[-11,0.004341491696224331,60],"rotation":[0,0.7419472680059175,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"1a00a1de-600a-4731-94ae-d73261cadbb1","createdAt":1786942190625,"transform":{"position":[-11,4.004341491696224,60],"rotation":[0,0.7419472680059175,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"ca05052f-8fcb-4f9c-b27a-34c711d2a1aa","createdAt":1786942190626,"transform":{"position":[-24,-0.1762547895577362,54],"rotation":[0,0.9272952180016122,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Fly the manta past the reef","target":"Click the manta ray → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"move forward 40 feet","depth":1},{"cat":"control","text":"wait 4 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1},{"cat":"motion","text":"move forward 40 feet","depth":1},{"cat":"control","text":"wait 4 seconds","depth":1},{"cat":"motion","text":"rotate 180 degrees","depth":1}],"tip":"Mantas really do patrol the same cleaning stations day after day, hovering while little wrasse pick parasites off them. Add a move Y to make it rise and fall as it goes — they do that too.","accent":"#2b3442"}},{"id":"12cb512a-afaf-40c1-afc3-e81d93deb03e","createdAt":1786942190628,"transform":{"position":[24,0.11751821332187529,52],"rotation":[0,-0.8760580505981934,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Bleach a coral, then bring it back","target":"Click a healthy staghorn thicket → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"look","text":"change color to #ffffff","depth":1},{"cat":"look","text":"set opacity to 55 %","depth":1},{"cat":"control","text":"wait 3 seconds","depth":1},{"cat":"look","text":"change color to #c98a4e","depth":1},{"cat":"look","text":"set opacity to 100 %","depth":1},{"cat":"control","text":"wait 3 seconds","depth":1}],"tip":"It goes pale AND thin, because a bleached coral has lost the algae living inside it — that is where both its colour and most of its food came from. The timing is the real lesson: warming turns it white in weeks, and recovery, if it comes at all, takes ten to fifteen years. Make the white wait twenty times longer and you have modelled it honestly.","accent":"#e8a04e"}},{"id":"50c5a217-6de3-4449-a86b-57bcacf3c8f7","createdAt":1786942190629,"transform":{"position":[-48,2.7592725404147957,-20],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}