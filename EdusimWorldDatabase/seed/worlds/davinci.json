le":[1,1,1]},"kind":"preset-prop","prop":"planter","options":{"size":2.6,"shrubColor":7047754}},{"id":"f293a623-3b92-45eb-af4e-959411639029","createdAt":1787008382311,"transform":{"position":[14,0,26],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"planter","options":{"size":2.6,"shrubColor":7047754}},{"id":"fb2ae164-8a56-4688-85f1-03b3e85b0ac9","createdAt":1787008382311,"transform":{"position":[-24,-0.04592067490891738,62],"rotation":[0,0.3,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flower-bed","options":{"width":9,"depth":4,"seed":605}},{"id":"9e869875-763d-4a41-b66a-4c4288fa2f73","createdAt":1787008382311,"transform":{"position":[20,-0.0002657245346375388,66],"rotation":[0,-1.1902899496825317,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE STUDIO"],"subtitle":"Most of these never worked — and that is the interesting part","width":15,"height":4.2}},{"id":"75d67871-c515-4dc6-9bcd-d18571fd2cbc","createdAt":1787008382311,"transform":{"position":[-10,0.0004704177107730521,62],"rotation":[0,0.6947382761967033,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"a9047b38-f3d3-47b0-9471-e1d2360a85b1","createdAt":1787008382311,"transform":{"position":[-10,4.000470417710773,62],"rotation":[0,0.6947382761967033,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"bde65ff4-2104-42e4-a7eb-e634e279f6e9","createdAt":1787008382311,"transform":{"position":[-26,-0.03231506829496235,56],"rotation":[0,0.9652516631899266,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Turn the aerial screw","target":"Click the big linen screw → Program.","steps":[{"cat":"control","text":"forever","depth":0},{"cat":"motion","text":"rotate 8 degrees","depth":1},{"cat":"control","text":"wait 0.06 seconds","depth":1}],"tip":"Watch what does NOT happen: it turns, and it stays exactly where it is. That is the flaw — with nothing to push against, spinning the screw would just spin the machine the other way. A modern helicopter needs a tail rotor for precisely this reason.","accent":"#b08d4a"}},{"id":"35e235b5-1f25-497a-969e-1176d213cab6","createdAt":1787008382311,"transform":{"position":[26,0.014376129194140231,58],"rotation":[0,-1.0191413442663497,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Drive the cart, then turn it","target":"Click the self-propelled cart → Program.","steps":[{"cat":"control","text":"repeat 4 times","depth":0},{"cat":"motion","text":"move forward 12 feet","depth":1},{"cat":"control","text":"wait 1 seconds","depth":1},{"cat":"motion","text":"rotate 90 degrees","depth":1},{"cat":"control","text":"wait 0.5 seconds","depth":1}],"tip":"This is the closest thing here to what the real cart did: it drove a fixed path set by pegs in its gears. Note that move Z always goes along the WORLD’s Z — the rotate turns the cart to face its way, but does not change which way move Z sends it.","accent":"#9a7a3c"}},{"id":"ce75d7c2-4bff-4fc1-984c-f025ab7afefa","createdAt":1787008382311,"transform":{"position":[0,9,-30],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"64185632-27e8-496d-9b71-c545994546fb","createdAt":1787008382311,"transform":{"position":[-8,6,-12],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"680a3c2a-9450-44f2-a47d-f09a7f47cedb","createdAt":1787008382311,"transform":{"position":[10,6,-14],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"}]}