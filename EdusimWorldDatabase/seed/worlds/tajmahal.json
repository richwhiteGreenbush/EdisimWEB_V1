"leafColor":4877106}},{"id":"5a7a7dda-ec6e-4db8-b95b-08c8d0e7dabb","createdAt":1786926560267,"transform":{"position":[70,-9.769962616701378e-15,44],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"shade-tree","options":{"height":22,"seed":921,"leafColor":4877106}},{"id":"52953b70-a784-4866-8e8e-c5665009d128","createdAt":1786926560268,"transform":{"position":[34,0.07022628930467079,128],"rotation":[0,-1.4536875822280324,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"standing-sign","options":{"lines":["THE TAJ MAHAL"],"subtitle":"Agra · 1632–1653 · white marble from Makrana","width":16,"height":4.4}},{"id":"4fa6e512-fe7b-4ebf-8a1c-c63858a45cfb","createdAt":1786926560269,"transform":{"position":[-24,-0.014550387922659613,122],"rotation":[0,1.1760052070951352,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"7a4d6f2f-48ba-4d7f-9490-7cd59b546fe2","createdAt":1786926560270,"transform":{"position":[-24,3.9854496120773404,122],"rotation":[0,1.1760052070951352,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"3e1d5b55-b565-4d0e-a721-0de66d284234","createdAt":1786926560271,"transform":{"position":[-44,0.06600029916592032,132],"rotation":[0,1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":1,"title":"Straighten a minaret","target":"Click any one of the four minarets → Program.","steps":[{"cat":"look","text":"say leaning","depth":0},{"cat":"control","text":"wait 1 seconds","depth":0},{"cat":"motion","text":"move up by 14 feet","depth":0},{"cat":"control","text":"wait 1 seconds","depth":0},{"cat":"motion","text":"move up by -14 feet","depth":0},{"cat":"look","text":"set opacity to 45 %","depth":0}],"tip":"Lift one out of the row and the lean is obvious against the three that are left. Then set opacity to 45% and you can see the tomb straight through it. Put it back with set opacity to 100% — or with go back to start, which undoes everything at once.","accent":"#c4bcaa"}},{"id":"4ea95121-dc5c-4d2e-baf9-8f539aa87f32","createdAt":1786926560272,"transform":{"position":[44,0.0618313825180854,132],"rotation":[0,-1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"activity-board","options":{"number":2,"title":"Send a cypress down the canal","target":"Click a cypress beside the water → Program.","steps":[{"cat":"control","text":"repeat 8 times","depth":0},{"cat":"motion","text":"glide 12 feet over 1.5 seconds","depth":1},{"cat":"look","text":"change size by -8 %","depth":1},{"cat":"motion","text":"rotate 45 degrees","depth":1},{"cat":"motion","text":"go back to start","depth":0}],"tip":"It shrinks as it goes, so it looks like it is walking away from you. Go back to start puts it exactly where it began — position, turn and size all at once — which is the block to reach for whenever a program has made a mess.","accent":"#a8503a"}},{"id":"ac3071d7-8c61-4ced-8cc7-e2cf43537b86","createdAt":1786926560273,"transform":{"position":[0,46.00000000000001,-68],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"9c8a800b-595d-4b15-b6de-0af31648a83a","createdAt":1786926560274,"transform":{"position":[0,9.997549620456972,100],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"},{"id":"d185f5db-0ba1-4adb-9395-1b6214e0cc68","createdAt":1786926560275,"transform":{"position":[-74,16.00393249368628,-68],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"},{"id":"6dd66f67-4a51-4f91-8885-d5a16650cb46","createdAt":1786926560276,"transform":{"position":[74,16.002114159254013,-68],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f5f5f5"}]}