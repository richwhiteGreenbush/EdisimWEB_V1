{"format":"edusim-world","version":1,"exportedAt":"2026-08-17T00:29:20.276Z","records":[{"id":"860a8c6c-18bf-4afb-931b-9d1df8101cec","kind":"world-theme","theme":"tajmahal","createdAt":1786926560212,"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]}},{"id":"ebbf9550-444c-498f-8039-ce1f8e24f30b","createdAt":1786926560213,"transform":{"position":[0,7.993605777301127e-15,-68],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-mahal","options":{"width":75,"height":100,"seed":5}},{"id":"4cf03bb6-c77c-4ccb-9a85-8a479035dbe9","createdAt":1786926560214,"transform":{"position":[-64,0.022963661108108546,-132],"rotation":[0,-2.356194490192345,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-minaret","options":{"height":57,"lean":2,"stages":3,"seed":7}},{"id":"fffaee3c-119f-4225-8bfe-2c7e70306ee6","createdAt":1786926560215,"transform":{"position":[64,-0.27152740672972353,-132],"rotation":[0,2.356194490192345,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-minaret","options":{"height":57,"lean":2,"stages":3,"seed":8}},{"id":"393d1220-b19f-405a-8c4d-d4ab4d3b3972","createdAt":1786926560216,"transform":{"position":[-64,8.881784197001251e-16,-4],"rotation":[0,-0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-minaret","options":{"height":57,"lean":2,"stages":3,"seed":9}},{"id":"0c9950da-a4ef-49d8-95d1-716f757cef18","createdAt":1786926560217,"transform":{"position":[64,8.881784197001251e-16,-4],"rotation":[0,0.7853981633974483,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-minaret","options":{"height":57,"lean":2,"stages":3,"seed":10}},{"id":"40774974-925b-440f-8688-11c748a74149","createdAt":1786926560218,"transform":{"position":[-46,-4.884981308350689e-15,22],"rotation":[0,0.3960814415643074,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"They lean on purpose","title":"The four minarets","accent":"#c4bcaa","body":"Each one tilts about two degrees away from the tomb. If an earthquake brought them down they would fall outward, away from the mausoleum — the same reasoning that puts a tree feller on the uphill side. They are also very slightly shorter than they look, because they are set on the plinth rather than beside it."}},{"id":"7a613c3c-cc92-44aa-b9c9-8f85ab7f3ace","createdAt":1786926560219,"transform":{"position":[46,-4.884981308350689e-15,22],"rotation":[0,-0.3960814415643074,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"A tomb for one person","title":"Why it was built","accent":"#a8503a","body":"Shah Jahan built it for Mumtaz Mahal, who died in 1631 having their fourteenth child. It took twenty-two years, twenty thousand workers and a thousand elephants to haul the marble 200 miles from Makrana. He was deposed by his own son and spent his last eight years imprisoned in the fort downriver, where he could see it."}},{"id":"1c886e5f-bafb-4e07-8cca-0dc395cb7150","createdAt":1786926560220,"transform":{"position":[0,-7.549516567451064e-15,66],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"charbagh-canal","options":{"length":76,"width":10,"jets":5,"seed":17}},{"id":"0fb131e6-af8e-452b-ab26-4c4f1adf0a7f","createdAt":1786926560221,"transform":{"position":[0,-1.3322676295501878e-15,6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"charbagh-canal","options":{"length":34,"width":10,"jets":3,"seed":19}},{"id":"3547f5f7-1c07-4252-99de-9a4cd9dc5a54","createdAt":1786926560222,"transform":{"position":[0,-6.217248937900877e-15,28],"rotation":[0,1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"charbagh-canal","options":{"length":74,"width":10,"jets":5,"seed":21}},{"id":"39ea15eb-8c0c-4bf6-b84f-08dad6726bab","createdAt":1786926560223,"transform":{"position":[-17,-7.105427357601002e-15,32],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"garden-cypress","options":{"height":18,"seed":300}},{"id":"9b1aa772-0757-4d86-851d-fa5b295e7e66","createdAt"