,1]},"kind":"preset-prop","prop":"garden-cypress","options":{"height":17,"seed":408}},{"id":"24b7121a-daaf-418e-a30f-461403522074","createdAt":1786926560240,"transform":{"position":[-60,-3.552713678800501e-15,16],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"garden-cypress","options":{"height":18,"seed":414}},{"id":"6e5b99fe-30ca-4b98-a04f-fe0c7916c02e","createdAt":1786926560241,"transform":{"position":[60,-3.552713678800501e-15,16],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"garden-cypress","options":{"height":18,"seed":415}},{"id":"c3c8337b-62ed-4afe-b58b-1b223e15c5c3","createdAt":1786926560242,"transform":{"position":[-74,0.003932493686279237,-68],"rotation":[0,1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-mosque","options":{"width":46,"depth":22,"height":26,"seed":13}},{"id":"56d6cbbe-d962-4e69-b75f-5a601678d079","createdAt":1786926560243,"transform":{"position":[74,0.0021141592540141474,-68],"rotation":[0,-1.5707963267948966,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-mosque","options":{"width":46,"depth":22,"height":26,"seed":14}},{"id":"b7038125-9876-423e-bbbb-57e03c5f5979","createdAt":1786926560244,"transform":{"position":[-60,5.773159728050814e-15,-26],"rotation":[0,0.7378150601204649,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"One of these is not a mosque","title":"The mosque and the jawab","accent":"#8e4130","body":"The building on the west is a working mosque, facing Mecca. The one on the east is its mirror image and always has been empty — jawab means \"answer\". It was built purely so that the view has the same thing on both sides. Symmetry mattered more than function, and that is the argument of the whole complex."}},{"id":"032c5a5b-be0e-47b7-b1f8-d4de191fe08b","createdAt":1786926560245,"transform":{"position":[0,0.31166132122038626,152],"rotation":[0,3.141592653589793,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"taj-gateway","options":{"width":62,"height":46,"depth":20,"seed":11}},{"id":"e3b294a3-93b1-4d4a-9571-05679a7dd147","createdAt":1786926560246,"transform":{"position":[-34,0.03228671325776622,138],"rotation":[0,1.7454685258031364,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"You are meant to arrive through it","title":"The great gate","accent":"#a8503a","body":"From outside, the gate hides the Taj completely. You walk through the arch and the whole building appears at once, framed and reflected. That is the design: the complex is arranged so the first view is a single event. Red sandstone here, white marble there — the colour change is doing the same work."}},{"id":"1e62af47-6de4-4f60-8910-768ca24457f4","createdAt":1786926560247,"transform":{"position":[-18,2.220446049250313e-15,-10],"rotation":[0,0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"marble-screen","options":{"width":9,"height":10,"seed":23}},{"id":"9d607acf-2472-462f-a37c-71bab260a4a4","createdAt":1786926560248,"transform":{"position":[18,2.220446049250313e-15,-10],"rotation":[0,-0.35,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"marble-screen","options":{"width":9,"height":10,"seed":24}},{"id":"8b6c248f-40d4-4430-b755-6cff1167326c","createdAt":1786926560249,"transform":{"position":[-7,4.884981308350689e-15,-22],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cenotaph","options":{"length":9,"width":4.5,"height":4.4,"ornate":false,"seed":29}},{"id":"09e5166d-8d2c-4d99-9d3d-4fa83da49404","createdAt":1786926560250,"transform":{"position":[6,5.551115123125783e-15,-25],"rotation":[0,0.06,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"cenotaph","options":{"length":8,"width":4,"height":4,"ornate":true,"seed":31}},{"id":"9f98fccd-83f6-49c6-8101-f887a371944e","createdAt":1786926560251,"transform":{"position":[26,3.1086244689504383e-15,-14],"rotation":[0,-0.4487233440107211,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"eyebrow":"Both of these are empty","title":"The cenotaphs","accent":"#c4bcaa","body":"The two marble boxes under the dome are markers. The real graves are in a plain crypt below, unmarked and closed. Mumtaz's marker is dead centre; Shah Jahan's was squeezed in beside it after he died, and it is the ONLY thing in the entire building that is not symmetrical."}},{"id":"20093fbf-50de-45db-9d08-1e824fe0c623","createdAt":1786926560252,"transform":{"position":[-52,0.006909426049347189,96],"rotation":[0,-0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flower-bed","options":{"width":14,"depth":6,"seed":700}},{"id":"c2fb5bb3-051d-4911-b400-7aa8d7369b21","createdAt":1786926560253,"transform":{"position":[52,0.03345060426156721,96],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flower-bed","options":{"width":14,"depth":6,"seed":709}},{"id":"916314f5-58ea-4bc7-8590-97786be0d805","createdAt":1786926560254,"transform":{"position":[-52,-6.217248937900877e-15,60],"rotation":[0,-0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flower-bed","options":{"width":14,"depth":6,"seed":718}},{"id":"76e5db2e-e6ea-4e9d-be93-8364cf7512da","createdAt":1786926560255,"transform":{"position":[52,-6.217248937900877e-15,60],"rotation":[0,0.2,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"flower-bed","options":{"width":14,"depth":6,"seed":727}},{"id":"5e3e3656-4de7-4a7c-b014-b2fb30fbcc0a","createdAt":1786926560256,"transform":{"position":[-24,-0.0037467822065710976,104],"rotation":[0,3.8502189257174635,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{"length":5}},{"id":"364b065b-017c-4491-8a28-321541b475fc","createdAt":1786926560257,"transform":{"position":[24,0.006675052147576466,104],"rotation":[0,2.4329663814621227,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"bench","options":{"length":5}},{"id":"18fabe19-55e8-4a9c-ba2a-61f445d1b35d","createdAt":1786926560258,"transform":{"position":[-24,-8.881784197001252e-15,40],"rotation":[0,3.3967750442106115,0],"scale":[1,1,1]},"k