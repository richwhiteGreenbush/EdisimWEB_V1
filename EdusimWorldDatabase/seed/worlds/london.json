transform":{"position":[34,0.0002199733902896739,116],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"plane-tree","options":{"height":26,"seed":52}},{"id":"030d50d1-6c9c-44e9-96c0-6aefa220312c","createdAt":1786965902042,"transform":{"position":[26,0.015874081197103873,130],"rotation":[0,-1.9974238199217729,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"welcome-board","options":{"eyebrow":"🇬🇧  BIG BEN & WESTMINSTER","lead":"The Elizabeth Tower, from the south bank.","lines":["Big Ben is the BELL, not the tower.","Watch for the red bus."],"footnote":"Shown at about half size — the real tower is 316 feet"}},{"id":"ff0b1ccb-7b49-4404-8b19-87250e41d38a","createdAt":1786965902044,"transform":{"position":[-16,-2.4868995751603507e-14,112],"rotation":[0,1.1902899496825317,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"browser-kiosk","options":{"centreY":4}},{"id":"e9f95175-e3d6-4076-bef2-d7b543f0f2d3","createdAt":1786965902045,"transform":{"position":[-16,3.999999999999975,112],"rotation":[0,1.1902899496825317,0],"scale":[1,1,1]},"kind":"web-browser","url":"http://edusim3dweb.com"},{"id":"ed48c8af-e2c3-46ec-a013-1ad48f8c9e64","createdAt":1786965902047,"transform":{"position":[-2,-1.9095836023552692e-14,86],"rotation":[0,0.17467219900823971,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Big Ben is a bell","body":"The name belongs to the great hour bell inside the belfry — 13.7 tonnes of it — and not to the tower, which was just called the Clock Tower until 2012. The bell cracked within weeks of being hung in 1859. Rather than recast it again they turned it slightly, fitted a lighter hammer, and left the crack; that is why its note is slightly off, and it has been ever since."}},{"id":"536500b6-cc35-41a4-9b5b-e05c1be3f64b","createdAt":1786965902048,"transform":{"position":[22,-1.021405182655144e-14,78],"rotation":[0,-0.4048917862850834,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Reading the clock","body":"Each of the four dials is 23 feet across and made of 312 pieces of opal glass. The minute hand is 14 feet long and travels about 118 miles a year. Look at the numerals: this clock uses IV, not the IIII most clock faces use. Under each dial runs the Latin line DOMINE SALVAM FAC REGINAM NOSTRAM VICTORIAM PRIMAM — \"O Lord, keep safe our Queen Victoria the First\"."}},{"id":"2e4071a5-b8c3-445f-bd90-4d8165a47ffb","createdAt":1786965902050,"transform":{"position":[-54,-1.865174681370263e-14,84],"rotation":[0,1.015302591529353,0],"scale":[1,1,1]},"kind":"preset-prop","prop":"info-placard","options":{"title":"Why it looks medieval but is not","body":"The old Palace burned down in 1834. What replaced it is Victorian, finished in the 1860s — but Charles Barry and A.W.N. Pugin built it in the Perpendicular Gothic of four centuries earlier, on purpose, so that the new Parliament would look as though it had always been there. Almost every detail you can see, including this bridge’s parapet, was designed to match a building that is younger than the railways."}},{"id":"46a04ced-0559-4198-9eb7-18b6597fe079","createdAt":1786965902052,"transform":{"position":[-6,8.999999999999998,6],"rotation":[0,0,0],"scale":[1,1,1]},"kind":"light-orb","color":"#f2a541"}]}